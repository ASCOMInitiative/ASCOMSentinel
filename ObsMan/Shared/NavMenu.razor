@namespace ObsMan

<div class="top-row ps-3 navbar navbar-dark" style="width:800px">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Observatory Manager</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/display" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Display
            </NavLink>
        </div>
        @foreach (var device in ASCOM.Alpaca.DeviceManager.ObservingConditions)
        {
            string path = $"/setup/v1/ObservingConditions/{device.Key}/setup";
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@path" Match="NavLinkMatch.All">
                    <span class="oi oi-cloudy" aria-hidden="true"></span> Composite ObservingConditions Setup
                </NavLink>
            </div>
        }
        @foreach (var device in ASCOM.Alpaca.DeviceManager.Switches)
        {
            string path = $"/setup/v1/switch/{device.Key}/setup";
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@path" Match="NavLinkMatch.All">
                    <span class="oi oi-circle-check" aria-hidden="true"></span> Composite Switch Setup
                </NavLink>
            </div>
        }
        @foreach (var device in ASCOM.Alpaca.DeviceManager.SafetyMonitors)
        {
            string path = $"/setup/v1/SafetyMonitor/{device.Key}/setup";
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@path" Match="NavLinkMatch.All">
                    <span class="oi oi-ban" aria-hidden="true"></span> Composite SafetyMonitor Setup
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/triggerrules" Match="NavLinkMatch.All">
                <span class="oi oi-cog" aria-hidden="true"></span> Safety Monitor Trigger Rules
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/serversetup" Match="NavLinkMatch.All">
                <span class="oi oi-cog" aria-hidden="true"></span> Server Setup
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/help">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Help
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
