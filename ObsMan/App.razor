@namespace ObsMan

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
<head>
    <RadzenTheme Theme="standard" />
</head>

<script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>

<link rel="stylesheet" href="css/site.css" />

<script>
    // JavaScript variable to hold the latest .NET helper reference for use in callbacks to .NET
    var dotNetHelper;

    // Function to call on window resize
    function onResize() {
        // Call the .NET OnResize method if the helper is set, returning the new window width and height
        if (dotNetHelper) {
            dotNetHelper.invokeMethodAsync('OnResize', window.innerWidth, window.innerHeight);
        }
    }

    // Set up event listeners and save the reference to the .NET helper
    window.registerViewportChangeCallback = (dotnetHelperObject) => {
        window.addEventListener('load', onResize);
        window.addEventListener('resize', onResize);
        window.dotNetHelper = dotnetHelperObject;
    }

    // Remove event listeners and clear the reference to the .NET helper
    window.unregisterViewportChangeCallback = () => {
        window.removeEventListener('load',onResize);
        window.removeEventListener('resize',onResize);
        window.dotnetHelperObject = null;
    }

    // Return position information for a control with the supplied element ID
    GetBoundingClientRect = (elementId) => {
        let rect = null;
        try {
            rect = document.getElementById(elementId).getBoundingClientRect();
        }
        catch (err) {
            rect = null;
        }

        return rect;
    };

    // Scroll to the bottom of the page
    function ScrollToBottom(elementId) {
        let top = document.getElementById(elementId).scrollHeight;
        document.getElementById(elementId).scrollTop = top;
        return top;
    };

    // Get the element's scroll position
    function getScrollPosition(elementId) {
        let element = document.getElementById(elementId);

        return {
            scrollTop: element.scrollTop,
            scrollLeft: element.scrollLeft,
            scrollHeight: element.scrollHeight,
            clientHeight: element.clientHeight
        };
    }

    // Set element.top for a scroll-able element.
    // When an element is scrolled, this is the offset of the top of the visible scrolled region from the absolute top of the element (which is now invisible because it is scrolled above the visible top of the element.)
    function setScrollTop(elementId, scrollTop) {
        let element = document.getElementById(elementId);
        element.scrollTop = scrollTop;
    }

</script>