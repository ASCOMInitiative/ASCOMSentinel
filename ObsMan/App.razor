@namespace ObsMan

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
<head>
    <RadzenTheme Theme="standard" />
</head>

<script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>

<script>
    // JavaScript variable to hold the latest Index page .NET helper reference for use in callbacks to .NET
    var dotNetHelperIndexPage;

    // Function to call on index window resize
    function onResizeIndex() {
        // Call the .NET OnResize method if the helper is set, returning the new window width and height
        if (dotNetHelperIndexPage) {
            dotNetHelperIndexPage.invokeMethodAsync('OnResizeIndex', window.innerWidth, window.innerHeight);
        }
    }

    // Set up event listeners for the Index page and save the reference to the .NET helper
    window.registerIndexViewportChangeCallback = (dotnetHelperObject) => {
        window.addEventListener('load', onResizeIndex);
        window.addEventListener('resize', onResizeIndex);
        window.dotNetHelperIndexPage = dotnetHelperObject;
    }

    // Remove event listeners for the Index page and clear the reference to the .NET helper
    window.unregisterIndexViewportChangeCallback = () => {
        window.removeEventListener('load', onResizeIndex);
        window.removeEventListener('resize',onResizeIndex);
        window.dotNetHelperIndexPage = null;
    }

    // JavaScript variable to hold the latest Setup page .NET helper reference for use in callbacks to .NET
    var dotNetHelperSetupPage;

    // Function to call on Setup window resize
    function onResizeSetup() {
        // Call the .NET OnResize method if the helper is set, returning the new window width and height
        if (dotNetHelperSetupPage) {
            dotNetHelperSetupPage.invokeMethodAsync('OnResizeSetup', window.innerWidth, window.innerHeight);
        }
    }

    // Set up event listeners for the Setup page and save the reference to the .NET helper
    window.registerSetupViewportChangeCallback = (dotnetHelperObject) => {
        window.addEventListener('load', onResizeSetup);
        window.addEventListener('resize', onResizeSetup);
        window.dotNetHelperSetupPage = dotnetHelperObject;
    }

    // Remove event listeners for the Setup page and clear the reference to the .NET helper
    window.unregisterSetupViewportChangeCallback = () => {
        window.removeEventListener('load', onResizeSetup);
        window.removeEventListener('resize',onResizeSetup);
        window.dotNetHelperSetupPage = null;
    }

    // Scroll to the bottom of the page
    // function ScrollToBottom(elementId) {
    //     let top = document.getElementById(elementId).scrollHeight;

    //     document.getElementById(elementId).scrollTop = top;
    //     return top;
    // };

    function ScrollToBottom(elementId) {
        const element = document.getElementById(elementId);
        if (!element) {
            return 0; // Return 0 if element not found
        }
        let top = element.scrollHeight;
        element.scrollTop = top;
        return top;
    };



    // Set element.top for a scroll-able element.
    // When an element is scrolled, this is the offset of the top of the visible scrolled region from the absolute top of the element (which is now invisible because it is scrolled above the visible top of the element.)
    // function setScrollTop(elementId, scrollTop) {
    //     document.getElementById(elementId).scrollTop = scrollTop;
    // }

</script>