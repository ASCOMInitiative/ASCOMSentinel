@namespace ObsMan.Components
@using ASCOM.Alpaca.Discovery
@using ASCOM.Com

@inject ObsManLogger logger
@inject Settings settings

<div>
    <span style="display:inline-block; width:150px; margin:0px; text-align:left;">@PropertyDescription</span>
    <RadzenDropDown @bind-Value=@bindValue
                    Data=@DiscoveredDevices
                    TValue="DiscoveredDevice"
                    TextProperty="@nameof(DiscoveredDevice.DisplayName)"
                    Style="margin-top:20px;margin-left:0px; margin-right:0px; width: 700px; text-align:left;"
                    Change="(args)=>DropDownChanged(args)"
                    Name="DropDownBindValue">
        <Template Context="item">
            <span style="color: @(ItemColour(item));font-size:1rem">
                @item.DisplayName
            </span>
        </Template>
    </RadzenDropDown>
</div>

@code {
    /// <summary>
    /// Determines the display color for a given device based on its configuration and protocol.
    /// </summary>
    /// <param name="device">The device.</param>
    /// <returns>A string representing the color.</returns>
    private string ItemColour(DiscoveredDevice device)
    {
        // Check if this device is not configured
        if (device.ObsManDeviceType == ObsManDeviceType.NotSet) // Not configured so return red
            return "Red";
            
        // Check whether it is Alpaca or COM
        if (device.IpPort != 0) // Alpaca device so return blue
            return "DodgerBlue";
        else // COM device so return green
            return "LightSeaGreen";
    }

    DiscoveredDevice? bindValue = null;
    int switchNumber = 0;

    private void DropDownChanged(object args)
    {
        if (args == null)
            return;
        DiscoveredDevice device = (DiscoveredDevice)args;
        //logger.LogMessage("", $"DropDownChanged - Selected value: {device.DisplayName} {device.Id}");

        settings.ConfiguredDevices[Property] = device;
        //logger.LogMessage("", $"DropDownChanged - Set device");
        settings.Save();
        //logger.LogMessage("", $"DropDownChanged - Saved settings");
    }

    [Parameter]
    public IEnumerable<DiscoveredDevice> DiscoveredDevices { get; set; } = Enumerable.Empty<DiscoveredDevice>();

    [Parameter]
    public string PropertyDescription { get; set; } = "Not set";

    [Parameter]
    public DiscoveredDevice CurrentValue { get { return bindValue; } set { bindValue = value; } } 

    [Parameter]
    public PropertyName Property { get; set; }
}
