@namespace ObsMan.Components
@using ASCOM.Alpaca.Discovery
@using ASCOM.Com

@inject ObsManLogger logger

<div>
    <span style="display:inline-block; width:150px; margin:0px; text-align:left;">@PropertyName</span>
    <RadzenDropDown @bind-Value=@value Data=@GetDeviceNames() Style="margin-top:20px;margin-left:0px; margin-right:0px; width: 600px; text-align:left;" Name="DropDownBindValue" />
    <RadzenNumeric @bind-Value=@switchNumber InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "enter value" } })" Style="width:50px; margin:0px" Min=0 TextAlign="TextAlign.Center" />
    <RadzenTextArea @bind-Value=@SomeValue
                    Rows="1"
                    ReadOnly="true"
                    Style="max-width:400px; min-width:400px;vertical-align:bottom; resize:none" />
</div>

@code {
    string value = "";
    int switchNumber = 0;

    [Parameter]
    public IEnumerable<AscomDevice> AlpacaDevices { get { logger.LogDebug("", $"AlpacaDevices Get {field.Count()}"); return field; } set { field = value; logger.LogDebug("", $"AlpacaDevices Set {field.Count()}"); } } = new List<AscomDevice>();

    [Parameter]
    public IEnumerable<ASCOMRegistration> ComDevices { get { logger.LogDebug("", $"ComDevices Get {field.Count()}"); return field; } set { field = value; logger.LogDebug("", $"ComDevices Set {field.Count()}"); } } = new List<ASCOMRegistration>();
    [Parameter]
    public string Property { get; set; } = "Not set";

    [Parameter]
    public PropertyName PropertyName { get; set; }

    static int valueIndex;
    string SomeValue
    {
        get
        {
            valueIndex++;
            if (valueIndex > 2)
                valueIndex = 0;
            switch (valueIndex)
            {
                case 0: return "Short string";
                case 1: return "Long string - Some value asd a";
                case 2: return "Very long string - Some value asd asd as da";
            }
            return "Default string";
        }
        set { }
    }


    private IEnumerable<string> GetDeviceNames()
    {
        List<String> deviceNames = new();

        logger.LogDebug("", $"GetDeviceNames - Found {AlpacaDevices.Count()} devices.");
        foreach (AscomDevice device in AlpacaDevices)
        {
            logger.LogDebug("", $"GetDeviceNames - {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
            deviceNames.Add($"{device.AscomDeviceName} ({device.HostName}:{device.IpPort})");
        }

        foreach (ASCOMRegistration device in ComDevices)
        {
            logger.LogDebug("", $"GetDeviceNames - {device.Name}, {device.ProgID} ");
            deviceNames.Add($"{device.Name} ({device.ProgID})");
        }

        return deviceNames;
    }
}
