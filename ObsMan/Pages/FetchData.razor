@page "/fetchdata"

<PageTitle>Weather forecast</PageTitle>

@using ASCOM.Common
@using ObsMan.Data
@inject WeatherForecastService ForecastService
@inject Settings settings;
@inject Logger logger;
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;


<h1>Weather forecast</h1>

<p>This component demonstrates fetching data from a service.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Temp. (C)</th>
                <th>Temp. (F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@forecast.Summary</td>
                    <td>Trace on: @settings.TraceOn</td>
                </tr>
            }
        </tbody>
    </table>
    <button @onclick="SaveSettings">Save settings</button>
}

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        forecasts = await ForecastService.GetForecastAsync(DateTime.Now);
        logger.Debug = true;
    }

    private async Task SaveSettings()
    {
        logger.LogMessage("DaveSettingsPage", LogLevel.Information, "About to set Trace On");
        settings.TraceOn = !settings.TraceOn;
        settings.Save();
        logger.LogMessage("DaveSettingsPage", LogLevel.Debug, "Trace Set On!!");
    }

}
