@page "/"

@inject Settings settings;
@inject Logger logger;
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;

<PageTitle>Observatory Manager</PageTitle>

<h1>Observatory Manager</h1>

Welcome to your new app.

Trace on: @settings.TraceOn

<div>
    <RadzenButton Click="@SaveSettings" Text="Save Settings"></RadzenButton>
</div>

<div>
    <RadzenRadialGauge Style="width: 100%; height: 250px;">
        <RadzenRadialGaugeScale StartAngle="-150" EndAngle="150" Step="20" Min="0" Max="120" TickPosition=@tickPosition>
            <RadzenRadialGaugeScalePointer Value=@value Length="0.6" ShowValue=@showValue>
                <Template Context="pointer">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0" class="rz-mt-4">
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0"><strong>@pointer.Value</strong></RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption">m/h</RadzenText>
                    </RadzenStack>
                </Template>
            </RadzenRadialGaugeScalePointer>
            <RadzenRadialGaugeScaleRange From="0" To="20" Fill="green" />
            <RadzenRadialGaugeScaleRange From="20" To="40" Fill="orange" />
            <RadzenRadialGaugeScaleRange From="40" To="120" Fill="red" />
        </RadzenRadialGaugeScale>
    </RadzenRadialGauge>
</div>

@code {
    bool showValue = true;
    double value = 100;
    GaugeTickPosition tickPosition = GaugeTickPosition.Inside;


    protected override async Task OnInitializedAsync()
    {
        logger.Debug = true;
    }

    private async Task SaveSettings()
    {
        logger.LogMessage("DaveSettingsPage", LogLevel.Information, "About to invert Trace value");
        settings.TraceOn = !settings.TraceOn;
        settings.Save();
        logger.LogMessage("DaveSettingsPage", LogLevel.Debug, $"Trace Set {settings.TraceOn}!!");
    }

}
