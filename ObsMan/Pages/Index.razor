@page "/"
@using ASCOM.Common.DeviceInterfaces

@inject State state;
@inject ObsManLogger logger;
@inject IJSRuntime JSRuntime
@inject Settings settings

@implements IAsyncDisposable

<h1>Observatory Manager</h1>
<div>
    <RadzenButton Click="@Connect" Text="Connect" Style="margin-left:30px;border-radius:20px; margin-right:30px" /> @settings.Status
    <p />
</div>

<div style="height:100%;min-height:100%;">
    <RadzenTextArea Id="ObsManLog" Style='font-family: "Lucida Console", "Courier New", monospace; font-size: 14px; line-height: 18px; padding-bottom: 0px; width:100%; '
                    Name="ObsManLog" @bind-Value=@ApplicationLog Rows="@LastnumberOfLogLines()" Cols="250" ReadOnly=true />
</div>

@code
{
    DotNetObjectReference<Index>? objRef;

    protected override async void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            logger.MessageLogChanged += OnLogChanged;

            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("window.registerIndexViewportChangeCallback", objRef);

            // Get the current window size and re-size to this
            int logWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            int logHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            OnResizeIndex(logWidth, logHeight);
            StateHasChanged();

            // Scroll the log window to the bottom of its contents.
            try
            {
                await JSRuntime.InvokeVoidAsync("setScrollTop", "ObsManLog", state.TopOfVisibleLog.ToString());
            }
            catch (Exception ex)
            {
                Console.WriteLine($"OnInitialized-setScrollTop: {ex}");
            }
        }
    }

    private async Task Connect()
    {
        // Get a list of unique devices to which to connect. we only need one instance even if that device is used for multiple properties.
        List<DiscoveredDevice> uniqueDevices = settings.ConfiguredDevices.Values
            .Where(d => d.ObsManDeviceType != ObsManDeviceType.NotSet)
            .DistinctBy(d => (d.ObsManDeviceType, d.ComProgID, d.IpAddress, d.PortNumber, d.RemoteDeviceNumber)).ToList();

        // Define a dictionary to hold the unique device instances
        Dictionary<DiscoveredDevice, IObservingConditionsV2> deviceInstances = new();

        if(state.ObservingConditionsDevices.Count>0)
        {         
            logger.LogDebug("Connect", $"Already connected to devices - disconnecting first");
            foreach (IObservingConditionsV2 device in state.ObservingConditionsDevices)
            {
                try
                {
                    device.Connected = false;
                    device.Dispose();
                }
                catch (Exception ex)
                {
                    logger.LogDebug("Connect", $"Exception setting Connected false for device during disconnect - {ex.Message}\r\n{ex}");
                }
            }
            state.ObservingConditionsDevices.Clear();
        }


        List<Task> startTasks = []; // List of tasks to set Connected=true on each device

        // Iterate over the unique devices and create an instance for each one, then add it to the dictionary.
        foreach (DiscoveredDevice device in uniqueDevices)
        {
            //logger.LogMessage("Connect", $"Connecting to {device.DisplayName} at {device.IpAddress}:{device.PortNumber} using {device.Protocol} protocol");

            // Create a COM or Alpaca client as appropriate for the device
            switch (device.Protocol)
            {
                case Protocol.Alpaca: // Alpaca so create an Alpaca client
                    IObservingConditionsV2 alpacaDevice = new ASCOM.Alpaca.Clients.AlpacaObservingConditions(new ASCOM.Alpaca.Clients.AlpacaConfiguration()
                    {
                        ServiceType = ASCOM.Common.Alpaca.ServiceType.Http,
                        IpAddressString = device.IpAddress,
                        PortNumber = device.PortNumber,
                        RemoteDeviceNumber = device.RemoteDeviceNumber
                    });
                    deviceInstances[device] = alpacaDevice;
                    state.ObservingConditionsDevices.Add(alpacaDevice);
                    logger.LogDebug("Connect", $"Connect: added a real Alpaca device for {device.DisplayName}");
                    break;

                case Protocol.COM: // COM so create a DriverAccess COM client
                    IObservingConditionsV2 comDevice = new ASCOM.Com.DriverAccess.ObservingConditions(device.ComProgID);
                    deviceInstances[device] = comDevice;
                    state.ObservingConditionsDevices.Add(comDevice);
                    logger.LogDebug("Connect", $"Connect: added a real COM device for {device.DisplayName}");
                    break;

                default:
                    throw new InvalidOperationException($"Index.Connect - Invalid protocol: {device.Protocol}");
            }

            // Create a cancellation token that will cancel the task if it takes longer than the configured timeout to complete.
            CancellationTokenSource cts = new CancellationTokenSource(TimeSpan.FromSeconds(settings.AlpacaConnectTimeout));

            // Create a task to set Connected=true for this device, which will time out after the configured timeout.
            Task task = Task.Run(() =>
            {
                try
                {
                    logger.LogDebug("Property", $"Setting Connected True for {device.DisplayName} {device.Protocol}");
                    deviceInstances[device].Connected = true;
                    logger.LogMessage("Property", $"Connected set True OK for {device.DisplayName} {device.Protocol}");
                }
                catch (Exception ex)
                {
                    if (settings.LogLevel == ASCOM.Common.Interfaces.LogLevel.Debug)
                        logger.LogError("", $"Exception setting Connected true for {device.DisplayName} {device.Protocol} - {ex.Message}\r\n{ex}");
                    else
                        logger.LogError("", $"Unable to set Connected true for {device.DisplayName} - {ex.Message}");
                }
            }, cts.Token);

            // Add the task to the list of tasks and start it.
            startTasks.Add(task);
        }

        // Wait for all tasks to finish.
        logger.LogMessage("Property", $"Waiting for tasks to finish");
        Task.WaitAll(startTasks);
        logger.LogMessage("Property", $"Tasks finished");

        // Clear the mapping between properties and devices, then re-populate it based on the configured device definitions and the instances we just created.
        state.ObservingConditionsDeviceMap.Clear();

        // Iterate over each property and find the matching device instance based on the configured device for that property
        foreach (PropertyName property in Enum.GetValues<PropertyName>())
        {
            logger.LogDebug("Property", $"Processing Property: {property}");

            // Get the discovered device information for this property, ignoring devices that are not configured
            DiscoveredDevice configured = settings.ConfiguredDevices[property];
            if (configured.Protocol != Protocol.NotConfigured)
            {
                //logger.LogMessage("Property", $"Looking for match Property: {property}");
                try
                {
                    // Find the matching device instance based on the configured device for this property
                    KeyValuePair<DiscoveredDevice, IObservingConditionsV2> device = deviceInstances.First(d =>
                        d.Key.Protocol == configured.Protocol &&
                        d.Key.ObsManDeviceType == configured.ObsManDeviceType &&
                        d.Key.IpAddress == configured.IpAddress &&
                        d.Key.PortNumber == configured.PortNumber &&
                        d.Key.RemoteDeviceNumber == configured.RemoteDeviceNumber &&
                        d.Key.ComProgID == configured.ComProgID);

                    // Add the matching device instance to the device map so that we can easily find the device for each property later when we need to read values from it.
                    state.ObservingConditionsDeviceMap.Add(property, device.Value);
                    logger.LogDebug("Property", $"Added Property: {property} {device.Key.DisplayName} {device.Key.Protocol}");
                }
                catch (Exception ex)
                {
                    logger.LogError("Connect", $"Exception: \r\n{ex}");
                }
            }
        }
        logger.LogMessage("Property", $"Connect to devices finished");
    }

    private int LastnumberOfLogLines()
    {
        return state.LastNumberOfLogLines == 0 ? 20 : state.LastNumberOfLogLines;
    }

    private string ApplicationLog
    {
        get
        {
            return state.ApplicationLog.ToString();
        }
        set
        {
            // Do nothing - required for two-way binding
        }
    }


    private async void OnLogChanged(object? sender, MessageEventArgs e)
    {
        try
        {
            await InvokeAsync(StateHasChanged);

            // Scroll to the bottom of the window and return the current window 'top' value.
            //int top = await JSRuntime.InvokeAsync<int>("ScrollToBottom", "ObsManLog");
            int top = await JSRuntime.InvokeAsync<int>("ScrollToBottom", "ObsManLog");

            // Save the current top so that the scroll position can be restored after a browser page refresh or navigation to a different page.
            state.TopOfVisibleLog = top;
        }
        catch (Exception ex){ LogConsole(ex.Message); } // Ignore exceptions here - we don't want the app to crash just because the log window can't scroll for some reason. The log will still be updated, just not scrolled to the bottom.
    }

    #region Log resize support

    private void LogConsole(string message)
    {
        lock (Globals.logLock)
        {
            Console.Write(DateTime.Now.ToString("HH:mm:ss.fff"));
            Console.ForegroundColor = ConsoleColor.DarkCyan;
            Console.WriteLine(message);
            Console.ResetColor();
        }
    }

    // This method will be called when the window resizes.
    // It is ONLY called when the user stops dragging the window's edge. (It is already throttled to protect your app from performance nightmares)
    [JSInvokable]
    public async void OnResizeIndex(int width, int height)
    {
        try
        {
            // Calculate the number of rows that will fit in the available height
            int screenLogRows = Convert.ToInt32(height / 18.0) - 12;

            // Save the number of log lines so this can be restored across F5 refreshes and navigation. (Must be done before calling StateHasChanged)
            state.LastNumberOfLogLines = screenLogRows;

            // Display the updated log on the screen - invoke required because this event handler method could be called by any thread
            await InvokeAsync(StateHasChanged);

            // Scroll to the bottom of the window and return the current window 'top' value.
            int top = await JSRuntime.InvokeAsync<int>("ScrollToBottom", "ObsManLog");

            // Save the current top so that the scroll position can be restored after a browser page refresh or navigation to a different page.
            state.TopOfVisibleLog = top;
        }
        catch (Exception ex)
        {
            logger.LogError("OnResize", $"Exception - {ex.Message}\r\n{ex}");
        }
    }

    #endregion

    #region Dispose pattern

    public async ValueTask DisposeAsync()
    {
        if (objRef != null)
        {
            await JSRuntime.InvokeVoidAsync("window.unregisterIndexViewportChangeCallback"); // Optional: add unregister JS
            objRef.Dispose();
        }
    }

    #endregion
}
