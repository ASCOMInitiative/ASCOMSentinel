@page "/log"
@inject Logger logger;
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<h4>Observatory Manager Log</h4>
<div style="height:100%;min-height:100%;%">
    <RadzenTextArea Id="ObsManLog" Style='font-family: "Lucida Console", "Courier New", monospace; font-size: 14px; line-height: 18px; padding-bottom: 0px; width:100%;'
                    Name="_conformState.ScreenLog" @bind-Value=@Globals.applicationLog Rows="@screenLogRows" Cols="250" ReadOnly=true />
</div>
<!-- Rows="@screenLogRows"  -->
@code
{
    int screenLogRows = 10;
    DotNetObjectReference<Log>? objRef;

    public int LogWidth { get; set; }
    public int LogHeight { get; set; }

    protected override async void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            logger.LogMessage("Log.OnAfterRender", $"About to register windows resize callbacks...");
            await JSRuntime.InvokeVoidAsync("window.registerViewportChangeCallback", objRef);
            logger.LogMessage("Log.OnAfterRender", $"Registered windows resize callbacks OK");
            // Scroll the log window to the bottom of its contents.
            // try
            // {
            //     await JSRuntime.InvokeVoidAsync("setScrollTop", "ConformLog", _conformState.ConformLogScrollTop.ToString());
            // }
            // catch (Exception ex)
            // {
            //     Console.WriteLine($"OnInitialized-setScrollTop: {ex}");
            // }

            // Also get initial width
            LogWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            LogHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            OnResize(LogWidth, LogHeight);
            StateHasChanged();

        }
    }

    #region Log textarea - resize support

    // This method will be called when the window resizes.
    // It is ONLY called when the user stops dragging the window's edge. (It is already throttled to protect your app from performance nightmares)
    [JSInvokable]
    public async void OnResize(int width, int height)
    {
        try
        {
            logger.LogMessage("screenLogRows", $"WindowResized - Received - x: {width}, y: {height}");
            LogWidth = width;
            LogHeight = height;

            screenLogRows = Convert.ToInt32(height / 18.0) - 8;
            logger.LogMessage("screenLogRows", $"WindowResized - Setting rows to {screenLogRows}");

            // string browser = "";
            // browser = await JSRuntime.InvokeAsync<string>(identifier: "IdentifyBrowser");

            // if (browser.Contains("Firefox", StringComparison.InvariantCultureIgnoreCase)) screenLogRows -= 1;

            //_conformLogger.LogMessage("Set_conformState.ScreenLogRows", MessageLevel.Debug, $"Window width: {window.Width}, Window.height: {window.Height}, LogTop: {result.Top}, LogHeight: {result.Height}, _conformState.ScreenLogRows: {_conformState.ScreenLogRows}, Browser: {browser}");
            await InvokeAsync(StateHasChanged); // Display the updated log on the screen - invoke required because this event handler method could be called by any thread

        }
        catch (Exception ex)
        {
            logger.LogMessage("Set_conformState.ScreenLogRows", $"Exception: \r\n{ex}");
        }
    }

    #endregion

    public async ValueTask DisposeAsync()
    {
        if (objRef != null)
        {
            await JSRuntime.InvokeVoidAsync("window.unregisterViewportChangeCallback", objRef); // Optional: add unregister JS
            objRef.Dispose();
        }
    }


}
