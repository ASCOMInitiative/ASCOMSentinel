@using Microsoft.AspNetCore.Components.Web
@namespace ObsMan.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="ObsMan.styles.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    @RenderBody()

    <!-- Replaces the default blazor-error-ui; shown if window.close() is blocked by the browser -->
    <div id="server-stopped-overlay"
         style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
                background:#1a1a2e; color:#eee; font-family:sans-serif;
                align-items:center; justify-content:center; z-index:9999; flex-direction:column;">
        <h2 style="margin-bottom:0.5rem;">Server has stopped</h2>
        <p style="color:#aaa;">You may close this window.</p>
    </div>
    <div id="components-reconnect-modal" style="display:none!important"></div>

    <script autostart="false" src="_framework/blazor.server.js"></script>
    <script>
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 0   // Do not attempt to reconnect — server has shut down intentionally
                },
                reconnectionHandler: {
                    onConnectionDown: function (options, error) {
                        // Attempt to close the window; this works if the tab was opened via window.open()
                        window.open('', '_self', '');
                        window.close();

                        // Fallback: if the browser blocked window.close(), show the overlay
                        setTimeout(function () {
                            var overlay = document.getElementById('server-stopped-overlay');
                            if (overlay) overlay.style.display = 'flex';
                        }, 500);
                    },
                    onConnectionUp: function () {
                        var overlay = document.getElementById('server-stopped-overlay');
                        if (overlay) overlay.style.display = 'none';
                    }
                }
            }
        });
    </script>
</body>
</html>
