@using Microsoft.AspNetCore.Components.Web
@namespace ObsMan.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="ObsMan.styles.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    @RenderBody()

    <!-- Suppress Blazor's built-in reconnect modal by providing our own hidden element.
         When Blazor finds this div already in the DOM it uses it instead of injecting its own.
         Blazor still adds CSS classes to it (components-reconnect-show etc.) which the
         MutationObserver below uses as the trigger. -->
    <div id="components-reconnect-modal" style="display:none!important"></div>

    <!-- Shown when the server connection is lost -->
    <div id="server-stopped-overlay"
         style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
                background:rgba(0,0,0,0.75); z-index:9999;">
        <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
                    background:#2a2a4e; color:#eee; font-family:sans-serif; border-radius:8px;
                    padding:2rem 2.5rem; max-width:420px; width:90%; text-align:center;
                    box-shadow:0 4px 24px rgba(0,0,0,0.6);">
            <h2 style="margin:0 0 0.75rem;">Server connection lost</h2>
            <p style="color:#bbb; margin:0 0 1.5rem;">
                The server has stopped. Would you like to wait for it to restart, or close this window?
            </p>
            <div id="server-stopped-buttons">
                <button onclick="waitForServer()"
                        style="margin:0.25rem; padding:0.5rem 1.25rem; border:none; border-radius:4px;
                               background:#1b6ec2; color:#fff; font-size:1rem; cursor:pointer;">
                    Wait for restart
                </button>
                <button onclick="closeBrowser()"
                        style="margin:0.25rem; padding:0.5rem 1.25rem; border:none; border-radius:4px;
                               background:#555; color:#fff; font-size:1rem; cursor:pointer;">
                    Close browser
                </button>
            </div>
            <p id="server-waiting-message" style="display:none; color:#aaa; margin:0.5rem 0 0;">
                Waiting for server to restart&hellip;
            </p>
            <p id="server-close-message" style="display:none; color:#aaa; margin:0.5rem 0 0;">
                You may close this window.
            </p>
        </div>
    </div>

    <script autostart="false" src="_framework/blazor.server.js"></script>
    <script>
        var serverStopped = false;
        var serverPollInterval = null;

        function handleServerStopped() {
            if (serverStopped) return;
            serverStopped = true;

            // Show the dialogue asking the user what to do
            var overlay = document.getElementById('server-stopped-overlay');
            if (overlay) overlay.style.display = 'block';
        }

        function waitForServer() {
            document.getElementById('server-stopped-buttons').style.display = 'none';
            document.getElementById('server-waiting-message').style.display = 'block';

            // Poll until the server responds, then reload to get a fresh Blazor circuit
            serverPollInterval = setInterval(function () {
                fetch(window.location.href, { method: 'HEAD', cache: 'no-cache' })
                    .then(function (response) {
                        if (response.ok) {
                            clearInterval(serverPollInterval);
                            window.location.reload();
                        }
                    })
                    .catch(function () { /* server still unavailable — keep polling */ });
            }, 2000);
        }

        function closeBrowser() {
            document.getElementById('server-stopped-buttons').style.display = 'none';

            // Attempt to close — succeeds in Chromium when the tab was opened programmatically
            window.open('', '_self', '');
            window.close();

            // If window.close() was blocked by the browser, tell the user
            document.getElementById('server-close-message').style.display = 'block';
        }

        // Primary mechanism: MutationObserver watches for Blazor adding CSS classes to the
        // reconnect modal. 'components-reconnect-show' is added the instant the circuit drops,
        // before any retry attempts, so this fires immediately on server shutdown.
        // NOTE: maxRetries must not be 0 — if it is, Blazor skips this class update entirely.
        var reconnectModal = document.getElementById('components-reconnect-modal');
        if (reconnectModal) {
            new MutationObserver(function (mutations) {
                for (var i = 0; i < mutations.length; i++) {
                    if (mutations[i].attributeName === 'class') {
                        var cls = reconnectModal.className;
                        if (cls.indexOf('components-reconnect-show') >= 0 ||
                            cls.indexOf('components-reconnect-failed') >= 0 ||
                            cls.indexOf('components-reconnect-rejected') >= 0) {
                            handleServerStopped();
                        }
                    }
                }
            }).observe(reconnectModal, { attributes: true });
        }

        Blazor.start({
            circuit: {
                reconnectionHandler: {
                    // Belt-and-braces: may fire in addition to the MutationObserver
                    onConnectionDown: function (options, error) { handleServerStopped(); },
                    onConnectionUp: function () {
                        if (serverStopped) {
                            // Server came back within Blazor's own retry window — reload
                            // to get a fresh circuit rather than resuming a potentially stale one
                            clearInterval(serverPollInterval);
                            window.location.reload();
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>
