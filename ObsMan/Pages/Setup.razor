    private string SrvPassword2
    {
        get => _srvPassword2;
        set { _srvPassword2 = value; TrySavePassword(); }
    }

    private string _srvPasswordStatus = string.Empty;

    private void TrySavePassword()
    {
        if (!SrvRequireAuthorization || string.IsNullOrEmpty(_srvPassword) || string.IsNullOrEmpty(_srvPassword2))
        {
            _srvPasswordStatus = string.Empty;
            return;
        }

        if (_srvPassword == _srvPassword2)
        {
            settings.Password = Hash.GetStoragePassword(_srvPassword);
            _srvPasswordStatus = "Password saved.";
        }
        else
        {
            _srvPasswordStatus = "Passwords do not match.";
        }
    }

