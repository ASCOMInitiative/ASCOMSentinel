                                       Description="@settings.ConfiguredDevices[PropertyName.SafetyMonitor9].DisplayName" />
                </RadzenCard>
            </div>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    private List<AscomDevice> ObservingConditionsDevicesAlpaca { get; set; } = new();
    private List<ASCOMRegistration> ObservingConditionsDevicesCom { get; set; } = new();
    private List<AscomDevice> SwitchDevices { get; set; } = new();
    private List<AscomDevice> SafetyMonitorDevicesAlpaca { get; set; } = new();
    private List<ASCOMRegistration> SafetyMonitorDevicesCom { get; set; } = new();
    private List<DiscoveredDevice> observingConditionsDevices = new List<DiscoveredDevice>();
    private List<DiscoveredDevice> safetyMonitorDevices = new List<DiscoveredDevice>();

    private bool discoveryUnderway = false;

    private async Task ResetSettings()
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to reset all settings? This cannot be undone."))
        {
            settings.ResetToDefaults();
            await StartDiscovery();
            await InvokeAsync(StateHasChanged);
        }
    }

    string statusText = "";

    const string alignPoint = "250px"; // Right alignment for settings values in the general settings tab
    AlpacaDiscovery? discovery;
    DotNetObjectReference<Setup>? objRef;
    LogLevel TraceLevel { get { return settings.LogLevel; } set { settings.LogLevel = value; settings.Save(); } }
    private int WindowWidth { get; set; } = 1280;

    private void OnSafetyMonitorDeviceChanged(DiscoveredDevice device) { }

    protected override async Task OnInitializedAsync()
    {
        await StartDiscovery();
    }

    private async Task StartDiscovery()
    {
        try
        {

            discoveryUnderway = true;
            discovery = new AlpacaDiscovery(Globals.ALPACA_SEARCH_STRICT_CASING, settings.TraceAlpacaDiscovery ? logger : null, Globals.USER_AGENT_PRODUCT_NAME,
                (Assembly.GetExecutingAssembly().GetName().Version ?? new Version()).ToString()); // Create a discovery component with or without logging
            discovery.DiscoveryCompleted += AlpacaDiscoveryCompleted;
            discovery.StartDiscovery(1, 10, 32227, 2.0, false, true, true, ASCOM.Common.Alpaca.ServiceType.Http);
            statusText = "Alpaca discovery underway";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogErrorConsole("StartDiscovery", $"Exception during discovery: {ex.Message}\r\n{ex}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("window.registerSetupViewportChangeCallback", objRef);

            // Get the current window size and re-size to this
            int logWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            int logHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            await OnResizeSetup(logWidth, logHeight);
        }
    }

    private async void AlpacaDiscoveryCompleted(object? caller, EventArgs args)
    {
        try
        {

            ObservingConditionsDevicesAlpaca.Clear();
            ObservingConditionsDevicesCom.Clear();
            SwitchDevices.Clear();
            SafetyMonitorDevicesAlpaca.Clear();
            SafetyMonitorDevicesCom.Clear();
            observingConditionsDevices.Clear();
            safetyMonitorDevices.Clear();

            observingConditionsDevices.Add(new DiscoveredDevice());
            safetyMonitorDevices.Add(new DiscoveredDevice());

            ArgumentNullException.ThrowIfNull(discovery, "Alpaca discovery component");
            ObservingConditionsDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.ObservingConditions);
            SwitchDevices = discovery.GetAscomDevices(DeviceTypes.Switch);
            SafetyMonitorDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.SafetyMonitor);

            foreach (AscomDevice device in discovery.GetAscomDevices(null))
            {
                // logger.LogDebug("AlpacaDiscoveryCompleted", $"Found Alpaca device: {device.AscomDeviceType} {device.AscomDeviceName}");
            }

            List<ASCOMRegistration> drivers = Profile.GetDrivers(DeviceTypes.Switch);
            foreach (ASCOMRegistration driver in drivers)
            {
                // logger.LogDebug("AlpacaDiscoveryCompleted", $"Found COM Switch device: {driver.Name} ({driver.ProgID})");
            }

            drivers = Profile.GetDrivers(DeviceTypes.ObservingConditions);
            foreach (ASCOMRegistration driver in drivers)
            {
                // logger.LogDebug("AlpacaDiscoveryCompleted", $"Found COM ObservingConditions device: {driver.Name} ({driver.ProgID})");
                ObservingConditionsDevicesCom.Add(driver);
            }

            drivers = Profile.GetDrivers(DeviceTypes.SafetyMonitor);
            foreach (ASCOMRegistration driver in drivers)
            {
                // logger.LogDebug("AlpacaDiscoveryCompleted", $"Found COM ObservingConditions device: {driver.Name} ({driver.ProgID})");
                SafetyMonitorDevicesCom.Add(driver);
            }

            // Add discovered Alpaca devices
            // logger.LogDebug("", $"GetDeviceNames - Found {ObservingConditionsDevicesAlpaca.Count()} devices.");

            foreach (AscomDevice device in ObservingConditionsDevicesAlpaca)
            {
                // Exclude the observatory manager observing conditions device from the list
                if (device.AscomDeviceName != Globals.OBSERVING_CONDITIONS_DEVICE_NAME)
                {
                    logger.LogDebugConsole("", $"DiscoveredDevices - Adding {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
                    observingConditionsDevices.Add(new DiscoveredDevice
                    {
                        ObsManDeviceType = ObsManDeviceType.ObservingConditions,
                        Protocol = Protocol.Alpaca,
                        Name = device.AscomDeviceName,
                        IpAddress = device.IpAddress,
                        PortNumber = device.IpPort,
                        RemoteDeviceNumber = device.AlpacaDeviceNumber
                    });
                }
            }

            foreach (ASCOMRegistration device in ObservingConditionsDevicesCom)
            {
                // logger.LogDebug("", $"DiscoveredDevices - Adding {device.Name}, {device.ProgID} ");
                observingConditionsDevices.Add(new DiscoveredDevice
                {
                    ObsManDeviceType = ObsManDeviceType.ObservingConditions,
                    Protocol = Protocol.COM,
                    Name = device.Name,
                    ComProgID = device.ProgID
                });
            }

            foreach (DiscoveredDevice device in observingConditionsDevices)
            {
                if (device.ObsManDeviceType != ObsManDeviceType.NotSet)
                    logger.LogMessageConsole("", $"Discovered device: {device.ObsManDeviceType} {device.Name} ({device.Protocol} DisplayName: '{device.DisplayName}')");
            }

            // Add discovered Alpaca devices
            // logger.LogDebug("", $"GetDeviceNames - Found {SafetyMonitorDevicesAlpaca.Count()} Alpaca safety monitor devices.");

            foreach (AscomDevice device in SafetyMonitorDevicesAlpaca)
            {
                // Exclude the observatory manager observing conditions device from the list
                if (device.AscomDeviceName != Globals.OBSERVING_CONDITIONS_DEVICE_NAME)
                {
                    logger.LogDebugConsole("", $"DiscoveredDevices - Adding {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
                    safetyMonitorDevices.Add(new DiscoveredDevice
                    {
                        Protocol = Protocol.Alpaca,
                        ObsManDeviceType = ObsManDeviceType.SafetyMonitor,
                        Name = device.AscomDeviceName,
                        IpAddress = device.IpAddress,
                        PortNumber = device.IpPort
                    });
                }
            }

            foreach (ASCOMRegistration device in SafetyMonitorDevicesCom)
            {
                logger.LogDebugConsole("", $"DiscoveredDevices - Adding {device.Name}, {device.ProgID} ");
                safetyMonitorDevices.Add(new DiscoveredDevice
                {
                    Protocol = Protocol.COM,
                    ObsManDeviceType = ObsManDeviceType.SafetyMonitor,
                    Name = device.Name,
                    ComProgID = device.ProgID
                });
            }

            foreach (DiscoveredDevice device in safetyMonitorDevices)
            {
                if (device.ObsManDeviceType != ObsManDeviceType.NotSet)
                    logger.LogMessageConsole("", $"Discovered device: {device.ObsManDeviceType} {device.Name} ({device.Protocol} DisplayName: '{device.DisplayName}')");
            }

            logger.LogMessageConsole("", $"Discovery complete.");

            statusText = "Discovery completed";
            await InvokeAsync(StateHasChanged);

            // alpacaDiscoveryProgress += $"Discovery complete!";
            // ResizeStatusArea();
            // ascomDevices = new();
            // foreach (AscomDevice device in discovery.GetAscomDevices(Enum.Parse<ObsManDeviceTypes>(selectedObsManDeviceTypeString)))
            // {
            //     ascomDevices.Add(new AlpacaDeviceListItem($"{device.AscomDeviceName} ({device.IpAddress})", device));

            //     Make this device the current device in the UI list if it is an Alpaca device and the device name, IP address and IP port all match the currently selected device values.
            //     if (
            //         (configuration.Settings.DeviceTechnology == DeviceTechnology.Alpaca) &
            //         (device.AscomDeviceName == configuration.Settings.AlpacaDevice.AscomDeviceName) &
            //         (device.IpAddress == configuration.Settings.AlpacaDevice.IpAddress) &
            //         (device.IpPort == configuration.Settings.AlpacaDevice.IpPort)
            //         ) ascomDevice = device;
            // }
            // discoveryInProgress = false;
            // configuration.Settings.OperationInProgress = false;
            // state.RaiseUiHasChangedEvent();

            // ascomDevices.Sort((a, b) => a.DisplayName.CompareTo(b.DisplayName));

            // await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogErrorConsole("AlpacaDiscoveryCompleted", $"Exception: {ex.Message}\r\n{ex}");
        }
        finally
        {
            discoveryUnderway = false;
            await InvokeAsync(StateHasChanged);
            logger.LogDebugConsole("", $"Discovery underway is now false.");
        }
    }

    // This method will be called when the window resizes.
    // It is ONLY called when the user stops dragging the window's edge. (It is already throttled to protect your app from performance nightmares)
    [JSInvokable]
    public async Task OnResizeSetup(int width, int height)
    {
        try
        {
            // Calculate the number of rows that will fit in the available height
            int screenLogRows = Convert.ToInt32(height / 18.0) - 12;
            // logger.LogDebug("OnResizeSetup", $"Window size: {width} x {height}");
            WindowWidth = width;
            state.WindowWidth = width;

            // Save the number of log lines so this can be restored across F5 refreshes and navigation. (Must be done before calling StateHasChanged)
            //state.LastNumberOfLogLines = screenLogRows;

            // Display the updated log on the screen - invoke required because this event handler method could be called by any thread
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogErrorConsole("OnResize", $"Exception: \r\n{ex}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (objRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("window.unregisterSetupViewportChangeCallback"); // Optional: add unregister JS
            }
            catch { }

            try
            {
                objRef.Dispose();
            }
            catch { }
        }
    }

    #region Server settings

    // Server Settings - properties persist immediately to settings on change

    private string SrvLocation
    {
        get => settings.Location;
        set { settings.Location = value; settings.Save(); }
    }

    private bool SrvRemoteAccess
    {
        get => settings.AllowRemoteAccess;
        set
        {
            if (settings.AllowRemoteAccess != value)
            {
                settings.AllowRemoteAccess = value;
                settings.Save();
                Program.Main(Array.Empty<string>());
            }
        }
    }

    private ushort SrvServerPort
    {
        get => settings.ServerPort;
        set
        {
            if (settings.ServerPort != value)
            {
                settings.ServerPort = value;
                settings.Save();
                Program.Main(Array.Empty<string>());
            }
        }
    }

    private bool SrvStrictAPIMode
    {
        get => settings.RunInStrictAlpacaMode;
        set { settings.RunInStrictAlpacaMode = value; settings.Save(); }
    }

    private bool SrvPreventRemoteDisconnects
    {
        get => settings.PreventRemoteDisconnects;
        set { settings.PreventRemoteDisconnects = value; settings.Save(); }
    }

    private bool SrvDiscovery
    {
        get => settings.AllowDiscovery;
        set { settings.AllowDiscovery = value; settings.Save(); }
    }

    private bool SrvLocalHostOnlyOnHost
    {
        get => settings.LocalRespondOnlyToLocalHost;
        set { settings.LocalRespondOnlyToLocalHost = value; settings.Save(); }
    }

    private bool SrvRequireAuthorization
    {
        get => settings.UseAuth;
        set { settings.UseAuth = value; settings.Save(); }
    }

    private bool SrvDisableAuth => !SrvRequireAuthorization;

    private string SrvUserName
    {
        get => settings.UserName;
        set
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                settings.UserName = value;
                settings.Save();
            }
        }
    }

    private string _srvPassword = string.Empty;
    private string SrvPassword
    {
        get => _srvPassword;
        set { _srvPassword = value; TrySavePassword(); }
    }

    private string _srvPassword2 = string.Empty;
    private string SrvPassword2
    {
        get => _srvPassword2;
        set { _srvPassword2 = value; TrySavePassword(); }
    }

    private string _srvPasswordStatus = string.Empty;

    private void TrySavePassword()
    {
        if (!SrvRequireAuthorization || string.IsNullOrEmpty(_srvPassword) || string.IsNullOrEmpty(_srvPassword2))
        {
            _srvPasswordStatus = string.Empty;
            return;
        }

        if (_srvPassword == _srvPassword2)
        {
            settings.Password = Hash.GetStoragePassword(_srvPassword);
            settings.Save();
            _srvPasswordStatus = "Password saved.";
        }
        else
        {
            _srvPasswordStatus = "Passwords do not match.";
        }
    }

    private bool AutoConnect
    {
        get => settings.AutoConnect;
        set { settings.AutoConnect = value; settings.Save(); }
    }

    private LogLevel SrvLoggingLevel
    {
        get => settings.LogLevel;
        set
        {
            settings.LogLevel = value;
            Program.logger?.SetMinimumLoggingLevel(value);
            settings.Save();
        }
    }

    private bool SrvEnableShutdown { get; set; } = false;
    private bool SrvAllowShutdown => !SrvEnableShutdown;

    private void SrvShutdown()
    {
        Program.Lifetime?.StopApplication();
    }

