    // Server Settings - properties persist immediately to ServerSettings on change

    private string SrvLocation
    {
        get => ServerSettings.Location;
        set => ServerSettings.Location = value;
    }

    private bool SrvRemoteAccess
    {
        get => ServerSettings.AllowRemoteAccess;
        set
        {
            if (ServerSettings.AllowRemoteAccess != value)
            {
                ServerSettings.AllowRemoteAccess = value;
                Program.Main(Array.Empty<string>());
            }
        }
    }

    private ushort SrvServerPort
    {
        get => ServerSettings.ServerPort;
        set
        {
            if (ServerSettings.ServerPort != value)
            {
                ServerSettings.ServerPort = value;
                Program.Main(Array.Empty<string>());
            }
        }
    }

    private bool SrvStartBrowser
    {
        get => ServerSettings.AutoStartBrowser;
        set => ServerSettings.AutoStartBrowser = value;
    }

    private bool SrvStrictAPIMode
    {
        get => ServerSettings.RunInStrictAlpacaMode;
        set => ServerSettings.RunInStrictAlpacaMode = value;
    }

    private bool SrvPreventRemoteDisconnects
    {
        get => ServerSettings.PreventRemoteDisconnects;
        set => ServerSettings.PreventRemoteDisconnects = value;
    }

    private bool SrvDiscovery
    {
        get => ServerSettings.AllowDiscovery;
        set => ServerSettings.AllowDiscovery = value;
    }

    private bool SrvLocalHostOnlyOnHost
    {
        get => ServerSettings.LocalRespondOnlyToLocalHost;
        set => ServerSettings.LocalRespondOnlyToLocalHost = value;
    }

    private bool SrvRequireAuthorization
    {
        get => ServerSettings.UseAuth;
        set => ServerSettings.UseAuth = value;
    }

    private bool SrvDisableAuth => !SrvRequireAuthorization;

    private string SrvUserName
    {
        get => ServerSettings.UserName;
        set
        {
            if (!string.IsNullOrWhiteSpace(value))
                ServerSettings.UserName = value;
        }
    }

    private string _srvPassword = string.Empty;
    private string SrvPassword
    {
        get => _srvPassword;
        set { _srvPassword = value; TrySavePassword(); }
    }

    private string _srvPassword2 = string.Empty;
    private string SrvPassword2
    {
        get => _srvPassword2;
        set { _srvPassword2 = value; TrySavePassword(); }
    }

    private string _srvPasswordStatus = string.Empty;

    private void TrySavePassword()
    {
        if (!SrvRequireAuthorization || string.IsNullOrEmpty(_srvPassword) || string.IsNullOrEmpty(_srvPassword2))
        {
            _srvPasswordStatus = string.Empty;
            return;
        }

        if (_srvPassword == _srvPassword2)
        {
            ServerSettings.Password = _srvPassword;
            _srvPasswordStatus = "Password saved.";
        }
        else
        {
            _srvPasswordStatus = "Passwords do not match.";
        }
    }

    private LogLevel SrvLoggingLevel
    {
        get => ServerSettings.LoggingLevel;
        set => ServerSettings.LoggingLevel = value;
    }

    private bool SrvRunSwagger
    {
        get => ServerSettings.RunSwagger;
        set => ServerSettings.RunSwagger = value;
    }

    private bool SrvEnableShutdown { get; set; } = false;
    private bool SrvAllowShutdown => !SrvEnableShutdown;

    private void SrvShutdown()
    {
        Program.Lifetime?.StopApplication();
    }

}
