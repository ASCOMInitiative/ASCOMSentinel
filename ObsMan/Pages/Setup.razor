                                       Description="@settings.ConfiguredDevices[PropertyName.SafetyMonitor3].DisplayName" />
                    <SafetyMonitorRule Name="Safety Monitor 4"
                                       SafetyMonitorState="settings.SafetyMonitorSettings[PropertyName.SafetyMonitor4]"
                                       Property="PropertyName.SafetyMonitor4"
                                       Description="@settings.ConfiguredDevices[PropertyName.SafetyMonitor4].DisplayName" />
                    <SafetyMonitorRule Name="Safety Monitor 5"
                                       SafetyMonitorState="settings.SafetyMonitorSettings[PropertyName.SafetyMonitor5]"
