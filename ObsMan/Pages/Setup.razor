@page "/setup"
@page "/setup/v1/ObservingConditions/0/setup";
@page "/setup/v1/SafetyMonitor/0/setup";
@page "/setup/v1/Switch/0/setup";

@namespace ObsMan

@implements IAsyncDisposable

@inject Settings settings;
@inject ObsManLogger logger;
@inject IJSRuntime JSRuntime
@inject State state;

@using ASCOM.Alpaca.Discovery
@using ASCOM.Com
@using ASCOM.Common
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;
@using ObsMan.Components
@using System.Reflection

<PageTitle>Application Setup</PageTitle>

<h1>Application Setup</h1>

<ObsManButton Click="@UpdateDeviceList" Text="Update Device List" />
<ObsManButton Click="@UpdateDeviceList" Text="Connect to Devices" />


<RadzenTabs Change=@OnTabChange style="height: 820px;margin-top:20px; width:auto; height: auto" RenderMode="TabRenderMode.Client">
    <Tabs>

        <RadzenTabsItem Text="General Setup">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    Trace level
                    <RadzenDropDown @bind-Value=@TraceLevel Data=@Enum.GetValues(typeof(LogLevel)) Style="margin-top:20px;margin-left:20px; margin-right:0px; " />

                </RadzenCard>
            </div>
        </RadzenTabsItem>

        @*Conform configuration*@
        <RadzenTabsItem Text="Composite Observing Conditions Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Device Selection</h4>

                    <span style="display:inline-block; width:150px; text-align:left; margin:0"><b>Property</b></span>
                    <span style="display:inline-block; width:600px; text-align:center; margin:0"><b>Served from Device</b></span>
                    <span style="display:inline-block; width:50px; text-align:center; margin:0"><b>Switch number</b></span>
                    <span style="display:inline-block; width:400px; text-align:center; margin:0"><b>Description</b></span>

                    <DeviceSelection PropertyName="PropertyName.RainRate" Property="Rain Rate" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.WindGust" Property="Wind Gust" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.WindDirection" Property="Wind Direction" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.StarFWHM" Property="Star FWHM" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.SkyTemperature" Property="Sky Temperature" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.SkyBrightness" Property="Sky Brightness" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Switch Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Safety Monitor Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Safety Monitor Rules">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Server Settings">
            <RadzenTabs style="margin-top:10px" RenderMode="TabRenderMode.Client">
                <Tabs>

                    <RadzenTabsItem Text="Server Settings">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <p>Server Version: @Program.ServerVersion</p>
                                <div style="margin-bottom: 10px">
                                    <label>Server Location:</label>
                                    <input type="text" style="width:21ch;" @bind="SrvLocation">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Allow Remote Access:</label>
                                    <input type="checkbox" @bind="SrvRemoteAccess">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Server (Alpaca) Port:</label>
                                    <input type="number" @bind="SrvServerPort" min="1" max="65535" style="width:20ch;">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Open Browser on Start:</label>
                                    <input type="checkbox" @bind="SrvStartBrowser">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Require Strict API Compliance:</label>
                                    <input type="checkbox" @bind="SrvStrictAPIMode">
                                </div>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Bound Addresses">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <table>
                                    <tr>
                                        <th>Addresses server is listening on.</th>
                                    </tr>
                                    @if (ServerSettings.AllowRemoteAccess)
                                    {
                                        try
                                        {
                                            @foreach (var address in ASCOM.Alpaca.DiscoveryManager.AdapterAddress)
                                            {
                                                <tr>
                                                    <td>@address</td>
                                                </tr>
                                            }
                                        }
                                        catch
                                        {
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>localhost</td>
                                        </tr>
                                    }
                                </table>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Other Settings">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color: #479cc8; margin-bottom: 0;">Driver Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Prevent Disconnects:</label>
                                    <input type="checkbox" @bind="SrvPreventRemoteDisconnects">
                                </div>

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Alpaca Discovery Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Allow Discovery:</label>
                                    <input type="checkbox" @bind="SrvDiscovery">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Respond to localhost on loopback only:</label>
                                    <input type="checkbox" @bind="SrvLocalHostOnlyOnHost">
                                </div>

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Security Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Require Authorization:</label>
                                    <input type="checkbox" @bind="SrvRequireAuthorization">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>User Name:</label>
                                    <input type="text" @bind="SrvUserName" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Password:</label>
                                    <input type="password" @bind="SrvPassword" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Repeat:</label>
                                    <input type="password" @bind="SrvPassword2" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                @if (!string.IsNullOrEmpty(_srvPasswordStatus))
                                {
                                    <p style="color: @(_srvPasswordStatus.Contains("not match") ? "red" : "green")">@_srvPasswordStatus</p>
                                }

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Log Settings</h4>
                                <p>The logging system will log out at or above the specified level.</p>
                                <div style="margin-bottom: 10px">
                                    <label>Log Level:</label>
                                    <RadzenDropDown @bind-Value=@SrvLoggingLevel Data=@Enum.GetValues(typeof(LogLevel)) Style="margin-left:10px;" />
                                </div>

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">OpenAPI / Swagger</h4>
                                <p>The OpenAPI / Swagger integration allows for the Alpaca API documentation to be shown by this server. It also allows calls to be made directly in the browser. Note that this will apply on the next time this driver runs.</p>
                                <div style="margin-bottom: 10px">
                                    <label>Run OpenAPI:</label>
                                    <input type="checkbox" @bind="SrvRunSwagger">
                                </div>

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Shutdown Driver</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <span>Shutdown:</span>
                                    <input type="checkbox" @bind="SrvEnableShutdown">
                                    <button @onclick="SrvShutdown" style="min-width:12ch; vertical-align:middle;" disabled="@SrvAllowShutdown">Shutdown</button>
                                </div>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>
        </RadzenTabsItem>

    </Tabs>
</RadzenTabs>



@code {
    AlpacaDiscovery? discovery;
    DotNetObjectReference<Setup>? objRef;
    LogLevel TraceLevel { get { return settings.LogLevel; } set { settings.LogLevel = value; settings.Save(); } }
    private int WindowWidth { get; set; } = 1280;

    protected override async Task OnInitializedAsync()
    {
        discovery = new AlpacaDiscovery(Globals.ALPACA_SEARCH_STRICT_CASING, settings.TraceAlpacaDiscovery ? logger : null, Globals.USER_AGENT_PRODUCT_NAME,
            (Assembly.GetExecutingAssembly().GetName().Version ?? new Version()).ToString()); // Create a discovery component with or without logging
        discovery.AlpacaDevicesUpdated += AlpacaDeviceDiscovered;
        discovery.DiscoveryCompleted += AlpacaDiscoveryCompleted;
        discovery.StartDiscovery();

    }

    protected override async void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("window.registerSetupViewportChangeCallback", objRef);

            // Get the current window size and re-size to this
            int logWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            int logHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            OnResizeSetup(logWidth, logHeight);
            StateHasChanged();
        }
    }

    private async Task UpdateDeviceList()
    {
        logger.LogMessage("Connect", "About to invert Trace value");
        settings.Save();
        logger.LogDebug("Connect", $"Spurious debug message!");
        logger.LogError("Connect", $"Spurious error message!");
    }

