                </RadzenCard>
            </div>
        </RadzenTabsItem>

        @*Conform configuration*@
        <RadzenTabsItem Text="Composite Observing Conditions Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Device Selection</h4>

                    <span style="display:inline-block; width:150px; text-align:left; margin:0"><b>Property</b></span>
                    <span style="display:inline-block; width:600px; text-align:center; margin:0"><b>Served from Device</b></span>
                    <span style="display:inline-block; width:50px; text-align:center; margin:0"><b>Switch number</b></span>
                    <span style="display:inline-block; width:400px; text-align:center; margin:0"><b>Description</b></span>

                    <DeviceSelection PropertyName="PropertyName.RainRate" Property="Rain Rate" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.WindGust" Property="Wind Gust" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.WindDirection" Property="Wind Direction" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.StarFWHM" Property="Star FWHM" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.SkyTemperature" Property="Sky Temperature" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                    <DeviceSelection PropertyName="PropertyName.SkyBrightness" Property="Sky Brightness" AlpacaDevices=@ObservingConditionsDevicesAlpaca ComDevices="@ObservingConditionsDevicesCom" />
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Switch Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Safety Monitor Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Safety Monitor Rules">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>

    </Tabs>
</RadzenTabs>



@code {
    AlpacaDiscovery? discovery;
    DotNetObjectReference<Setup>? objRef;
    LogLevel TraceLevel { get { return settings.LogLevel; } set { settings.LogLevel = value; settings.Save(); } }
    private int WindowWidth { get; set; } = 1280;

    protected override async Task OnInitializedAsync()
    {
        discovery = new AlpacaDiscovery(Globals.ALPACA_SEARCH_STRICT_CASING, settings.TraceAlpacaDiscovery ? logger : null, Globals.USER_AGENT_PRODUCT_NAME,
            (Assembly.GetExecutingAssembly().GetName().Version ?? new Version()).ToString()); // Create a discovery component with or without logging
        discovery.AlpacaDevicesUpdated += AlpacaDeviceDiscovered;
        discovery.DiscoveryCompleted += AlpacaDiscoveryCompleted;
        discovery.StartDiscovery();

    }

    protected override async void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("window.registerSetupViewportChangeCallback", objRef);

            // Get the current window size and re-size to this
            int logWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            int logHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            OnResizeSetup(logWidth, logHeight);
            StateHasChanged();
        }
    }

    private async Task UpdateDeviceList()
    {
        logger.LogMessage("Connect", "About to invert Trace value");
        settings.Save();
        logger.LogDebug("Connect", $"Spurious debug message!");
        logger.LogError("Connect", $"Spurious error message!");
    }

