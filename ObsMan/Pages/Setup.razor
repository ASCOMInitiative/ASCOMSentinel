            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Safety Monitor Rules</h4>
                    <p></p>
                    <SafetyMonitorRule Name="Safety Monitor 0"
                                       SafetyMonitorState="settings.SafetyMonitorSettings[PropertyName.SafetyMonitor0]"
                                       Property="PropertyName.SafetyMonitor0"
                                       Description="@settings.ConfiguredDevices[PropertyName.SafetyMonitor0].DisplayName" />
                    <SafetyMonitorRule Name="Safety Monitor 1"
                                       SafetyMonitorState="settings.SafetyMonitorSettings[PropertyName.SafetyMonitor1]"
                                       Property="PropertyName.SafetyMonitor1"
                                       Description="@settings.ConfiguredDevices[PropertyName.SafetyMonitor1].DisplayName" />
                    <SafetyMonitorRule Name="Safety Monitor 2"
                                       SafetyMonitorState="settings.SafetyMonitorSettings[PropertyName.SafetyMonitor2]"
