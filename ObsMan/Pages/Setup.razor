@page "/setup"
@page "/setup/v1/ObservingConditions/0/setup";
@page "/setup/v1/SafetyMonitor/0/setup";
@page "/setup/v1/Switch/0/setup";

@namespace ObsMan

@implements IAsyncDisposable

@inject Settings settings;
@inject ObsManLogger logger;
@inject IJSRuntime JSRuntime
@inject State state;

@using ASCOM.Alpaca
@using ASCOM.Alpaca.Discovery
@using ASCOM.Com
@using ASCOM.Common
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;
@using ObsMan.Components
@using System.Reflection

<PageTitle>Application Setup</PageTitle>

<h1>Application Setup</h1>
<span>
    <ObsManButton Click="@StartDiscovery" Text="Update Device List" Disabled="@discoveryUnderway" />
    <RadzenText TagName="TagName.Span" Style="display:inline-block; min-width:410px;">@statusText</RadzenText>
    <ObsManButton Click="@ResetSettings" Text="Reset To Defaults" />
</span>
<RadzenTabs style="height: 820px;margin-top:20px; width:auto; height: auto" RenderMode="TabRenderMode.Client">
    <Tabs>

        @*Observatory manager configuration*@
        <RadzenTabsItem Text="General Setup">
            <RadzenTabs style="margin-top:10px" RenderMode="TabRenderMode.Client">
                <Tabs>

                    <RadzenTabsItem Text="Server Settings">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint">Trace Level:</span>
                                    <RadzenDropDown @bind-Value=@TraceLevel Data=@Enum.GetValues(typeof(LogLevel)) Style="margin-top:20px;margin-left:0px; margin-right:0px; " />
                                </div>
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint;">Server Version:</span>
                                    @Program.ServerVersion
                                </div>
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint;">Server Location:</span>
                                    <input type="text" style="width:21ch;" @bind="SrvLocation">
                                </div>
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint;">Allow Remote Access:</span>
                                    <input type="checkbox" @bind="SrvRemoteAccess">
                                </div>
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint;">Server (Alpaca) Port:</span>
                                    <input type="number" @bind="SrvServerPort" min="1" max="65535" style="width:20ch;">
                                </div>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Bound Addresses">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <table>
                                    <tr>
                                        <th>Addresses server is listening on.</th>
                                    </tr>
                                    @if (settings.AllowRemoteAccess)
                                    {
                                        try
                                        {
                                            @foreach (var address in ASCOM.Alpaca.DiscoveryManager.AdapterAddress)
                                            {
                                                <tr>
                                                    <td>@address</td>
                                                </tr>
                                            }
                                        }
                                        catch
                                        {
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>localhost</td>
                                        </tr>
                                    }
                                </table>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Other Settings">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color: #479cc8; margin-bottom: 0;">Driver Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Prevent Disconnects:</label>
                                    <input type="checkbox" @bind="SrvPreventRemoteDisconnects">
                                </div>

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Alpaca Discovery Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Allow Discovery:</label>
                                    <input type="checkbox" @bind="SrvDiscovery">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Respond to localhost on loopback only:</label>
                                    <input type="checkbox" @bind="SrvLocalHostOnlyOnHost">
                                </div>

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Security Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Require Authorization:</label>
                                    <input type="checkbox" @bind="SrvRequireAuthorization">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>User Name:</label>
                                    <input type="text" @bind="SrvUserName" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Password:</label>
                                    <input type="password" @bind="SrvPassword" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Repeat:</label>
                                    <input type="password" @bind="SrvPassword2" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                @if (!string.IsNullOrEmpty(_srvPasswordStatus))
                                {
                                    <p style="color: @(_srvPasswordStatus.Contains("not match") ? "red" : "green")">@_srvPasswordStatus</p>
                                }
                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Connection</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Auto connect:</label>
                                    <input type="checkbox" @bind="AutoConnect">
                                </div>

                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Observing Conditions Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Device Selection</h4>

                    <span style="display:inline-block; width:150px; text-align:left; margin:0"><b>Property</b></span>
                    <span style="display:inline-block; width:600px; text-align:center; margin:0"><b>Served from Device</b></span>

                    <DeviceSelection Property="PropertyName.CloudCover"
                                     PropertyDescription="Cloud Cover"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.CloudCover]" />
                    <DeviceSelection Property="PropertyName.DewPoint"
                                     PropertyDescription="Dew Point"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.DewPoint]" />
                    <DeviceSelection Property="PropertyName.Humidity"
                                     PropertyDescription="Humidity"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.Humidity]" />
                    <DeviceSelection Property="PropertyName.Pressure"
                                     PropertyDescription="Pressure"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.Pressure]" />
                    <DeviceSelection Property="PropertyName.RainRate"
                                     PropertyDescription="Rain Rate"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.RainRate]" />
                    <DeviceSelection Property="PropertyName.SkyBrightness"
                                     PropertyDescription="Sky Brightness"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SkyBrightness]" />
                    <DeviceSelection Property="PropertyName.SkyQuality"
                                     PropertyDescription="Sky Quality"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SkyQuality]" />
                    <DeviceSelection Property="PropertyName.SkyTemperature"
                                     PropertyDescription="Sky Temperature"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SkyTemperature]" />
                    <DeviceSelection Property="PropertyName.StarFWHM"
                                     PropertyDescription="Star FWHM"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.StarFWHM]" />
                    <DeviceSelection Property="PropertyName.Temperature"
                                     PropertyDescription="Temperature"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.Temperature]" />
                    <DeviceSelection Property="PropertyName.WindDirection"
                                     PropertyDescription="Wind Direction"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.WindDirection]" />
                    <DeviceSelection Property="PropertyName.WindGust"
                                     PropertyDescription="Wind Gust"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.WindGust]" />
                    <DeviceSelection Property="PropertyName.WindSpeed"
                                     PropertyDescription="Wind Speed"
                                     DiscoveredDevices=@observingConditionsDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.WindSpeed]" />
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Switch Device" Visible="false">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Safety Monitor Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Device Selection</h4>

                    <span style="display:inline-block; width:150px; text-align:left; margin:0"><b>Property</b></span>
                    <span style="display:inline-block; width:600px; text-align:center; margin:0"><b>Served from Device</b></span>

                    <DeviceSelection Property="PropertyName.SafetyMonitor0"
                                     PropertyDescription="Safety monitor 0"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor0]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor1"
                                     PropertyDescription="Safety monitor 1"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor1]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor2"
                                     PropertyDescription="Safety monitor 2"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor2]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor3"
                                     PropertyDescription="Safety monitor 3"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor3]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor4"
                                     PropertyDescription="Safety monitor 4"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor4]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor5"
                                     PropertyDescription="Safety monitor 5"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor5]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor6"
                                     PropertyDescription="Safety monitor 6"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor6]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor7"
                                     PropertyDescription="Safety monitor 7"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor7]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor8"
                                     PropertyDescription="Safety monitor 8"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor8]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor9"
                                     PropertyDescription="Safety monitor 9"
                                     DiscoveredDevices=@safetyMonitorDevices
                                     CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor9]"
                                     OnDeviceChanged="@OnSafetyMonitorDeviceChanged" />
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Observing Conditions Rules">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Safety Monitor Trigger Rules for Observing Conditions Properties</h4>
                    <p style="padding-top:20px;padding-bottom:20px">
                        The virtual safety monitor will return <b>IsSafe = false</b> when <b>ANY</b> of these conditions are met.
                    </p>

                    <ObservingConditionsRule Property="PropertyName.CloudCover"
                                             PropertyDescription="Cloud Cover"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.CloudCover].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.CloudCover].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.CloudCover].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.CloudCover].Value2"
                                             Units="Percent" />
                    <ObservingConditionsRule Property="PropertyName.DewPoint"
                                             PropertyDescription="Dew Point"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.DewPoint].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.DewPoint].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.DewPoint].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.DewPoint].Value2"
                                             Units="°C" />
                    <ObservingConditionsRule Property="PropertyName.Humidity"
                                             PropertyDescription="Humidity"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.Humidity].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.Humidity].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.Humidity].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.Humidity].Value2"
                                             Units="Percent" />
                    <ObservingConditionsRule Property="PropertyName.Pressure"
                                             PropertyDescription="Pressure"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.Pressure].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.Pressure].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.Pressure].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.Pressure].Value2"
                                             Units="hPa" />
                    <ObservingConditionsRule Property="PropertyName.RainRate"
                                             PropertyDescription="Rain Rate"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.RainRate].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.RainRate].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.RainRate].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.RainRate].Value2"
                                             Units="mm/hr" />
                    <ObservingConditionsRule Property="PropertyName.SkyBrightness"
                                             PropertyDescription="Sky Brightness"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.SkyBrightness].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.SkyBrightness].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.SkyBrightness].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.SkyBrightness].Value2"
                                             Units="Lux" />
                    <ObservingConditionsRule Property="PropertyName.SkyQuality"
                                             PropertyDescription="Sky Quality"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.SkyQuality].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.SkyQuality].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.SkyQuality].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.SkyQuality].Value2"
                                             Units="mag/arcsec²" />
                    <ObservingConditionsRule Property="PropertyName.SkyTemperature"
                                             PropertyDescription="Sky Temperature"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.SkyTemperature].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.SkyTemperature].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.SkyTemperature].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.SkyTemperature].Value2"
                                             Units="°C" />
                    <ObservingConditionsRule Property="PropertyName.StarFWHM"
                                             PropertyDescription="Star FWHM"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.StarFWHM].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.StarFWHM].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.StarFWHM].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.StarFWHM].Value2"
                                             Units="ArcSec" />
                    <ObservingConditionsRule Property="PropertyName.Temperature"
                                             PropertyDescription="Temperature"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.Temperature].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.Temperature].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.Temperature].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.Temperature].Value2"
                                             Units="°C" />
                    <ObservingConditionsRule Property="PropertyName.WindDirection"
                                             PropertyDescription="Wind Direction"
                                             Equality1="settings.ObservingCondtionsRules[PropertyName.WindDirection].EqualityType1"
                                             Value1="settings.ObservingCondtionsRules[PropertyName.WindDirection].Value1"
                                             Equality2="settings.ObservingCondtionsRules[PropertyName.WindDirection].EqualityType2"
                                             Value2="settings.ObservingCondtionsRules[PropertyName.WindDirection].Value2"
                                             Units="Degrees" />
                    <ObservingConditionsRule Property="PropertyName.WindGust"
