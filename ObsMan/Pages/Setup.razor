@page "/setup"
@page "/setup/v1/ObservingConditions/0/setup";
@page "/setup/v1/SafetyMonitor/0/setup";
@page "/setup/v1/Switch/0/setup";

@namespace ObsMan

@implements IAsyncDisposable

@inject Settings settings;
@inject ObsManLogger logger;
@inject IJSRuntime JSRuntime
@inject State state;

@using ASCOM.Alpaca
@using ASCOM.Alpaca.Discovery
@using ASCOM.Com
@using ASCOM.Common
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;
@using ObsMan.Components
@using System.Reflection

<PageTitle>Application Setup</PageTitle>

<h1>Application Setup</h1>
<span>
    <ObsManButton Click="@UpdateDeviceList" Text="Update Device List" /> 
    <RadzenText TagName="TagName.Span" Style="display:inline-block; min-width:410px;">@statusText</RadzenText>
    <ObsManButton Click="@ResetSettings" Text="Reset To Defaults" />
</span>
<RadzenTabs Change=@OnTabChange style="height: 820px;margin-top:20px; width:auto; height: auto" RenderMode="TabRenderMode.Client">
    <Tabs>

        @*Observatory manager configuration*@
        <RadzenTabsItem Text="General Setup">
            <RadzenTabs style="margin-top:10px" RenderMode="TabRenderMode.Client">
                <Tabs>

                    <RadzenTabsItem Text="Server Settings">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint">Trace Level:</span>
                                    <RadzenDropDown @bind-Value=@TraceLevel Data=@Enum.GetValues(typeof(LogLevel)) Style="margin-top:20px;margin-left:0px; margin-right:0px; " />
                                </div>
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint;">Server Version:</span>
                                    @Program.ServerVersion
                                </div>
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint;">Server Location:</span>
                                    <input type="text" style="width:21ch;" @bind="SrvLocation">
                                </div>
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint;">Allow Remote Access:</span>
                                    <input type="checkbox" @bind="SrvRemoteAccess">
                                </div>
                                <div style="margin-bottom:10px">
                                    <span style="display:inline-block;min-width:@alignPoint;">Server (Alpaca) Port:</span>
                                    <input type="number" @bind="SrvServerPort" min="1" max="65535" style="width:20ch;">
                                </div>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Bound Addresses">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <table>
                                    <tr>
                                        <th>Addresses server is listening on.</th>
                                    </tr>
                                    @if (settings.AllowRemoteAccess)
                                    {
                                        try
                                        {
                                            @foreach (var address in ASCOM.Alpaca.DiscoveryManager.AdapterAddress)
                                            {
                                                <tr>
                                                    <td>@address</td>
                                                </tr>
                                            }
                                        }
                                        catch
                                        {
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>localhost</td>
                                        </tr>
                                    }
                                </table>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Other Settings">
                        <div class="row" style="margin-top: 10px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color: #479cc8; margin-bottom: 0;">Driver Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Prevent Disconnects:</label>
                                    <input type="checkbox" @bind="SrvPreventRemoteDisconnects">
                                </div>

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Alpaca Discovery Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Allow Discovery:</label>
                                    <input type="checkbox" @bind="SrvDiscovery">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Respond to localhost on loopback only:</label>
                                    <input type="checkbox" @bind="SrvLocalHostOnlyOnHost">
                                </div>

                                <h4 style="color: #479cc8; margin-top: 20px; margin-bottom: 0;">Security Settings</h4>
                                <div style="margin-bottom: 10px; margin-top: 10px">
                                    <label>Require Authorization:</label>
                                    <input type="checkbox" @bind="SrvRequireAuthorization">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>User Name:</label>
                                    <input type="text" @bind="SrvUserName" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Password:</label>
                                    <input type="password" @bind="SrvPassword" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                <div style="margin-bottom: 10px">
                                    <label>Repeat:</label>
                                    <input type="password" @bind="SrvPassword2" style="width:21ch;" disabled="@SrvDisableAuth">
                                </div>
                                @if (!string.IsNullOrEmpty(_srvPasswordStatus))
                                {
                                    <p style="color: @(_srvPasswordStatus.Contains("not match") ? "red" : "green")">@_srvPasswordStatus</p>
                                }
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Observing Conditions Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Device Selection</h4>

                    <span style="display:inline-block; width:150px; text-align:left; margin:0"><b>Property</b></span>
                    <span style="display:inline-block; width:600px; text-align:center; margin:0"><b>Served from Device</b></span>

                    <DeviceSelection Property="PropertyName.CloudCover" PropertyDescription="Cloud Cover" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.CloudCover]" />
                    <DeviceSelection Property="PropertyName.DewPoint" PropertyDescription="Dew Point" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.DewPoint]" />
                    <DeviceSelection Property="PropertyName.Humidity" PropertyDescription="Humidity" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.Humidity]" />
                    <DeviceSelection Property="PropertyName.Pressure" PropertyDescription="Pressure" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.Pressure]" />
                    <DeviceSelection Property="PropertyName.RainRate" PropertyDescription="Rain Rate" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.RainRate]" />
                    <DeviceSelection Property="PropertyName.SkyBrightness" PropertyDescription="Sky Brightness" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SkyBrightness]" />
                    <DeviceSelection Property="PropertyName.SkyQuality" PropertyDescription="Sky Quality" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SkyQuality]" />
                    <DeviceSelection Property="PropertyName.SkyTemperature" PropertyDescription="Sky Temperature" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SkyTemperature]" />
                    <DeviceSelection Property="PropertyName.StarFWHM" PropertyDescription="Star FWHM" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.StarFWHM]" />
                    <DeviceSelection Property="PropertyName.Temperature" PropertyDescription="Temperature" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.Temperature]" />
                    <DeviceSelection Property="PropertyName.WindDirection" PropertyDescription="Wind Direction" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.WindDirection]" />
                    <DeviceSelection Property="PropertyName.WindGust" PropertyDescription="Wind Gust" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.WindGust]" />
                    <DeviceSelection Property="PropertyName.WindSpeed" PropertyDescription="Wind Speed" DiscoveredDevices=@observingConditionsDevices CurrentValue="settings.ConfiguredDevices[PropertyName.WindSpeed]" />
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Switch Device" Visible="false">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Composite Safety Monitor Device">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Device Selection</h4>

                    <span style="display:inline-block; width:150px; text-align:left; margin:0"><b>Property</b></span>
                    <span style="display:inline-block; width:600px; text-align:center; margin:0"><b>Served from Device</b></span>

                    <DeviceSelection Property="PropertyName.SafetyMonitor0" PropertyDescription="Safety monitor 0" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor0]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor1" PropertyDescription="Safety monitor 1" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor1]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor2" PropertyDescription="Safety monitor 2" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor2]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor3" PropertyDescription="Safety monitor 3" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor3]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor4" PropertyDescription="Safety monitor 4" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor4]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor5" PropertyDescription="Safety monitor 5" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor5]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor6" PropertyDescription="Safety monitor 6" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor6]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor7" PropertyDescription="Safety monitor 7" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor7]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor8" PropertyDescription="Safety monitor 8" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor8]" />
                    <DeviceSelection Property="PropertyName.SafetyMonitor9" PropertyDescription="Safety monitor 9" DiscoveredDevices=@safetyMonitorDevices CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor9]" />
                </RadzenCard>
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Safety Monitor Rules">
            <div class="row" style="margin-top: 10px">
                <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                    <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                </RadzenCard>
            </div>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    private async Task ResetSettings()
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to reset all settings? This cannot be undone."))
        {
            settings.ResetToDefaults();
            StartDiscovery();
            StateHasChanged();
        }
    }

    string statusText = "";

    const string alignPoint = "250px"; // Right alignment for settings values in the general settings tab
    AlpacaDiscovery? discovery;
    DotNetObjectReference<Setup>? objRef;
    LogLevel TraceLevel { get { return settings.LogLevel; } set { settings.LogLevel = value; settings.Save(); } }
    private int WindowWidth { get; set; } = 1280;

    protected override async Task OnInitializedAsync()
    {
        StartDiscovery();
    }

    private void StartDiscovery()
    {
        discovery = new AlpacaDiscovery(Globals.ALPACA_SEARCH_STRICT_CASING, settings.TraceAlpacaDiscovery ? logger : null, Globals.USER_AGENT_PRODUCT_NAME,
            (Assembly.GetExecutingAssembly().GetName().Version ?? new Version()).ToString()); // Create a discovery component with or without logging
        discovery.AlpacaDevicesUpdated += AlpacaDeviceDiscovered;
        discovery.DiscoveryCompleted += AlpacaDiscoveryCompleted;
        discovery.StartDiscovery();
        statusText = "Alpaca discovery underway";
        InvokeAsync(StateHasChanged);
    }

    protected override async void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("window.registerSetupViewportChangeCallback", objRef);

            // Get the current window size and re-size to this
            int logWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            int logHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            OnResizeSetup(logWidth, logHeight);
            StateHasChanged();
        }
    }

    private async Task UpdateDeviceList()
    {
        StartDiscovery();
    }

    private async void OnTabChange()
    {

    }

    private List<AscomDevice> ObservingConditionsDevicesAlpaca { get; set; } = new();
    private List<ASCOMRegistration> ObservingConditionsDevicesCom { get; set; } = new();
    private List<AscomDevice> SwitchDevices { get; set; } = new();
    private List<AscomDevice> SafetyMonitorDevicesAlpaca { get; set; } = new();
    private List<ASCOMRegistration> SafetyMonitorDevicesCom { get; set; } = new();
    private List<DiscoveredDevice> observingConditionsDevices = new List<DiscoveredDevice>();
    private List<DiscoveredDevice> safetyMonitorDevices = new List<DiscoveredDevice>();

    private async void AlpacaDiscoveryCompleted(object? caller, EventArgs args)
    {
        ArgumentNullException.ThrowIfNull(discovery, "Alpaca discovery component");
        ObservingConditionsDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.ObservingConditions);

        logger.LogDebug("AlpacaDiscoveryCompleted", $"AlpacaDiscoveryCompleted - Found {ObservingConditionsDevicesAlpaca.Count} devices");
        SwitchDevices = discovery.GetAscomDevices(DeviceTypes.Switch);
        SafetyMonitorDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.SafetyMonitor);

        foreach (AscomDevice device in discovery.GetAscomDevices(null))
        {
            logger.LogMessage("AlpacaDiscoveryCompleted", $"Found Alpaca device: {device.AscomDeviceType} {device.AscomDeviceName}");
        }

        List<ASCOMRegistration> drivers = Profile.GetDrivers(DeviceTypes.Switch);
        foreach (ASCOMRegistration driver in drivers)
        {
            //logger.LogMessage("AlpacaDiscoveryCompleted", $"Found COM Switch device: {driver.Name} ({driver.ProgID})");
        }

        drivers = Profile.GetDrivers(DeviceTypes.ObservingConditions);
        foreach (ASCOMRegistration driver in drivers)
        {
            logger.LogMessage("AlpacaDiscoveryCompleted", $"Found COM ObservingConditions device: {driver.Name} ({driver.ProgID})");
            ObservingConditionsDevicesCom.Add(driver);
        }

        drivers = Profile.GetDrivers(DeviceTypes.SafetyMonitor);
        foreach (ASCOMRegistration driver in drivers)
        {
            logger.LogMessage("AlpacaDiscoveryCompleted", $"Found COM ObservingConditions device: {driver.Name} ({driver.ProgID})");
            SafetyMonitorDevicesCom.Add(driver);
        }


        observingConditionsDevices.Clear();
        observingConditionsDevices.Add(new DiscoveredDevice());

        // Add discovered Alpaca devices
        logger.LogDebug("", $"GetDeviceNames - Found {ObservingConditionsDevicesAlpaca.Count()} devices.");

        foreach (AscomDevice device in ObservingConditionsDevicesAlpaca)
        {
            // Exclude the observatory manager observing conditions device from the list
            if (device.AscomDeviceName != Globals.OBSERVING_CONDITIONS_DEVICE_NAME)
            {
                logger.LogDebug("", $"DiscoveredDevices - Adding {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
                observingConditionsDevices.Add(new DiscoveredDevice
                {
                    ObsManDeviceType = ObsManDeviceType.ObservingConditions,
                    Protocol = Protocol.Alpaca,
                    Name = device.AscomDeviceName,
                    IpAddress = device.IpAddress,
                    PortNumber = device.IpPort,
                    RemoteDeviceNumber = device.AlpacaDeviceNumber
                });
            }
        }

        foreach (ASCOMRegistration device in ObservingConditionsDevicesCom)
        {
            logger.LogDebug("", $"DiscoveredDevices - Adding {device.Name}, {device.ProgID} ");
            observingConditionsDevices.Add(new DiscoveredDevice
            {
                ObsManDeviceType = ObsManDeviceType.ObservingConditions,
                Protocol = Protocol.COM,
                Name = device.Name,
                ComProgID = device.ProgID
            });
        }

        foreach (DiscoveredDevice device in observingConditionsDevices)
        {
            logger.LogMessage("", $"Discovered device: {device.ObsManDeviceType} {device.Name} ({device.Protocol} DisplayName: '{device.DisplayName}')");
        }

        safetyMonitorDevices.Clear();
        safetyMonitorDevices.Add(new DiscoveredDevice());

        // Add discovered Alpaca devices
        logger.LogDebug("", $"GetDeviceNames - Found {SafetyMonitorDevicesAlpaca.Count()} Alpaca safety monitor devices.");

        foreach (AscomDevice device in SafetyMonitorDevicesAlpaca)
        {
            // Exclude the observatory manager observing conditions device from the list
            if (device.AscomDeviceName != Globals.OBSERVING_CONDITIONS_DEVICE_NAME)
            {
                logger.LogDebug("", $"DiscoveredDevices - Adding {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
                safetyMonitorDevices.Add(new DiscoveredDevice
                {
                    Protocol = Protocol.Alpaca,
                    ObsManDeviceType = ObsManDeviceType.SafetyMonitor,
                    Name = device.AscomDeviceName,
                    IpAddress = device.IpAddress,
                    PortNumber = device.IpPort
                });
            }
        }

        foreach (ASCOMRegistration device in SafetyMonitorDevicesCom)
        {
            logger.LogDebug("", $"DiscoveredDevices - Adding {device.Name}, {device.ProgID} ");
            safetyMonitorDevices.Add(new DiscoveredDevice
            {
                Protocol = Protocol.COM,
                ObsManDeviceType = ObsManDeviceType.SafetyMonitor,
                Name = device.Name,
                ComProgID = device.ProgID
            });
        }

        foreach (DiscoveredDevice device in safetyMonitorDevices)
        {
            logger.LogMessage("", $"Discovered device: {device.ObsManDeviceType} {device.Name} ({device.Protocol} DisplayName: '{device.DisplayName}')");
        }



        logger.LogMessage("", $"Discovery complete.");

        statusText = "Discovery completed";
        await InvokeAsync(StateHasChanged);

        // alpacaDiscoveryProgress += $"Discovery complete!";
        // ResizeStatusArea();
        // ascomDevices = new();
        // foreach (AscomDevice device in discovery.GetAscomDevices(Enum.Parse<ObsManDeviceTypes>(selectedObsManDeviceTypeString)))
        // {
        //     ascomDevices.Add(new AlpacaDeviceListItem($"{device.AscomDeviceName} ({device.IpAddress})", device));

        //     Make this device the current device in the UI list if it is an Alpaca device and the device name, IP address and IP port all match the currently selected device values.
        //     if (
        //         (configuration.Settings.DeviceTechnology == DeviceTechnology.Alpaca) &
        //         (device.AscomDeviceName == configuration.Settings.AlpacaDevice.AscomDeviceName) &
        //         (device.IpAddress == configuration.Settings.AlpacaDevice.IpAddress) &
        //         (device.IpPort == configuration.Settings.AlpacaDevice.IpPort)
        //         ) ascomDevice = device;
        // }
        // discoveryInProgress = false;
        // configuration.Settings.OperationInProgress = false;
        // state.RaiseUiHasChangedEvent();

        // ascomDevices.Sort((a, b) => a.DisplayName.CompareTo(b.DisplayName));

        // await InvokeAsync(StateHasChanged);
    }

    // This method will be called when the window resizes.
    // It is ONLY called when the user stops dragging the window's edge. (It is already throttled to protect your app from performance nightmares)
    [JSInvokable]
    public async void OnResizeSetup(int width, int height)
    {
        try
        {
            // Calculate the number of rows that will fit in the available height
            int screenLogRows = Convert.ToInt32(height / 18.0) - 12;
            //logger.LogDebug("OnResizeSetup", $"Window size: {width} x {height}");
            WindowWidth = width;
            state.WindowWidth = width;

            // Save the number of log lines so this can be restored across F5 refreshes and navigation. (Must be done before calling StateHasChanged)
            //state.LastNumberOfLogLines = screenLogRows;

            // Display the updated log on the screen - invoke required because this event handler method could be called by any thread
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogError("OnResize", $"Exception: \r\n{ex}");
        }
    }



    public async ValueTask DisposeAsync()
    {
        if (objRef != null)
        {
            await JSRuntime.InvokeVoidAsync("window.unregisterSetupViewportChangeCallback"); // Optional: add unregister JS
            objRef.Dispose();
        }
    }

    private async void AlpacaDeviceDiscovered(object? caller, EventArgs args)
    {
        ArgumentNullException.ThrowIfNull(discovery, "Alpaca discovery component");

        List<AscomDevice> newDevices = discovery.GetAscomDevices(null);

        foreach (AscomDevice device in newDevices)
        {
            string deviceKey = $"{device.AscomDeviceName} {device.IpAddress} {device.IpPort}";
            // if (!discoveredAlpacaDevices.Contains<string>(deviceKey))
            // {
            //     discoveredAlpacaDevices.Add(deviceKey);
            //     alpacaDiscoveryProgress += $"{deviceKey}\r\n";
            //     ResizeStatusArea();
            // }
        }
        //logger.LogDebug("AlpacaDeviceDiscovered", $"Found {newDevices.Count} devices.");

        // await InvokeAsync(StateHasChanged);
    }

    // Server Settings - properties persist immediately to settings on change

    private string SrvLocation
    {
        get => settings.Location;
        set { settings.Location = value; settings.Save(); }
    }

    private bool SrvRemoteAccess
    {
        get => settings.AllowRemoteAccess;
        set
        {
            if (settings.AllowRemoteAccess != value)
            {
                settings.AllowRemoteAccess = value;
                settings.Save();
                Program.Main(Array.Empty<string>());
            }
        }
    }

    private ushort SrvServerPort
    {
        get => settings.ServerPort;
        set
        {
            if (settings.ServerPort != value)
            {
                settings.ServerPort = value;
                settings.Save();
                Program.Main(Array.Empty<string>());
            }
        }
    }

    private bool SrvStrictAPIMode
    {
        get => settings.RunInStrictAlpacaMode;
        set { settings.RunInStrictAlpacaMode = value; settings.Save(); }
    }

    private bool SrvPreventRemoteDisconnects
    {
        get => settings.PreventRemoteDisconnects;
        set { settings.PreventRemoteDisconnects = value; settings.Save(); }
    }

    private bool SrvDiscovery
    {
        get => settings.AllowDiscovery;
        set { settings.AllowDiscovery = value; settings.Save(); }
    }

    private bool SrvLocalHostOnlyOnHost
    {
        get => settings.LocalRespondOnlyToLocalHost;
        set { settings.LocalRespondOnlyToLocalHost = value; settings.Save(); }
    }

    private bool SrvRequireAuthorization
    {
        get => settings.UseAuth;
        set { settings.UseAuth = value; settings.Save(); }
    }

    private bool SrvDisableAuth => !SrvRequireAuthorization;

    private string SrvUserName
    {
        get => settings.UserName;
        set
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                settings.UserName = value;
                settings.Save();
            }
        }
    }

    private string _srvPassword = string.Empty;
    private string SrvPassword
    {
        get => _srvPassword;
        set { _srvPassword = value; TrySavePassword(); }
    }

    private string _srvPassword2 = string.Empty;
    private string SrvPassword2
    {
        get => _srvPassword2;
        set { _srvPassword2 = value; TrySavePassword(); }
    }

    private string _srvPasswordStatus = string.Empty;

    private void TrySavePassword()
    {
        if (!SrvRequireAuthorization || string.IsNullOrEmpty(_srvPassword) || string.IsNullOrEmpty(_srvPassword2))
        {
            _srvPasswordStatus = string.Empty;
            return;
        }

        if (_srvPassword == _srvPassword2)
        {
            settings.Password = Hash.GetStoragePassword(_srvPassword);
            settings.Save();
            _srvPasswordStatus = "Password saved.";
        }
        else
        {
            _srvPasswordStatus = "Passwords do not match.";
        }
    }

    private LogLevel SrvLoggingLevel
    {
        get => settings.LogLevel;
        set
        {
            settings.LogLevel = value;
            Program.logger?.SetMinimumLoggingLevel(value);
            settings.Save();
        }
    }

    private bool SrvEnableShutdown { get; set; } = false;
    private bool SrvAllowShutdown => !SrvEnableShutdown;

    private void SrvShutdown()
    {
        Program.Lifetime?.StopApplication();
    }

}
