<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Product>Safety Monitor Interface Update v0.10</Product>
    <InformationalVersion>0.1</InformationalVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>SafetyMonitorDraftComponents</PackageId>
    <Title>Draft ASCOM safety monitor extension proposal</Title>
    <Authors>ASCOM Initiative</Authors>
    <Description>The draft ASCOM ISafetyMonitorV4 interface and associated classes and enums.</Description>
    <PackageIcon>Bug72.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Help\icons\Bug72.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ASCOM.DeviceInterfaces" Version="7.0.0" />
    <PackageReference Include="ASCOM.Exception.Library" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
