      <NamespaceSummaryItem name="SafetyMonitorExtension" isDocumented="True">Proposed additions to the Safety Monitor interface</NamespaceSummaryItem>
    </NamespaceSummaries>
    <ComponentConfigurations>
    </ComponentConfigurations>
    <PlugInConfigurations>
    </PlugInConfigurations>
    <ApiFilter>
      <Filter entryType="Namespace" fullName="ASCOM.DeviceInterface" isExposed="True">
        <Filter entryType="Class" fullName="ASCOM.DeviceInterface.ISafetyMonitorV3" filterName="ISafetyMonitorV3" isExposed="True">
