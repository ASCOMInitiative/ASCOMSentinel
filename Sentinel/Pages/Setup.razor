@page "/setup"
@page "/setup/v1/ObservingConditions/0/setup";
@page "/setup/v1/SafetyMonitor/0/setup";
@page "/setup/v1/Switch/0/setup";

@namespace Sentinel

@implements IAsyncDisposable

@inject Settings settings;
@inject AppLogger logger;
@inject IJSRuntime JSRuntime
@inject State state;
@inject DialogService DialogService

@using ASCOM.Alpaca
@using ASCOM.Alpaca.Discovery
@using ASCOM.Common
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;
@using Sentinel.Components
@using System.Reflection

<PageTitle>Application Setup</PageTitle>

<RadzenTabs style="height: 820px;margin-top:20px; width:auto; height: auto" RenderMode="TabRenderMode.Server" Change="(item) => OnTabChanged(item)">
    <Tabs>
        <RadzenTabsItem Text="Application Settings">
            <RadzenTabs style="margin-top:12px" RenderMode="TabRenderMode.Server">
                <Tabs>
                    <RadzenTabsItem Text="Application">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color:cornflowerblue">Application</h4>
                                <div style="margin-bottom:12px">
                                    <span class="indentedlist">Location:</span>
                                    <RadzenTextBox Value="@SrvLocation" Style="width:50ch; border: 1px solid black;" Change=@(args => OnLocationChange(args, "TextBox")) />
                                </div>
                                <div style="margin-bottom:12px">
                                    <span class="indentedlist">Application IP Port:</span>
                                    <RadzenNumeric Value=@SrvServerPort
                                                   TValue=ushort
                                                   Step="1"
                                                   Style="margin-top:00px;margin-left:0px; margin-right:0px; width: 100px; text-align:left; border: 1px solid black;"
                                                   Change=@(args => @ServerPortChanged(args))
                                                   Min="1"
                                                   TextAlign="TextAlign.Right"
                                                   ShowUpDown="true"
                                                   Name="SrvServerPort" />
                                    <span style="margin-left:12px;">(Requires restart - default 32324)</span>
                                </div>
                                <div style="margin-bottom: 0px; margin-top: 0px">
                                    <label class="indentedlist">Alpaca communication timeout (seconds):</label>
                                    <RadzenNumeric Value=@settings.AlpacaGetPropertyTimeout
                                                   TValue=int
                                                   Step="1"
                                                   Style="margin-top:00px;margin-left:0px; margin-right:0px; width: 100px; text-align:left; border: 1px solid black;"
                                                   Change=@(args => AlpacaGetPropertyTimeoutChanged(args))
                                                   Min="1"
                                                   TextAlign="TextAlign.Right"
                                                   ShowUpDown="true"
                                                   Name="AlpacaGetPropertyTimeout" />
                                    <span style="margin-left:12px;">(Requires devices to be reconnected)</span>
                                </div>
                                <div style="margin-bottom: 0px; margin-top: 12px">
                                    <label class="indentedlist">Property cache time (seconds):</label>
                                    <RadzenNumeric Value=@settings.PropertyCacheTime.TotalSeconds
                                                   TValue=double
                                                   Step="1"
                                                   Style="margin-top:00px;margin-left:0px; margin-right:0px; width: 100px; text-align:left; border: 1px solid black;"
                                                   Change=@(args => PropertyCacheTimeChanged(args))
                                                   Min="0"
                                                   Format="0.0"
                                                   TextAlign="TextAlign.Right"
                                                   ShowUpDown="true"
                                                   Name="PropertyCacheTime" />
                                    <span style="margin-left:12px;">(Limits real device property queries to once every x seconds)</span>
                                </div>

                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Bind to all host network addresses:</label>
                                    <input style="margin-left:52px;" type="checkbox" @bind="BindToAllNetworkAddresses" />
                                    <span style="margin-left:12px;">(Requires restart - Unchecked = localhost only)</span>
                                </div>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Composite devices stay connected:</label>
                                    <input style="margin-left:48px;" type="checkbox" @bind="SrvPreventRemoteDisconnects" />
                                    <span style="margin-left:12px;">(Clients cannot set Connected = False)</span>
                                </div>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Include safety warnings in the log:</label>
                                    <input style="margin-left:59px;" type="checkbox" @bind="LogSafetyWarnings" />
                                    <span style="margin-left:12px;">(Warnings are still sent to clients when unchecked)</span>
                                </div>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Include discovery messages in the log:</label>
                                    <input style="margin-left:25px;" type="checkbox" @bind="LogDiscoveryMessages" />
                                </div>
                               
                                <h4 style="color:cornflowerblue;margin-top:24px;">Debug settings</h4>
                                <div style="margin-bottom:12px">
                                    <span class="indentedlist">Trace Level:</span>
                                    <RadzenDropDown Value=@TraceLevel
                                                    TValue=LogLevel
                                                    Change="TraceLevelChanged"
                                                    Data=@Enum.GetValues(typeof(LogLevel))
                                                    PopupStyle="max-height:15em); overflow:auto;"
                                                    Style="margin-top:00px;margin-left:0px; margin-right:0px; border: 1px solid black;" />
                                    <span style="margin-left:12px;">(Requires devices to be reconnected).</span>

                                </div>
                                <div style="margin-bottom:12px; margin-top:12px">
                                    <label>Show Alpaca client trace messages:</label>
                                    <input style="margin-left:42px;" type="checkbox" @bind="IncludeAlpacaTraceChanged" disabled="@(TraceLevel >= LogLevel.Information)" />
                                    <span>(Requires devices to be reconnected - Only functional when trace level is Debug).</span>
                                </div>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Startup">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color:cornflowerblue">Startup</h4>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Enable remote client access at startup:</label>
                                    <input style="margin-left:40px;" type="checkbox" @bind="EnableRemoteClientsAtStartup" />
                                </div>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Connect to configured devices when started:</label>
                                    <input type="checkbox" @bind="AutoConnect" />
                                    <div style="margin-bottom: 12px; margin-top: 12px">
                                        <label>Start browser on launch:</label>
                                        <input style="margin-left:142px;" type="checkbox" @bind="StartBrowserOnLaunch" />
                                    </div>
                                </div>

                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Discovery">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color:cornflowerblue;">Alpaca Discovery</h4>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Enable discovery:</label>
                                    <input style="margin-left:306px;" type="checkbox" @bind="SrvDiscovery" />
                                </div>
                                <div style="margin-bottom: 0px; margin-top: 0px">
                                    <label>Discovery duration (seconds):</label>
                                    <RadzenNumeric Value=@settings.AlpacaDiscoveryDuration
                                                   TValue=double
                                                   Step="1.0"
                                                   Style="margin-top:00px;margin-left:220px; margin-right:0px; width: 140px; text-align:left; border: 1px solid black;"
                                                   Change=@(args => DiscoveryDurationChanged(args))
                                                   Min="1"
                                                   Format="0.0"
                                                   ShowUpDown="true"
                                                   Name="AlpacaDiscoveryDuration" />
                                </div>
                                <div style="margin-top:8px;margin-bottom:12px">
                                    <span style="display:inline-block;min-width:250px;">Respond to local client discovery packets on localhost only:</span>
                                    <input style="margin-left:12px;" type="checkbox" @bind="DiscoveryResponseOnlyOnLocalHost" />
                                    <span style="margin-left:12px;">Unchecked = respond on all interfaces. (Requires restart)</span>
                                </div>
        
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Confirmation">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color:cornflowerblue;">Confirmation</h4>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Confirm changing online state:</label>
                                    <input type="checkbox" @bind="ConfirmOnline" />
                                </div>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Confirm changing device state when online:</label>
                                    <input style="margin-left:6px;" type="checkbox" @bind="ConfirmDisconnectDevices" />
                                </div>

                                <div style="margin-top:24px;padding-top:24px;">
                                    <SentinelButton Click="@UncheckConfirmSettings" Text="Uncheck all settings" Disabled="@(state.OperationUnderway)" />
                                </div>

                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Display">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color: cornflowerblue; margin-bottom: 12px;">Configure Display Gauge Limits.</h4>
                                <div>
                                    <b>
                                        <span style="display:flex; gap:22px; align-items:center;">
                                            <div style="min-height:24px; width:140px; display:flex; align-items:center; justify-content:left;">
                                                Property
                                            </div>
                                            <div style="min-height:24px; width:140px; display:flex; align-items:center; justify-content:center;">
                                                Minimum
                                            </div>
                                            <div style="min-height:24px; width:140px; display:flex; align-items:center; justify-content:center;text-align:center;">
                                                Green - Orange Transition
                                            </div>
                                            <div style="min-height:24px; width:140px; display:flex; align-items:center; justify-content:center;text-align:center;">
                                                Orange - Red Transition
                                            </div>
                                            <div style="min-height:24px; width:140px; display:flex; align-items:center; justify-content:center;">
                                                Maximum
                                            </div>
                                            <div style="min-height:24px; width:140px; display:flex; align-items:center; justify-content:center;text-align:center;">
                                                Number of Segments
                                            </div>
                                            <div style="min-height:24px; width:140px; display:flex; align-items:center; justify-content:center;text-align:center;">
                                                Display Order
                                            </div>
                                        </span>
                                    </b>
                                </div>
                                <GaugeSettings Property=@PropertyName.CloudCover Configuration="@settings.GaugeSettings[PropertyName.CloudCover]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.DewPoint Configuration="@settings.GaugeSettings[PropertyName.DewPoint]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.Humidity Configuration="@settings.GaugeSettings[PropertyName.Humidity]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.Pressure Configuration="@settings.GaugeSettings[PropertyName.Pressure]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.RainRate Configuration="@settings.GaugeSettings[PropertyName.RainRate]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.SkyBrightness Configuration="@settings.GaugeSettings[PropertyName.SkyBrightness]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.SkyQuality Configuration="@settings.GaugeSettings[PropertyName.SkyQuality]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.SkyTemperature Configuration="@settings.GaugeSettings[PropertyName.SkyTemperature]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.StarFWHM Configuration="@settings.GaugeSettings[PropertyName.StarFWHM]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.Temperature Configuration="@settings.GaugeSettings[PropertyName.Temperature]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.WindDirection Configuration="@settings.GaugeSettings[PropertyName.WindDirection]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.WindSpeed Configuration="@settings.GaugeSettings[PropertyName.WindSpeed]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <GaugeSettings Property=@PropertyName.WindGust Configuration="@settings.GaugeSettings[PropertyName.WindGust]" DuplicateOrders="@GetDuplicateDisplayOrders()" />
                                <div style="margin-top:12px;">
                                    <h4 style="color: cornflowerblue;">Notes</h4>
                                    <ul>
                                        <li>Display Order controls the order of gauges on the Display page. Set to zero to omit a gauge from the display (flagged red).Duplicate order values are flagged orange. </li>
                                        <li>Change values in the correct order - they are constrained to follow the relationship: Minimum &lt;= Green-Orange-Transition &lt;= Orange-Red-Transition &lt;= Maximum</li>
                                        <li>All gauges have units that increase clockwise from minimum at left to maximum at right. The wind direction compass cannot be configured.</li>
                                        <li>When the green-orange transition value is less than the orange-red transition value, the clockwise segment colour order is green => orange => red.</li>
                                        <li>When the green-orange transition value is greater than the orange-red transition value, the clockwise segment colour order is red => orange => green.</li>
                                        <li>To create an all-green gauge, set both transition values to the maximum value.</li>
                                    </ul>
                                </div>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Security">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px;">
                                <h4 style="color:cornflowerblue;">@Globals.APPLICATION_NAME Security</h4>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Require administrator login:</label>
                                    <input style="margin-left:12px;" type="checkbox" @bind="RequireAdministratorLogin" />
                                    <span style="margin-left:12px;">(Requires restart)</span>
                                    <p style="margin-top:12px; margin-bottom:0px; font-style:italic;">When enabling security for the first time, set the password through the Administrator logon dialogue.</p>
                                </div>
                            </RadzenCard>

                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color:cornflowerblue;">Composite Device API Security</h4>
                                <div style="margin-bottom: 12px; margin-top: 12px">
                                    <label>Require Credentials (Basic Auth):</label>
                                    <input type="checkbox" @bind="SrvRequireAuthorization" />
                                </div>
                                <div style="margin-bottom: 12px">
                                    <label>User Name:</label>
                                    <input type="text" @bind="_srvUserNameInput" @bind:event="oninput" @onkeydown="CommitUserNameOnEnter" style="width:21ch;margin-left:72px;" disabled="@SrvDisableAuth" />
                                </div>
                                <div style="margin-bottom: 12px">
                                    <label>Password:</label>
                                    <input type="password" @bind="_srvPassword" @bind:event="oninput" @onkeydown="CommitPasswordOnEnter" style="width:21ch;margin-left:84px;" disabled="@SrvDisableAuth" />
                                </div>
                                <div style="margin-bottom: 12px">
                                    <label>Repeat:</label>
                                    <input type="password" @bind="_srvPassword2" @bind:event="oninput" @onkeydown="CommitPasswordOnEnter" style="width:21ch;margin-left:102px;" disabled="@SrvDisableAuth" />
                                </div>

                                <div style="margin-bottom:0px;margin-top:12px;">
                                    <RadzenButton Click="TrySavePassword" Text="Change Password" ButtonStyle="ButtonStyle.Primary"
                                                  Style="border-radius:20px; text-transform:none;" />
                                </div>
        
                                @if (!string.IsNullOrEmpty(_srvPasswordStatus))
                                {
                                    <p style="margin-top:12px; color: @PasswordStatusColor">@_srvPasswordStatus</p>
                                }
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Bound Addresses">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color:cornflowerblue;margin-bottom:12px;">Network addresses on which the server is listening</h4>
                                <table>
                                    @if (settings.BindToAllNetworkAddresses)
                                    {
                                        try
                                        {
                                            @foreach (var address in ASCOM.Alpaca.DiscoveryManager.AdapterAddress)
                                            {
                                                <tr>
                                                    <td>@address</td>
                                                </tr>
                                            }
                                        }
                                        catch
                                        {
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>localhost</td>
                                        </tr>
                                    }
                                </table>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>
            <div style="margin-top:18px;">
                <SentinelButton Click="@ResetSettings" Text="Reset To Defaults" Disabled="@(state.OperationUnderway)" />
            </div>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Device Selection">
            <RadzenTabs style="margin-top:12px" RenderMode="TabRenderMode.Server">
                <Tabs>
                    <RadzenTabsItem Text="Composite Observing Conditions Device">
                        <div class="row" style="margin-top: 0px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color: #479cc8; margin-bottom: 24px;">Select devices from the drop-downs to feed each property in the composite device.</h4>
                                <span style="display:inline-block; width:150px; text-align:left; margin:0"><b>Property</b></span>
                                <span style="display:inline-block; width:600px; text-align:center; margin:0"><b>Served from Device</b></span>

                                <DeviceSelection Property="PropertyName.CloudCover"
                                                 PropertyDescription="Cloud Cover"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.CloudCover)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.CloudCover]" />
                                <DeviceSelection Property="PropertyName.DewPoint"
                                                 PropertyDescription="Dew Point"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.DewPoint)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.DewPoint]" />
                                <DeviceSelection Property="PropertyName.Humidity"
                                                 PropertyDescription="Humidity"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.Humidity)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.Humidity]" />
                                <DeviceSelection Property="PropertyName.Pressure"
                                                 PropertyDescription="Pressure"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.Pressure)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.Pressure]" />
                                <DeviceSelection Property="PropertyName.RainRate"
                                                 PropertyDescription="Rain Rate"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.RainRate)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.RainRate]" />
                                <DeviceSelection Property="PropertyName.SkyBrightness"
                                                 PropertyDescription="Sky Brightness"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.SkyBrightness)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.SkyBrightness]" />
                                <DeviceSelection Property="PropertyName.SkyQuality"
                                                 PropertyDescription="Sky Quality"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.SkyQuality)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.SkyQuality]" />
                                <DeviceSelection Property="PropertyName.SkyTemperature"
                                                 PropertyDescription="Sky Temperature"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.SkyTemperature)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.SkyTemperature]" />
                                <DeviceSelection Property="PropertyName.StarFWHM"
                                                 PropertyDescription="Star FWHM"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.StarFWHM)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.StarFWHM]" />
                                <DeviceSelection Property="PropertyName.Temperature"
                                                 PropertyDescription="Temperature"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.Temperature)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.Temperature]" />
                                <DeviceSelection Property="PropertyName.WindDirection"
                                                 PropertyDescription="Wind Direction"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.WindDirection)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.WindDirection]" />
                                <DeviceSelection Property="PropertyName.WindGust"
                                                 PropertyDescription="Wind Gust"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.WindGust)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.WindGust]" />
                                <DeviceSelection Property="PropertyName.WindSpeed"
                                                 PropertyDescription="Wind Speed"
                                                 DiscoveredDevices=@state.DiscoveredObservingConditionsDevices
                                                 OnDeviceChanged="(device) => OnObservingConditionsDeviceChanged(device, PropertyName.WindSpeed)"
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.WindSpeed]" />
                            </RadzenCard>
                        </div>
                        If a property shows as <span style="color:red;">@Globals.NOT_SET</span>, the composite device will return a not implemented error.
                        <div style="margin-top:16px;margin-bottom:0px;">
                            <span>Devices are colour coded as follows: </span>
                            <span style="color:dodgerblue;font-weight:bold;">Discovered Alpaca devices</span>
                            <span> - </span>
                            <span style="color:fuchsia;font-weight:bold;">Manually configured Alpaca devices</span>
                            <span> - </span>
                            <span style="color:lightseagreen;font-weight:bold;">COM devices</span>
                            <span> (Windows only).</span>
                        </div>

                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Composite Switch Device" Visible="false">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color: #479cc8; margin-bottom: 0;">Test Scope</h4>
                                <div>
                                    <p />
                                    <span>Alpaca devices are </span><span style="color:dodgerblue;font-weight:bold;">coloured blue</span><span>, COM devices are </span><span style="color:lightseagreen;font-weight:bold;">coloured green</span><span> (Windows only).</span>
                                    <p />
                                </div>
                            </RadzenCard>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Composite Safety Monitor Device">
                        <div class="row" style="margin-top: 12px">
                            <RadzenCard Style="margin-bottom: 20px; margin-right: 20px">
                                <h4 style="color: #479cc8; margin-bottom: 0;">Select safety monitor devices to be aggregated into the composite safety monitor IsSafe property.</h4>
                                <div style="margin-top:16px;margin-bottom:24px;">
                                    <span>Discovered Alpaca devices are </span>
                                    <span style="color:dodgerblue;font-weight:bold;">coloured blue</span><span>, manually configured Alpaca devices are </span>
                                    <span style="color:fuchsia;font-weight:bold;">coloured pink</span>
                                    <span>and COM devices are </span>
                                    <span style="color:lightseagreen;font-weight:bold;">coloured green</span>
                                    <span> (Windows only).</span>
                                </div>

                                <DeviceSelection Property="PropertyName.SafetyMonitor0"
                                                 PropertyDescription="Safety monitor 0"
                                                 DiscoveredDevices=@state.DiscoveredSafetyMonitorDevices
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor0]"
                                                 OnDeviceChanged="async (device) => await OnSafetyMonitorDeviceChanged(device, PropertyName.SafetyMonitor0)" />

                                <DeviceSelection Property="PropertyName.SafetyMonitor1"
                                                 PropertyDescription="Safety monitor 1"
                                                 DiscoveredDevices=@state.DiscoveredSafetyMonitorDevices
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor1]"
                                                 OnDeviceChanged="async (device) => await OnSafetyMonitorDeviceChanged(device, PropertyName.SafetyMonitor1)" />
                                <DeviceSelection Property="PropertyName.SafetyMonitor2"
                                                 PropertyDescription="Safety monitor 2"
                                                 DiscoveredDevices=@state.DiscoveredSafetyMonitorDevices
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor2]"
                                                 OnDeviceChanged="async (device) => await OnSafetyMonitorDeviceChanged(device, PropertyName.SafetyMonitor2)" />
                                <DeviceSelection Property="PropertyName.SafetyMonitor3"
                                                 PropertyDescription="Safety monitor 3"
                                                 DiscoveredDevices=@state.DiscoveredSafetyMonitorDevices
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor3]"
                                                 OnDeviceChanged="async (device) => await OnSafetyMonitorDeviceChanged(device, PropertyName.SafetyMonitor3)" />
                                <DeviceSelection Property="PropertyName.SafetyMonitor4"
                                                 PropertyDescription="Safety monitor 4"
                                                 DiscoveredDevices=@state.DiscoveredSafetyMonitorDevices
                                                 CurrentValue="settings.ConfiguredDevices[PropertyName.SafetyMonitor4]"
