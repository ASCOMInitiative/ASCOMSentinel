    #region Dispose pattern

    public async ValueTask DisposeAsync()
    {
        settings.ConfigurationChanged -= OnStateChanged;
        state.StateChanged -= OnStateChanged;

        if (discovery is not null)
        {
            discovery.DiscoveryCompleted -= AlpacaDiscoveryCompleted;
            discovery.Dispose();
            discovery = null;
        }

        if (objRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("window.unregisterSetupViewportChangeCallback"); // Optional: add unregister JS
            }
            catch { }

            try
            {
                objRef.Dispose();
            }
            catch { }
        }
    }

    #endregion

