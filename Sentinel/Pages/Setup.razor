@code {
    private string statusText = "";
    private AlpacaDiscovery? discovery;
    private DotNetObjectReference<Setup>? objRef;

    private int windowWidth { get; set; } = 1280;
    private List<AscomDevice> observingConditionsDevicesAlpaca { get; set; } = new();
    private List<AscomDevice> safetyMonitorDevicesAlpaca { get; set; } = new();
    private List<AscomDevice> switchDevicesAlpaca { get; set; } = new();

#if WINDOWS
    private List<ASCOM.Com.ASCOMRegistration> ObservingConditionsDevicesCom { get; set; } = new();
    private List<AscomDevice> SwitchDevicesCom { get; set; } = new();
    private List<ASCOM.Com.ASCOMRegistration> SafetyMonitorDevicesCom { get; set; } = new();
#endif

    private bool EnableRemoteClientsAtStartup
    {
        get
        {
            return settings.EnableRemoteClients;
        }
        set
        {
            settings.EnableRemoteClients = value;
            settings.Save();
        }
    }

    private async Task OnTabChanged()
    {
        statusText = string.Empty;
    }

    private async Task RespondOnlyOnLocalhostChanged(ChangeEventArgs e)
    {
        if (e.Value is null)
            return;

        DiscoveryResponseOnlyOnLocalHost = (bool)e.Value;
        statusText = $"{Globals.APPLICATION_NAME} must be re-started in order for this change to take effect.";
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!state.DiscoveryHasRun)
        {
            await StartDiscovery();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("window.registerSetupViewportChangeCallback", objRef);

            // Get the current window size and re-size to this
            int logWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            int logHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            await OnResizeSetup(logWidth, logHeight);

            settings.ConfigurationChanged += OnStateChanged;
            state.StateChanged += OnStateChanged;

        }
    }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChange(string value, string name)
    {
        SrvLocation = value;
    }

    private bool IncludeAlpacaTraceChanged
    {
        get
        {
            return settings.IncludeAlpacaTrace;
        }
        set
        {
            settings.IncludeAlpacaTrace = value;
            settings.Save();
        }
    }

    private async Task AlpacaGetPropertyTimeoutChanged(object args)
    {
        if (args == null)
            return;

        state.DisplayReconnectMessage = true;
        settings.AlpacaGetPropertyTimeout = (int)args;
        settings.Save();
    }

    private async Task DiscoveryDurationChanged(object args)
    {
        if (args == null)
            return;

        settings.AlpacaDiscoveryDuration = (double)args;
        settings.Save();
    }


    private async Task ServerPortChanged(object args)
    {
        if (args == null)
            return;

        settings.ServerPort = (ushort)args;
        settings.Save();
        statusText = $"{Globals.APPLICATION_NAME} must be re-started in order for this change to take effect.";
    }

    private async Task ResetSettings()
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to reset all settings? This cannot be undone."))
        {
            settings.ResetToDefaults();
            state.Connected = false;
            await StartDiscovery();
            await InvokeAsync(StateHasChanged);
        }
    }

    private LogLevel TraceLevel
    {
        get
        {
            return settings.LogLevel;
        }
        set
        {
            settings.LogLevel = value;
            settings.Save();
        }
    }

    private async Task OnObservingConditionsDeviceChanged(object discoveredDevice, PropertyName propertyName)
    {
        state.ShowResetMessage = true;

        if (((DiscoveredDevice)discoveredDevice).SentinelDeviceType == SentinelDeviceType.NotSet)
        {
            state.ObservingConditionsDeviceMap.Remove(propertyName);
            settings.RaiseChangeEvent();
        }

        await InvokeAsync(StateHasChanged);
    }
    private async Task OnSafetyMonitorDeviceChanged(DiscoveredDevice device, PropertyName propertyName)
    {
        settings.SafetyMonitorSettings[propertyName] = SafetyMonitorState.Enabled;
        settings.Save();

        state.ShowResetMessage = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartDiscovery()
    {
        try
        {

            state.OperationUnderway = true;
            discovery = new AlpacaDiscovery(Globals.ALPACA_SEARCH_STRICT_CASING, settings.IncludeAlpacaTrace ? logger : null, Globals.USER_AGENT_PRODUCT_NAME,
                (Assembly.GetExecutingAssembly().GetName().Version ?? new Version()).ToString()); // Create a discovery component with or without logging
            discovery.DiscoveryCompleted += AlpacaDiscoveryCompleted;
            discovery.StartDiscovery(1, 10, 32227, settings.AlpacaDiscoveryDuration, false, true, true, ASCOM.Common.Alpaca.ServiceType.Http);
            statusText = "Alpaca discovery underway";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogErrorConsole("StartDiscovery", $"Exception during discovery: {ex.Message}\r\n{ex}");
        }
    }

    private async void AlpacaDiscoveryCompleted(object? caller, EventArgs args)
    {
        try
        {

            observingConditionsDevicesAlpaca.Clear();
            switchDevicesAlpaca.Clear();
            safetyMonitorDevicesAlpaca.Clear();

#if WINDOWS
            ObservingConditionsDevicesCom.Clear();
            SwitchDevicesCom.Clear();
            SafetyMonitorDevicesCom.Clear();
#endif

            state.DiscoveredObservingConditionsDevices.Clear();
            state.DiscoveredSafetyMonitorDevices.Clear();

            state.DiscoveredObservingConditionsDevices.Add(new DiscoveredDevice());
            state.DiscoveredSafetyMonitorDevices.Add(new DiscoveredDevice());

            ArgumentNullException.ThrowIfNull(discovery, "Alpaca discovery component");
            observingConditionsDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.ObservingConditions);
            switchDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.Switch);
            safetyMonitorDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.SafetyMonitor);

#if WINDOWS
            foreach (ASCOM.Com.ASCOMRegistration driver in ASCOM.Com.Profile.GetDrivers(DeviceTypes.Switch))
            {
            }

            foreach (ASCOM.Com.ASCOMRegistration driver in ASCOM.Com.Profile.GetDrivers(DeviceTypes.ObservingConditions))
            {
                ObservingConditionsDevicesCom.Add(driver);
            }

            foreach (ASCOM.Com.ASCOMRegistration driver in ASCOM.Com.Profile.GetDrivers(DeviceTypes.SafetyMonitor))
            {
                SafetyMonitorDevicesCom.Add(driver);
            }
#endif

            // Add discovered Alpaca devices
            foreach (AscomDevice device in observingConditionsDevicesAlpaca)
            {
                // Exclude our observing conditions device from the list
                if (device.AscomDeviceName != Globals.OBSERVING_CONDITIONS_DEVICE_NAME)
                {
                    logger.LogDebugConsole("", $"DiscoveredDevices - Adding {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
                    state.DiscoveredObservingConditionsDevices.Add(new DiscoveredDevice
                    {
                        SentinelDeviceType = SentinelDeviceType.ObservingConditions,
                        Protocol = Protocol.Alpaca,
                        Name = device.AscomDeviceName,
                        IpAddress = device.IpAddress,
                        PortNumber = device.IpPort,
                        RemoteDeviceNumber = device.AlpacaDeviceNumber
                    });
                }
            }

#if WINDOWS
            foreach (ASCOM.Com.ASCOMRegistration device in ObservingConditionsDevicesCom)
            {
                // logger.LogDebug("", $"DiscoveredDevices - Adding {device.Name}, {device.ProgID} ");
                state.DiscoveredObservingConditionsDevices.Add(new DiscoveredDevice
                {
                    SentinelDeviceType = SentinelDeviceType.ObservingConditions,
                    Protocol = Protocol.COM,
                    Name = device.Name,
                    ComProgID = device.ProgID
                });
            }
#endif

            foreach (DiscoveredDevice device in state.DiscoveredObservingConditionsDevices)
            {
                if (device.SentinelDeviceType != SentinelDeviceType.NotSet)
                    logger.LogMessageConsole("", $"Discovered device: {device.SentinelDeviceType} {device.Name} ({device.Protocol} DisplayName: '{device.DisplayName}')");
            }

            // Add discovered Alpaca devices
            // logger.LogDebug("", $"GetDeviceNames - Found {safetyMonitorDevicesAlpaca.Count()} Alpaca safety monitor devices.");

            foreach (AscomDevice device in safetyMonitorDevicesAlpaca)
            {
                // Exclude our safety monitor device from the list
                if (device.AscomDeviceName != Globals.SAFETY_MONITOR_DEVICE_NAME)
                {
                    logger.LogDebugConsole("", $"DiscoveredDevices - Adding {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
                    state.DiscoveredSafetyMonitorDevices.Add(new DiscoveredDevice
                    {
                        Protocol = Protocol.Alpaca,
                        SentinelDeviceType = SentinelDeviceType.SafetyMonitor,
                        Name = device.AscomDeviceName,
                        IpAddress = device.IpAddress,
                        PortNumber = device.IpPort
                    });
                }
            }

#if WINDOWS
            foreach (ASCOM.Com.ASCOMRegistration device in SafetyMonitorDevicesCom)
            {
                logger.LogDebugConsole("", $"DiscoveredDevices - Adding {device.Name}, {device.ProgID} ");
                state.DiscoveredSafetyMonitorDevices.Add(new DiscoveredDevice
                {
                    Protocol = Protocol.COM,
                    SentinelDeviceType = SentinelDeviceType.SafetyMonitor,
                    Name = device.Name,
                    ComProgID = device.ProgID
                });
            }

#endif
            foreach (DiscoveredDevice device in state.DiscoveredSafetyMonitorDevices)
            {
                if (device.SentinelDeviceType != SentinelDeviceType.NotSet)
                    logger.LogMessageConsole("", $"Discovered device: {device.SentinelDeviceType} {device.Name} ({device.Protocol} DisplayName: '{device.DisplayName}')");
            }

            logger.LogMessageConsole("", $"Discovery complete.");

            statusText = "Discovery completed";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogErrorConsole("AlpacaDiscoveryCompleted", $"Exception: {ex.Message}\r\n{ex}");
        }
        finally
        {
            state.OperationUnderway = false;
            state.DiscoveryHasRun = true;
            await InvokeAsync(StateHasChanged);
            logger.LogDebugConsole("", $"Discovery underway is now false.");
        }
    }

    // This method will be called when the window resizes.
    // It is ONLY called when the user stops dragging the window's edge. (It is already throttled to protect your app from performance nightmares)
    [JSInvokable]
    public async Task OnResizeSetup(int width, int height)
    {
        try
        {
            // Calculate the number of rows that will fit in the available height
            int screenLogRows = Convert.ToInt32(height / 18.0) - 12;
            // logger.LogDebug("OnResizeSetup", $"Window size: {width} x {height}");
            windowWidth = width;
            state.WindowWidth = width;

            // Save the number of log lines so this can be restored across F5 refreshes and navigation. (Must be done before calling StateHasChanged)
            //state.LastNumberOfLogLines = screenLogRows;

            // Display the updated log on the screen - invoke required because this event handler method could be called by any thread
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogErrorConsole("OnResize", $"Exception: \r\n{ex}");
        }
    }

