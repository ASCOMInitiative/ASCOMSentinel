@code {
    private AlpacaDiscovery? discovery;
    private DotNetObjectReference<Setup>? objRef;

    private int windowWidth { get; set; } = 1280;
    private List<AscomDevice> observingConditionsDevicesAlpaca { get; set; } = new();
    private List<AscomDevice> safetyMonitorDevicesAlpaca { get; set; } = new();
    private List<AscomDevice> switchDevicesAlpaca { get; set; } = new();

    private string _srvUserNameInput = "";
    private string _srvPassword = string.Empty;
    private string _srvPassword2 = string.Empty;

#if WINDOWS
    private List<ASCOM.Com.ASCOMRegistration> ObservingConditionsDevicesCom { get; set; } = new();
    private List<AscomDevice> SwitchDevicesCom { get; set; } = new();
    private List<ASCOM.Com.ASCOMRegistration> SafetyMonitorDevicesCom { get; set; } = new();
#endif

    #region Lifecycle methods and event handlers

    protected override void OnInitialized()
    {
        _srvUserNameInput = settings.UserName;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("window.registerSetupViewportChangeCallback", objRef);

            // Get the current window size and re-size to this
            int logWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            int logHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            await OnResizeSetup(logWidth, logHeight);

            settings.ConfigurationChanged += OnStateChanged;
            state.StateChanged += OnStateChanged;

        }
    }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            logger.LogError("Setup.OnStateChanged", $"Exception: {ex.Message}");
        }
    }

    /// <summary>
    /// This method will be called when the window resizes.
    /// It is ONLY called when the user stops dragging the window's edge. (It is already throttled to protect your app from performance nightmares)
    /// </summary>
    /// <param name="width"></param>
    /// <param name="height"></param>
    /// <returns></returns>
    [JSInvokable]
    public async Task OnResizeSetup(int width, int height)
    {
        try
        {
            // Calculate the number of rows that will fit in the available height
            int screenLogRows = Convert.ToInt32(height / 18.0) - 12;
            windowWidth = width;

            // Display the updated log on the screen - invoke required because this event handler method could be called by any thread
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogError("OnResize", $"Exception: \r\n{ex}");
        }
    }

    private async Task OnTabChanged(int item)
    {
        state.StatusText = string.Empty;
        if ((!state.DiscoveryHasRun) && ((item == 1) || (item == 2)))
        {
            await StartDiscovery();
        }
    }

    #endregion

    #region Change handlers for settings changes

    private void OnLocationChange(string value, string name)
    {
        SrvLocation = value;
    }

    /// <summary>
    /// Returns the set of display order values that are shared by more than one gauge.
    /// </summary>
    private HashSet<int> GetDuplicateDisplayOrders()
    {
        return settings.GaugeSettings.Values
            .GroupBy(g => g.DisplayOrder)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key)
            .ToHashSet();
    }

    private async Task OnObservingConditionsDeviceChanged(object discoveredDevice, PropertyName propertyName)
    {
        state.DisplayReconnectMessage = true;

        if (((DiscoveredDevice)discoveredDevice).SentinelDeviceType == SentinelDeviceType.NotSet)
        {
            state.ObservingConditionsDeviceMap.TryRemove(propertyName, out _);
            settings.RaiseChangeEvent();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSafetyMonitorDeviceChanged(DiscoveredDevice device, PropertyName propertyName)
    {
        settings.SafetyMonitorSettings[propertyName] = SafetyMonitorState.Enabled;
        settings.Save();

        state.DisplayReconnectMessage = true;
        await InvokeAsync(StateHasChanged);
    }

    private bool StartBrowserOnLaunch
    {
        get => settings.StartBrowserOnLaunch;
        set { settings.StartBrowserOnLaunch = value; settings.Save(); }
    }

    private bool ConfirmOnline
    {
        get => settings.ConfirmOnline;
        set { settings.ConfirmOnline = value; settings.Save(); }
    }

    private bool ConfirmDisconnectDevices
    {
        get => settings.ConfirmDisconnectDevices;
        set { settings.ConfirmDisconnectDevices = value; settings.Save(); }
    }

    private async Task UncheckConfirmSettings()
    {
        settings.ConfirmDisconnectDevices = false;
        settings.ConfirmOnline = false;
        settings.Save();
    }

    private bool EnableRemoteClientsAtStartup
    {
        get
        {
            return settings.EnableRemoteClients;
        }
        set
        {
            settings.EnableRemoteClients = value;
            settings.Save();
        }
    }

    private async Task RespondOnlyOnLocalhostChanged(ChangeEventArgs e)
    {
        if (e.Value is null)
            return;

        DiscoveryResponseOnlyOnLocalHost = (bool)e.Value;
        state.StatusText = $"{Globals.APPLICATION_NAME} must be re-started in order for this change to take effect.";
        state.DisplayRestartMessage = true;
        await InvokeAsync(StateHasChanged);
    }

    private bool IncludeAlpacaTraceChanged
    {
        get
        {
            return settings.IncludeAlpacaTrace;
        }
        set
        {
            settings.IncludeAlpacaTrace = value;
            settings.Save();
            state.StatusText = $"{Globals.APPLICATION_NAME} must be re-connected in order for this change to take effect.";
            state.DisplayReconnectMessage = true;
        }
    }

    private bool LogSafetyWarnings
    {
        get
        {
            return settings.LogSafetyWarnings;
        }
        set
        {
            settings.LogSafetyWarnings = value;
            settings.Save();
        }
    }

    private bool LogDiscoveryMessages
    {
        get
        {
            return settings.LogDiscoveryMessages;
        }
        set
        {
            settings.LogDiscoveryMessages = value;
            settings.Save();
        }
    }

    private void PropertyCacheTimeChanged(object args)
    {
        if (args is null)
            return;

        double cacheTime = Convert.ToDouble(args);
        settings.PropertyCacheTime = TimeSpan.FromSeconds(cacheTime);
        settings.Save();
    }

    private async Task AlpacaGetPropertyTimeoutChanged(object args)
    {
        if (args == null)
            return;

        state.DisplayReconnectMessage = true;
        settings.AlpacaGetPropertyTimeout = (int)args;
        settings.Save();
    }

    private async Task DiscoveryDurationChanged(object args)
    {
        if (args == null)
            return;

        settings.AlpacaDiscoveryDuration = (double)args;
        settings.Save();
    }

    private async Task ServerPortChanged(object args)
    {
        if (args == null)
            return;

        settings.ServerPort = (ushort)args;
        settings.Save();
        state.StatusText = $"{Globals.APPLICATION_NAME} must be re-started in order for this change to take effect.";
        state.DisplayRestartMessage = true;
    }

    private async Task ResetSettings()
    {
        bool? confirmed;
        confirmed = await DialogService.Confirm(
        "Are you sure you want to reset all settings? This cannot be undone.",
        "Confirm Reset",
        new ConfirmOptions { OkButtonText = "Reset", CancelButtonText = "Cancel" });

        if (confirmed.HasValue && confirmed.Value)
        {
            settings.ResetToDefaults();
            state.ResetState();
            await InvokeAsync(StateHasChanged);
            await StartDiscovery();
        }
    }

    private async void TraceLevelChanged(object value)
    {
        if (value is null)
            return;

        LogLevel logLevel = (LogLevel)value;
        settings.LogLevel = logLevel;

        if (logLevel <= LogLevel.Information)
            settings.IncludeAlpacaTrace = false;

        settings.Save();
        logger.SetMinimumLoggingLevel(logLevel);

        state.StatusText = $"{Globals.APPLICATION_NAME} must be re-connected in order for this change to take effect.";
        state.DisplayReconnectMessage = true;
    }

    private LogLevel TraceLevel
    {
        get
        {
            return settings.LogLevel;
        }
        set
        {
            settings.LogLevel = value;
            settings.Save();
            logger.SetMinimumLoggingLevel(value);
        }
    }

    #endregion

    #region Alpaca discovery

    private async Task StartDiscovery()
    {
        try
        {

            state.OperationUnderway = true;
            await InvokeAsync(StateHasChanged);

            // Dispose the previous discovery instance to release sockets/timers
            if (discovery is not null)
            {
                discovery.DiscoveryCompleted -= AlpacaDiscoveryCompleted;
                discovery.Dispose();
            }

            discovery = new AlpacaDiscovery(Globals.ALPACA_SEARCH_STRICT_CASING, settings.IncludeAlpacaTrace ? logger : null, Globals.USER_AGENT_PRODUCT_NAME,
                (Assembly.GetExecutingAssembly().GetName().Version ?? new Version()).ToString()); // Create a discovery component with or without logging
            discovery.DiscoveryCompleted += AlpacaDiscoveryCompleted;
            discovery.StartDiscovery(1, 10, 32227, settings.AlpacaDiscoveryDuration, false, true, true, ASCOM.Common.Alpaca.ServiceType.Http);
            state.StatusText = "Alpaca discovery underway";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogError("StartDiscovery", $"Exception during discovery: {ex.Message}\r\n{ex}");
        }
    }

    private async void AlpacaDiscoveryCompleted(object? caller, EventArgs args)
    {
        try
        {

            observingConditionsDevicesAlpaca.Clear();
            switchDevicesAlpaca.Clear();
            safetyMonitorDevicesAlpaca.Clear();

#if WINDOWS
    ObservingConditionsDevicesCom.Clear();
    SwitchDevicesCom.Clear();
    SafetyMonitorDevicesCom.Clear();
#endif

            // Lock the discovered device lists while repopulating them
            lock (state.DiscoveredDevicesLock)
            {
                // Clear the discovered devices lists
                state.DiscoveredObservingConditionsDevices.Clear();
                state.DiscoveredSafetyMonitorDevices.Clear();

                // Add not configured and manual configuration observing conditions list entries.
                state.DiscoveredObservingConditionsDevices.Add(new DiscoveredDevice()); // Not configured entry
                state.DiscoveredObservingConditionsDevices.Add(new DiscoveredDevice() { SentinelDeviceType = SentinelDeviceType.ManualObservingConditions }); // Manually configured device entry

                // Add all manually configured observing conditions devices to the list
                List<DiscoveredDevice> uniqueObservingConditionsDevices = settings.ConfiguredDevices.Values
                    .Where(d => (d.SentinelDeviceType == SentinelDeviceType.ObservingConditions) || (d.SentinelDeviceType == SentinelDeviceType.ManualObservingConditions))
                    .DistinctBy(d => (d.DisplayName, d.SentinelDeviceType, d.ComProgID, d.IpAddress, d.PortNumber, d.RemoteDeviceNumber)).ToList();

                state.DiscoveredObservingConditionsDevices.AddRange(uniqueObservingConditionsDevices);

                // Add not configured and manual configuration safety monitor list entries.
                state.DiscoveredSafetyMonitorDevices.Add(new DiscoveredDevice());
                state.DiscoveredSafetyMonitorDevices.Add(new DiscoveredDevice() { SentinelDeviceType = SentinelDeviceType.ManualSafetyMonitor });

                // Add all manually configured safety monitor devices to the list
                foreach (PropertyName propertyName in Globals.SafetyMonitorNames)
                {
                    // Only include manual configured devices that have actually been configured
                    if ((settings.ConfiguredDevices[propertyName].Protocol != Protocol.NotConfigured) && (settings.ConfiguredDevices[propertyName].SentinelDeviceType == SentinelDeviceType.ManualSafetyMonitor))
                    {
                        state.DiscoveredSafetyMonitorDevices.Add(settings.ConfiguredDevices[propertyName]);
                    }
                }

                ArgumentNullException.ThrowIfNull(discovery, "Alpaca discovery component");
                observingConditionsDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.ObservingConditions);
                switchDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.Switch);
                safetyMonitorDevicesAlpaca = discovery.GetAscomDevices(DeviceTypes.SafetyMonitor);

#if WINDOWS
    foreach (ASCOM.Com.ASCOMRegistration driver in ASCOM.Com.Profile.GetDrivers(DeviceTypes.Switch))
    {
    }

    foreach (ASCOM.Com.ASCOMRegistration driver in ASCOM.Com.Profile.GetDrivers(DeviceTypes.ObservingConditions))
    {
    ObservingConditionsDevicesCom.Add(driver);
    }

    foreach (ASCOM.Com.ASCOMRegistration driver in ASCOM.Com.Profile.GetDrivers(DeviceTypes.SafetyMonitor))
    {
    SafetyMonitorDevicesCom.Add(driver);
    }
#endif

                // Add discovered observing conditions Alpaca devices
                foreach (AscomDevice device in observingConditionsDevicesAlpaca)
                {
                    // Exclude our observing conditions device from the list
                    if (device.UniqueId != settings.UniqueIdObservingConditions)
                    {
                        logger.LogDebug("", $"DiscoveredDevices - Adding {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
                        state.DiscoveredObservingConditionsDevices.Add(new DiscoveredDevice
                        {
                            SentinelDeviceType = SentinelDeviceType.ObservingConditions,
                            Protocol = Protocol.Alpaca,
                            Name = device.AscomDeviceName,
                            IpAddress = device.IpAddress,
                            PortNumber = device.IpPort,
                            RemoteDeviceNumber = device.AlpacaDeviceNumber
                        });
                    }
                }

#if WINDOWS
    foreach (ASCOM.Com.ASCOMRegistration device in ObservingConditionsDevicesCom)
    {
    state.DiscoveredObservingConditionsDevices.Add(new DiscoveredDevice
    {
    SentinelDeviceType = SentinelDeviceType.ObservingConditions,
    Protocol = Protocol.COM,
    Name = device.Name,
    ComProgID = device.ProgID
    });
    }
#endif

                foreach (DiscoveredDevice device in state.DiscoveredObservingConditionsDevices)
                {
                    if (device.SentinelDeviceType != SentinelDeviceType.NotSet)
                        logger.LogMessage("", $"Discovered device: {device.SentinelDeviceType} {device.Name} ({device.Protocol} DisplayName: '{device.DisplayName}')");
                }

                // Add discovered safety monitor Alpaca devices
                foreach (AscomDevice device in safetyMonitorDevicesAlpaca)
                {
                    // Exclude our safety monitor device from the list
                    if (device.UniqueId != settings.UniqueIdSafetyMonitor)
                    {
                        logger.LogDebug("", $"DiscoveredDevices - Adding {device.AscomDeviceType}, {device.AscomDeviceName} {device.HostName}");
                        state.DiscoveredSafetyMonitorDevices.Add(new DiscoveredDevice
                        {
                            Protocol = Protocol.Alpaca,
                            SentinelDeviceType = SentinelDeviceType.SafetyMonitor,
                            Name = device.AscomDeviceName,
                            IpAddress = device.IpAddress,
                            PortNumber = device.IpPort
                        });
                    }
                }

#if WINDOWS
    foreach (ASCOM.Com.ASCOMRegistration device in SafetyMonitorDevicesCom)
    {
    logger.LogDebug("", $"DiscoveredDevices - Adding {device.Name}, {device.ProgID} ");
    state.DiscoveredSafetyMonitorDevices.Add(new DiscoveredDevice
    {
    Protocol = Protocol.COM,
    SentinelDeviceType = SentinelDeviceType.SafetyMonitor,
    Name = device.Name,
    ComProgID = device.ProgID
    });
    }

#endif
                foreach (DiscoveredDevice device in state.DiscoveredSafetyMonitorDevices)
                {
                    if (device.SentinelDeviceType != SentinelDeviceType.NotSet)
                        logger.LogMessage("", $"Discovered device: {device.SentinelDeviceType} {device.Name} ({device.Protocol} DisplayName: '{device.DisplayName}')");
                }

                logger.LogMessage("", $"Discovery complete.");

                // Sort all devices into order
                State.SortDiscoveredDevices(state, SortByDevice.All);
            }

            state.StatusText = "Discovery completed";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogError("AlpacaDiscoveryCompleted", $"Exception: {ex.Message}\r\n{ex}");
        }
        finally
        {
            state.OperationUnderway = false;
            state.DiscoveryHasRun = true;
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { }
            logger.LogDebug("", $"Discovery underway is now false.");
        }
    }

