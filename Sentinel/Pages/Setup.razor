    private string _srvPassword = string.Empty;
    private string SrvPassword
    {
        get => _srvPassword;
        set { _srvPassword = value; TrySavePassword(); }
    }

    private string _srvPassword2 = string.Empty;
    private string SrvPassword2
    {
        get => _srvPassword2;
        set { _srvPassword2 = value; TrySavePassword(); }
    }

    private string _srvPasswordStatus = string.Empty;

    private string PasswordStatusColor => _srvPasswordStatus.Contains("not match") ? "red" : "green";

    private void TrySavePassword()
    {
        if (!SrvRequireAuthorization || string.IsNullOrEmpty(_srvPassword) || string.IsNullOrEmpty(_srvPassword2))
        {
            _srvPasswordStatus = string.Empty;
            return;
        }

        if (_srvPassword == _srvPassword2)
        {
            settings.Password = Hash.GetStoragePassword(_srvPassword);
            settings.Save();
            _srvPasswordStatus = "Password saved.";
        }
        else
        {
            _srvPasswordStatus = "Passwords do not match.";
        }
    }

    private bool AutoConnect
    {
        get => settings.AutoConnect;
        set { settings.AutoConnect = value; settings.Save(); }
    }

    private LogLevel SrvLoggingLevel
    {
        get => settings.LogLevel;
        set
        {
            settings.LogLevel = value;
            settings.Save();
            Program.logger?.SetMinimumLoggingLevel(value);
        }
    }

    private bool SrvEnableShutdown { get; set; } = false;
    private bool SrvAllowShutdown => !SrvEnableShutdown;

    private void SrvShutdown()
    {
        Program.Lifetime?.StopApplication();
    }

