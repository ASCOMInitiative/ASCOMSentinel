@using Microsoft.AspNetCore.Components.Web
@namespace Sentinel.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="sentinel.styles.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    @RenderBody()

    <!-- 
        Suppress Blazor's built-in reconnect modal by providing our own hidden element.
        When Blazor finds this div already in the DOM it uses it instead of injecting its own. Blazor still adds CSS classes to it (components-reconnect-show etc.) which the MutationObserver below uses as the trigger.
     -->
    <div id="components-reconnect-modal" style="display:none!important"></div>

    <!-- Shown when the server connection is lost -->
    <div id="server-stopped-overlay"
         style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
                background:rgba(0,0,0,0.75); z-index:9999;">
        <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
                    background:#2a2a4e; color:#eee; font-family:sans-serif; border-radius:8px;
                    padding:2rem 2.5rem; max-width:550px; width:90%; text-align:center;
                    box-shadow:0 4px 24px rgba(0,0,0,0.6);">
            <h2 style="margin:0 0 0.75rem;">The @Globals.APPLICATION_NAME Server has stopped</h2>
            <p id="countdown-message" style="color:#bbb; margin:0 0 0.5rem;">
                This window will attempt to close in <span id="countdown-seconds"
                    style="font-size:1.4rem; font-weight:bold; color:#fff;">5</span> seconds.
            </p>
        </div>
    </div>

    <script autostart="false" src="_framework/blazor.server.js"></script>
    <script>
        var serverStopped = false;
        var countdownInterval = null;

        // Random delay (0–5 seconds) unique to this tab, used to stagger re-connections after a server restart so that N browsers don't all hit the server at once.
        var reconnectJitterMs = Math.floor(Math.random() * 5000);

        function handleServerStopped() {
            if (serverStopped) return;
            serverStopped = true;

            var overlay = document.getElementById('server-stopped-overlay');
            if (overlay) overlay.style.display = 'block';

            var seconds = 5;
            countdownInterval = setInterval(function () {
                seconds--;
                var counter = document.getElementById('countdown-seconds');
                if (counter) counter.textContent = seconds;

                if (seconds <= 0) {
                    clearInterval(countdownInterval);

                    // Attempt to close — succeeds in Chromium when the tab was opened programmatically
                    window.open('', '_self', '');
                    window.close();

                    // If window.close() was blocked by the browser, replace the countdown text
                    document.getElementById('countdown-message').textContent = 'Unable to close automatically, please close this window manually.';
                }
            }, 1000);
        }

        // MutationObserver watches for Blazor adding CSS classes to the reconnect modal.
        // The custom reconnectionHandler retries with a random 5–10s interval and updates these classes based on the outcome:
        //   'components-reconnect-show'     — reconnection in progress (ignore, let it retry)
        //   'components-reconnect-rejected' — server alive but circuit expired (reload for fresh circuit)
        //   'components-reconnect-failed'   — server unreachable (show server-stopped overlay)
        var reconnectModal = document.getElementById('components-reconnect-modal');
        if (reconnectModal) {
            new MutationObserver(function (mutations) {
                for (var i = 0; i < mutations.length; i++) {
                    if (mutations[i].attributeName === 'class') {
                        var cls = reconnectModal.className;
                        if (cls.indexOf('components-reconnect-rejected') >= 0) {
                            // Server is running but the circuit was discarded. Stagger the reload with a random delay so N tabs don't all create new circuits at the same instant.
                            setTimeout(function () { window.location.reload(); }, reconnectJitterMs);
                        } else if (cls.indexOf('components-reconnect-failed') >= 0) {
                            // Server is unreachable — show the stopped overlay
                            handleServerStopped();
                        }
                    }
                }
            }).observe(reconnectModal, { attributes: true });
        }

        // Returns a random delay between 5 and 10 seconds (in ms)
        function randomRetryDelayMs() {
            return 5000 + Math.floor(Math.random() * 5000);
        }

        // Custom reconnection handler: retries with a random 5–10 second interval instead of the default exponential back-off. Each retry uses a fresh random delay, which also naturally staggers reconnection attempts across multiple tabs.
        var maxRetries = 20;

        function startReconnectLoop(reconnectCallback) {
            var attempt = 0;
            function tryReconnect() {
                attempt++;
                if (attempt > maxRetries) {
                    // Exhausted retries — let the MutationObserver handle the failed state
                    return;
                }
                var delayMs = randomRetryDelayMs();
                setTimeout(function () {
                    reconnectCallback().then(function (success) {
                        if (!success) {
                            // When using a custom onConnectionDown handler Blazor does not update the
                            // components-reconnect-* CSS classes, so the MutationObserver-based reload
                            // path is never triggered. Instead, probe the server directly: if it
                            // responds the circuit is gone (server restarted) and a fresh page load is
                            // needed; if it doesn't respond the server is still down so retry.
                            fetch(window.location.href, { method: 'HEAD', cache: 'no-store' })
                                .then(function () {
                                    // Server is reachable — old circuit is gone, reload for a fresh one.
                                    setTimeout(function () { window.location.reload(); }, reconnectJitterMs);
                                })
                                .catch(function () {
                                    // Server still unreachable — schedule another attempt.
                                    tryReconnect();
                                });
                        }
                        // If success, Blazor handles the rest
                    }).catch(function () {
                        // reconnect() itself threw — treat as unreachable and retry.
                        tryReconnect();
                    });
                }, delayMs);
            }
            tryReconnect();
        }

        // Start Blazor after a small random delay so that when the page is first loaded (e.g. after a server restart causes all tabs to reload), the SignalR connections are spread over a few seconds rather than arriving simultaneously.
        setTimeout(function () {
            Blazor.start({
                circuit: {
                    configureSignalR: function (builder) {
                        builder.withServerTimeout(@(Globals.SIGNALR_SERVER_TIMEOUT * 1000));
                        builder.withKeepAliveInterval(@(Globals.SIGNALR_KEEP_ALIVE_INTERVAL * 1000));
                    },
                    reconnectionHandler: {
                        onConnectionDown: function (options, error) {
                            startReconnectLoop(options.reconnect);
                        },
                        onConnectionUp: function () {
                            // Connection restored — if the stopped overlay was shown, reload to get a clean state
                            if (serverStopped) {
                                window.location.reload();
                            }
                        }
                    }
                }
            });
        }, reconnectJitterMs);
    </script>
</body>
</html>
