@page "/"
@inject State state;
@inject SentinelLogger logger;
@inject IJSRuntime JSRuntime
@inject Settings settings
@inject PerBrowserState circuitState

@implements IAsyncDisposable

<h1>@Globals.APPLICATION_NAME</h1>
<div>
    @settings.Status
    <p />
</div>

<div style="height:100%;min-height:100%;">
    <RadzenTextArea Id="SentinelLog"
                    Style='font-family: "Lucida Console", "Courier New", monospace; font-size: 14px; line-height: 18px; padding-bottom: 0px; width:100%;'
                    Name="SentinelLog"
                    @bind-Value=@ApplicationLog
                    Rows="@LastnumberOfLogLines()"
                    Cols="250" ReadOnly=true />
</div>

@code
{
    private bool _disposed = false;
    private bool _logContentChanged = false;
    private int _lastLogLength;
    private string _cachedLogText = "";
    private readonly CancellationTokenSource _cts = new();
    private DotNetObjectReference<Index>? objRef;

    protected override void OnInitialized()
    {
        // Snapshot the log before the first render so the initial display isn't empty
        lock (Globals.writeLogLock)
        {
            _cachedLogText = state.ApplicationLog.ToString();
        }
        _lastLogLength = state.ApplicationLog.Length;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            settings.ConfigurationChanged += OnStateChanged;

            // Subscribe to the OnResized event. This will do work when the browser is resized.
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("window.registerIndexViewportChangeCallback", objRef);

            // Get the current window size and re-size to this
            int logWidth = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            int logHeight = await JSRuntime.InvokeAsync<int>("eval", "window.innerHeight");
            await OnResizeIndex(logWidth, logHeight);

            logger.BlankLine();

            // Connect to devices if required
            if (settings.AutoConnect && !state.Connected)
                await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));

            // Scroll to show latest content after initial render
            circuitState.TopOfVisibleLog = await JSRuntime.InvokeAsync<int>("ScrollToBottom", "SentinelLog");

            // Start a timer-based log refresh instead of subscribing to every log message. This caps the cost at 1 render + 1 JS call per interval per tab, regardless of how many log messages arrive or how many tabs are open.
            _ = LogRefreshLoopAsync(_cts.Token);

            // Record that the UI is ready. This allows the navigation menu to enable its buttons.
            state.UiReady = true;
        }

        // Scroll to bottom after a render that was triggered by new log content
        if (_logContentChanged)
        {
            _logContentChanged = false;
            circuitState.TopOfVisibleLog = await JSRuntime.InvokeAsync<int>("ScrollToBottom", "SentinelLog");
        }
    }

    /// <summary>
    /// Timed loop that checks for new log content and triggers a UI update when it arrives. 
    /// This is more efficient than triggering an update for every log message, and allows the UI to batch multiple log messages into a single update when they arrive in bursts.
    /// </summary>
    /// <param name="token"></param>
    /// <returns></returns>
    private async Task LogRefreshLoopAsync(CancellationToken token)
    {
        try
        {
            // Loop until the component is disposed. The loop body is wrapped in a try/catch that will exit silently when the cancellation token is triggered, which happens in DisposeAsync.
            while (!token.IsCancellationRequested)
            {
                // Wait for the next interval. 
                await Task.Delay(500, token);

                // Check for new log content. If the log length has changed since the last check, update the cached log text and trigger a UI update.
                int currentLength = state.ApplicationLog.Length;
                if (currentLength != _lastLogLength)
                {
                    _lastLogLength = currentLength;
                    lock (Globals.writeLogLock)
                    {
                        _cachedLogText = state.ApplicationLog.ToString();
                    }
                    _logContentChanged = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private int LastnumberOfLogLines()
    {
        return circuitState.LastNumberOfLogLines == 0 ? 20 : circuitState.LastNumberOfLogLines;
    }

    private string ApplicationLog
    {
        get => _cachedLogText;
        set
        {
            // Do nothing - required for two-way binding
        }
    }

    /// <summary>
    /// Event handler for state changes. This method is called when the state changes and triggers a UI update.
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>
    private async void OnStateChanged(object? sender, EventArgs e)
    {
        if (_disposed)
            return;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex) { LogConsole(ex.Message); }
    }

    #region Log resize support

    /// <summary>
    /// Logs a message to the console with a timestamp and a specific color. Used to record exceptions that occur during the resize event handler.
    /// </summary>
    /// <param name="message"></param>
    private void LogConsole(string message)
    {
        lock (Globals.writeLogLock)
        {
            Console.Write(DateTime.Now.ToString("HH:mm:ss.fff"));
            Console.ForegroundColor = ConsoleColor.DarkCyan;
            Console.WriteLine(message);
            Console.ResetColor();
        }
    }

    // This method will be called when the window resizes.
    // It is ONLY called when the user stops dragging the window's edge. (It is already throttled to protect your app from performance nightmares)
    [JSInvokable]
    public async Task OnResizeIndex(int width, int height)
    {
        try
        {
            // Calculate the number of rows that will fit in the available height
            int screenLogRows = Convert.ToInt32(height / 18.0) - 12;

            // Save the number of log lines so this can be restored across F5 refreshes and navigation. (Must be done before calling StateHasChanged)
            circuitState.LastNumberOfLogLines = screenLogRows;

            // Display the updated log on the screen - invoke required because this event handler method could be called by any thread
            await InvokeAsync(StateHasChanged);

            // Scroll to the bottom of the window and return the current window 'top' value.
            // Save the current top so that the scroll position can be restored after a browser page refresh or navigation to a different page.
            circuitState.TopOfVisibleLog = await JSRuntime.InvokeAsync<int>("ScrollToBottom", "SentinelLog");
        }
        catch (Exception ex)
        {
            logger.LogError("OnResize", $"Exception - {ex.Message}\r\n{ex}");
        }
    }

    #endregion

    #region Dispose pattern

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
        settings.ConfigurationChanged -= OnStateChanged;

        if (objRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("window.unregisterIndexViewportChangeCallback");
            }
            catch { }
            objRef.Dispose();
        }
    }

    #endregion
}
