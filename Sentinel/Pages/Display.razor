@page "/display"

@inject IJSRuntime JSRuntime

@using ASCOM.Alpaca
@using Sentinel.Components
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;
@using Sentinel.DeviceAccess

@inject State state

<PageTitle>@Globals.APPLICATION_NAME Log</PageTitle>

<h1>@Globals.APPLICATION_NAME</h1>

<RadzenMediaQuery Query="(max-width: 1330px)" Change=@(matches => WindowWidthChanged(WindowSize.Dials2, matches)) />
<RadzenMediaQuery Query="(min-width: 1331px) and (max-width: 1650px)" Change=@(matches => WindowWidthChanged(WindowSize.Dials3, matches)) />
<RadzenMediaQuery Query="(min-width: 1651px) and (max-width: 1975px)" Change=@(matches => WindowWidthChanged(WindowSize.Dials4, matches)) />
<RadzenMediaQuery Query="(min-width: 1976px) and (max-width: 2300px)" Change=@(matches => WindowWidthChanged(WindowSize.Dials5, matches)) />
<RadzenMediaQuery Query="(min-width: 2301px)" Change=@(matches => WindowWidthChanged(WindowSize.Dials6, matches)) />

<div>
    <Gauge Legend="Wind Speed (mi/h)" MinValue="0" MaxValue="20" OrangeGreenTransition="5" RedOrangeTransition="15" Value=@state.ObservingConditions.WindSpeed />
    <Gauge Legend="Wind Gust (mi/h)" MinValue="0" MaxValue="100" OrangeGreenTransition="100" RedOrangeTransition="100" Value=@state.ObservingConditions.WindGust />
    @if (currentWindowSize == WindowSize.Dials2)
    {
        <br />
    }
    <Compass Value="137.0" />
    @if (currentWindowSize == WindowSize.Dials3)
    {
        <br />
    }
    <Gauge Legend="Rain Rate (mm/h)" MinValue="0" MaxValue="50" OrangeGreenTransition="1" RedOrangeTransition="5" Value=@state.ObservingConditions.RainRate />
    @if ((currentWindowSize == WindowSize.Dials2) | (currentWindowSize == WindowSize.Dials4))
    {
        <br />
    }
    <Gauge Legend="Sky Brightness (Lux)" MinValue="0" MaxValue="100" OrangeGreenTransition="1" RedOrangeTransition="10" Value=@state.ObservingConditions.SkyBrightness />
    @if (currentWindowSize == WindowSize.Dials5)
    {
        <br />
    }
    <Gauge Legend="Sky Quality (mag/arcsec2)" MinValue="10" MaxValue="25" OrangeGreenTransition="21.3" RedOrangeTransition="19" Value=@state.ObservingConditions.SkyQuality Reverse=true />
    @if ((currentWindowSize == WindowSize.Dials2) | (currentWindowSize == WindowSize.Dials3) | (currentWindowSize == WindowSize.Dials6))
    {
        <br />
    }
    <Gauge Legend="FWHM (arc-sec)" MinValue="0" MaxValue="5" OrangeGreenTransition="1" RedOrangeTransition="2" Value=@state.ObservingConditions.StarFWHM />
    <Gauge Legend="Sky Temperature (C)" MinValue="-70" MaxValue="20" OrangeGreenTransition="-20" RedOrangeTransition="0" Value=@state.ObservingConditions.SkyTemperature />
    @if ((currentWindowSize == WindowSize.Dials2) | (currentWindowSize == WindowSize.Dials4))
    {
        <br />
    }
    <Gauge Legend="Dew Point (C)" MinValue="-30" MaxValue="25" OrangeGreenTransition="5" RedOrangeTransition="15" Value=@state.ObservingConditions.DewPoint />
    @if (currentWindowSize == WindowSize.Dials3)
    {
        <br />
    }
    <Gauge Legend="Pressure (hPa)" MinValue="950" MaxValue="1050" OrangeGreenTransition="1060" RedOrangeTransition="1060" Value=@state.ObservingConditions.Pressure />
    @if (currentWindowSize == WindowSize.Dials5)
    {
        <br />
    }
    <Gauge Legend="Temperature (C)" MinValue="-50.0" MaxValue="50.0" OrangeGreenTransition="10.0" RedOrangeTransition="25.0" Value=@state.ObservingConditions.Temperature />
    <Gauge Legend="Humidity (%)" MinValue="0" MaxValue="100" OrangeGreenTransition="100" RedOrangeTransition="100" Value=@state.ObservingConditions.Humidity />
</div>

@code {

    protected override async Task OnInitializedAsync()
    {
        Task refreshTask= Task.Run(async () =>
        {
            while (true)
            {
                await InvokeAsync(() => StateHasChanged());
                await Task.Delay(1000);
            }
        });



    }


    #region Windows Size

    enum WindowSize
    {
        Dials2,
        Dials3,
        Dials4,
        Dials5,
        Dials6
    }

    WindowSize currentWindowSize = WindowSize.Dials6;

    void WindowWidthChanged(WindowSize windowSize, bool matches)
    {
        if (matches)
        {
            currentWindowSize = windowSize;
            StateHasChanged();
        }
        else
        {
        }
    }

    #endregion

}
