@page "/display"

@inject IJSRuntime JSRuntime

@using ASCOM.Alpaca
@using Sentinel.Components
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;
@using Sentinel.DeviceAccess

@inject State state
@inject SentinelLogger logger

@implements IDisposable

<PageTitle>@Globals.APPLICATION_NAME Log</PageTitle>

<h1>@Globals.APPLICATION_NAME</h1>

<div style="display: flex; flex-wrap: wrap;">
    <Gauge Legend="Wind Speed (mi/h)" MinValue="0" MaxValue="20" OrangeGreenTransition="5" RedOrangeTransition="15" Value=@GetDoubleValue(PropertyName.WindSpeed, 20.0) />
    <Gauge Legend="Wind Gust (mi/h)" MinValue="0" MaxValue="100" OrangeGreenTransition="100" RedOrangeTransition="100" Value=@GetDoubleValue(PropertyName.WindGust, 100.0) />
    <Compass Value=@GetDoubleValue(PropertyName.WindDirection, 0.0) />
    <Gauge Legend="Rain Rate (mm/h)" MinValue="0" MaxValue="50" OrangeGreenTransition="1" RedOrangeTransition="5" Value=@GetDoubleValue(PropertyName.RainRate, 50.0) />
    <Gauge Legend="Sky Brightness (Lux)" MinValue="0" MaxValue="100" OrangeGreenTransition="1" RedOrangeTransition="10" Value=@GetDoubleValue(PropertyName.SkyBrightness, 100.0) />
    <Gauge Legend="Sky Quality (mag/arcsec2)" MinValue="10" MaxValue="25" OrangeGreenTransition="21.3" RedOrangeTransition="19" Value=@GetDoubleValue(PropertyName.SkyQuality, 25.0) Reverse=true />
    <Gauge Legend="FWHM (arc-sec)" MinValue="0" MaxValue="5" OrangeGreenTransition="1" RedOrangeTransition="2" Value=@GetDoubleValue(PropertyName.StarFWHM, 5.0) />
    <Gauge Legend="Sky Temperature (C)" MinValue="-70" MaxValue="20" OrangeGreenTransition="-20" RedOrangeTransition="0" Value=@GetDoubleValue(PropertyName.SkyTemperature, 20.0) />
    <Gauge Legend="Dew Point (C)" MinValue="-30" MaxValue="25" OrangeGreenTransition="5" RedOrangeTransition="15" Value=@GetDoubleValue(PropertyName.DewPoint, 25.0) />
    <Gauge Legend="Pressure (hPa)" MinValue="950" MaxValue="1050" OrangeGreenTransition="1060" RedOrangeTransition="1060" Value=@GetDoubleValue(PropertyName.Pressure, 1050.0) />
    <Gauge Legend="Temperature (C)" MinValue="-50.0" MaxValue="50.0" OrangeGreenTransition="10.0" RedOrangeTransition="25.0" Value=@GetDoubleValue(PropertyName.Temperature, 50.0) />
    <Gauge Legend="Humidity (%)" MinValue="0" MaxValue="100" OrangeGreenTransition="100" RedOrangeTransition="100" Value=@GetDoubleValue(PropertyName.Humidity, 100.0) />
    <Gauge Legend="Cloud Cover (%)" MinValue="0" MaxValue="100" OrangeGreenTransition="20" RedOrangeTransition="70" Value=@GetDoubleValue(PropertyName.CloudCover, 100.0) />
</div>

@code {
    private readonly CancellationTokenSource _cts = new();

    private double GetDoubleValue(PropertyName propertyName, double defaultValue)
    {
        try
        {
            switch (propertyName)
            {
                case PropertyName.WindSpeed:
                    return state.ObservingConditions.WindSpeed;
                case PropertyName.WindGust:
                    return state.ObservingConditions.WindGust;
                case PropertyName.WindDirection:
                    return state.ObservingConditions.WindDirection;
                case PropertyName.RainRate:
                    return state.ObservingConditions.RainRate;
                case PropertyName.SkyBrightness:
                    return state.ObservingConditions.SkyBrightness;
                case PropertyName.SkyQuality:
                    return state.ObservingConditions.SkyQuality;
                case PropertyName.StarFWHM:
                    return state.ObservingConditions.StarFWHM;
                case PropertyName.SkyTemperature:
                    return state.ObservingConditions.SkyTemperature;
                case PropertyName.DewPoint:
                    return state.ObservingConditions.DewPoint;
                case PropertyName.Pressure:
                    return state.ObservingConditions.Pressure;
                case PropertyName.Temperature:
                    return state.ObservingConditions.Temperature;
                case PropertyName.Humidity:
                    return state.ObservingConditions.Humidity;
            }
        }
        catch (Exception ex)
        {
            logger.LogVerbose("GetDoubleValue", $"Gauge.DetDoubleValue - Error getting double value for {propertyName}: {ex.Message}");
        }

        return defaultValue;
    }

    protected override async Task OnInitializedAsync()
    {
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }


    }
