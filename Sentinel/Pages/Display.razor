@page "/display"

@inject IJSRuntime JSRuntime

@using ASCOM.Alpaca
@using Sentinel.Components
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;
@using Sentinel.DeviceAccess

@inject Settings settings
@inject State state
@inject SentinelLogger logger

@implements IDisposable

<PageTitle>@Globals.APPLICATION_NAME Display</PageTitle>
<div style="display:flex">
    <div style="flex:1">
        <h1>@Globals.APPLICATION_NAME</h1>
    </div>
    <div style="flex:1; text-align:right;">
        <span>Gauge size</span>
        <div style="display:inline-block; position: relative;" @onmouseup="OnGaugeDimensionMouseUp">
            <div style="@MarkerStyle"></div>
            <RadzenSlider @bind-Value="GaugeDimension"
                          TValue="int"
                          Min="170"
                          Max="500"
                          Step="1"
                          Change="OnGaugeDimensionChanged"
                          Style="width: 150px;margin-left:24px;margin-right:24px;" />
        </div>
        <span>
            <SentinelButton Click="@SetGaugeSize" Text="Set Size" />
        </span>
    </div>
</div>
<div style="display: flex; flex-wrap: wrap;">
    <Gauge Legend="Wind Speed (mi/h)" Value=@GetDoubleValue(PropertyName.WindSpeed, 20.0) Configuration=@(settings.GaugeSettings[PropertyName.WindSpeed]) />
    <Gauge Legend="Wind Gust (mi/h)" Value=@GetDoubleValue(PropertyName.WindGust, 100.0) Configuration=@(settings.GaugeSettings[PropertyName.WindGust]) />
    <Compass Value=@GetDoubleValue(PropertyName.WindDirection, 0.0) />
    <Gauge Legend="Rain Rate (mm/h)" Value=@GetDoubleValue(PropertyName.RainRate, 50.0) Configuration=@(settings.GaugeSettings[PropertyName.RainRate]) />
    <Gauge Legend="Sky Brightness (Lux)" Value=@GetDoubleValue(PropertyName.SkyBrightness, 100.0) Configuration=@(settings.GaugeSettings[PropertyName.SkyBrightness]) />
    <Gauge Legend="Sky Quality (mag/arcsec2)" Value=@GetDoubleValue(PropertyName.SkyQuality, 25.0) Configuration=@(settings.GaugeSettings[PropertyName.SkyQuality]) />
    <Gauge Legend="FWHM (arc-sec)" Value=@GetDoubleValue(PropertyName.StarFWHM, 5.0) Configuration=@(settings.GaugeSettings[PropertyName.StarFWHM]) />
    <Gauge Legend="Sky Temperature (C)" Value=@GetDoubleValue(PropertyName.SkyTemperature, 20.0) Configuration=@(settings.GaugeSettings[PropertyName.SkyTemperature]) />
    <Gauge Legend="Dew Point (C)" Value=@GetDoubleValue(PropertyName.DewPoint, 25.0) Configuration=@(settings.GaugeSettings[PropertyName.DewPoint]) />
    <Gauge Legend="Pressure (hPa)" Value=@GetDoubleValue(PropertyName.Pressure, 1050.0) Configuration=@(settings.GaugeSettings[PropertyName.Pressure]) />
    <Gauge Legend="Temperature (C)" Value=@GetDoubleValue(PropertyName.Temperature, 50.0) Configuration=@(settings.GaugeSettings[PropertyName.Temperature]) />
    <Gauge Legend="Humidity (%)" Value=@GetDoubleValue(PropertyName.Humidity, 100.0) Configuration=@(settings.GaugeSettings[PropertyName.Humidity]) />
    <Gauge Legend="Cloud Cover (%)" Value=@GetDoubleValue(PropertyName.CloudCover, 100.0) Configuration=@(settings.GaugeSettings[PropertyName.CloudCover]) />
</div>
<div>
    <p style="margin-top:24px; font-size:small;">The gauge minimum, maximum and transition points can be configured on the Configuration / Application Settings / Display tab.</p>
</div>
@code {
    // Marker at slider midpoint
    const double MARKER_POSITION_PERCENT = 53.5;
    private const int MARKER_SNAP_DISTANCE = 20;

    private string MarkerStyle = $"position: absolute; top: 50%; left: {MARKER_POSITION_PERCENT}%; width: 4px; height: 30px; background-color: red; border-radius: 2px; pointer-events: none; transform: translate(-50%, -50%);";

    private readonly CancellationTokenSource _cts = new();

    private Dictionary<PropertyName, double> lastValue = new() {
        { PropertyName.WindSpeed, 0.0 },
        { PropertyName.WindGust, 0.0 },
        { PropertyName.WindDirection, 0.0 },
        { PropertyName.RainRate, 0.0 },
        { PropertyName.SkyBrightness, 0.0 },
        { PropertyName.SkyQuality, 0.0 },
        { PropertyName.StarFWHM, 0.0 },
        { PropertyName.SkyTemperature, 0.0 },
        { PropertyName.DewPoint, 0.0 },
        { PropertyName.Pressure, 0.0 },
        { PropertyName.Temperature, 0.0 },
        { PropertyName.Humidity, 0.0 },
        { PropertyName.CloudCover, 0.0 },
    };

    public Dictionary<PropertyName, DateTime> lastValueTime = new()
    {
        { PropertyName.WindSpeed, DateTime.MinValue },
        { PropertyName.WindGust, DateTime.MinValue },
        { PropertyName.WindDirection, DateTime.MinValue },
        { PropertyName.RainRate, DateTime.MinValue },
        { PropertyName.SkyBrightness, DateTime.MinValue },
        { PropertyName.SkyQuality, DateTime.MinValue },
        { PropertyName.StarFWHM, DateTime.MinValue },
        { PropertyName.SkyTemperature, DateTime.MinValue },
        { PropertyName.DewPoint, DateTime.MinValue },
        { PropertyName.Pressure, DateTime.MinValue },
        { PropertyName.Temperature, DateTime.MinValue },
        { PropertyName.Humidity, DateTime.MinValue },
        { PropertyName.CloudCover, DateTime.MinValue },
    };

    private int GaugeDimension { get; set; }

    private async Task OnGaugeDimensionMouseUp(MouseEventArgs args)
    {
        if (Math.Abs(GaugeDimension - Globals.GAUGE_DIMENSION_DEFAULT) <= MARKER_SNAP_DISTANCE)
        {
            GaugeDimension = Globals.GAUGE_DIMENSION_DEFAULT;
            state.GaugeDimension = Globals.GAUGE_DIMENSION_DEFAULT;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task SetGaugeSize()
    {
        settings.GaugeDimension = state.GaugeDimension;
        settings.Save();
    }

    private async Task OnGaugeDimensionChanged(int value)
    {
        state.GaugeDimension = value;
        await InvokeAsync(StateHasChanged);
    }

    private double GetDoubleValue(PropertyName propertyName, double defaultValue)
    {
        if (DateTime.Now.Subtract(lastValueTime[propertyName]) < TimeSpan.FromSeconds(0.1))
            return lastValue[propertyName];

        // Check whether this device is configured and connected
        if (!state.ObservingConditionsDeviceMap.ContainsKey(propertyName)) // Not available
        {
            double maxValue = settings.GaugeSettings[propertyName].Maximum;

            lastValue[propertyName] = maxValue;
            lastValueTime[propertyName] = DateTime.Now;
            return maxValue;

        }

        double newValue = Double.NegativeInfinity;
        try
        {
            switch (propertyName)
            {
                case PropertyName.WindSpeed:
                    newValue = state.ObservingConditions.WindSpeed;
                    break;
                case PropertyName.WindGust:
                    newValue = state.ObservingConditions.WindGust;
                    break;
                case PropertyName.WindDirection:
                    newValue = state.ObservingConditions.WindDirection;
                    break;
                case PropertyName.RainRate:
                    newValue = state.ObservingConditions.RainRate;
                    break;
                case PropertyName.SkyBrightness:
                    newValue = state.ObservingConditions.SkyBrightness;
                    break;
                case PropertyName.SkyQuality:
                    newValue = state.ObservingConditions.SkyQuality;
                    break;
                case PropertyName.StarFWHM:
                    newValue = state.ObservingConditions.StarFWHM;
                    break;
                case PropertyName.SkyTemperature:
                    newValue = state.ObservingConditions.SkyTemperature;
                    break;
                case PropertyName.DewPoint:
                    newValue = state.ObservingConditions.DewPoint;
                    break;
                case PropertyName.Pressure:
                    newValue = state.ObservingConditions.Pressure;
                    break;
                case PropertyName.Temperature:
                    newValue = state.ObservingConditions.Temperature;
                    break;
                case PropertyName.Humidity:
                    newValue = state.ObservingConditions.Humidity;
                    break;
                case PropertyName.CloudCover:
                    newValue = state.ObservingConditions.CloudCover;
                    break;
            }
        }
        catch (Exception ex)
        {
            //logger.LogVerbose("GetDoubleValue", $"Gauge.GetDoubleValue - Error getting double value for {propertyName}: {ex.Message}");
            newValue = settings.GaugeSettings[propertyName].Maximum;
        }

        lastValue[propertyName] = newValue;
        lastValueTime[propertyName] = DateTime.Now;
        return newValue;
    }

    protected override async Task OnInitializedAsync()
    {
        GaugeDimension = state.GaugeDimension;
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
