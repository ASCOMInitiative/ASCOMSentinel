@page "/display"

@inject IJSRuntime JSRuntime

@using ASCOM.Alpaca
@using Sentinel.Components
@using LogLevel = ASCOM.Common.Interfaces.LogLevel;
@using Sentinel.DeviceAccess

@inject State state
@inject SentinelLogger logger

@implements IDisposable

<PageTitle>@Globals.APPLICATION_NAME Log</PageTitle>

<h1>@Globals.APPLICATION_NAME</h1>

<div style="display: flex; flex-wrap: wrap;">
    <Gauge Legend="Wind Speed (mi/h)" Value=@GetDoubleValue(PropertyName.WindSpeed, 20.0) Configuration=@(new GaugeConfiguration(0, 20, 5, 15)) />
    <Gauge Legend="Wind Gust (mi/h)" Value=@GetDoubleValue(PropertyName.WindGust, 100.0) Configuration=@(new GaugeConfiguration(0, 100, 100, 100)) />
    <Compass Value=@GetDoubleValue(PropertyName.WindDirection, 0.0) />
    <Gauge Legend="Rain Rate (mm/h)" Value=@GetDoubleValue(PropertyName.RainRate, 50.0) Configuration=@(new GaugeConfiguration(0, 50, 1, 5)) />
    <Gauge Legend="Sky Brightness (Lux)" Value=@GetDoubleValue(PropertyName.SkyBrightness, 100.0) Configuration=@(new GaugeConfiguration(0, 100, 1, 10))  />
    <Gauge Legend="Sky Quality (mag/arcsec2)" Value=@GetDoubleValue(PropertyName.SkyQuality, 25.0) Configuration=@(new GaugeConfiguration(10, 25, 21.3, 19)) />
    <Gauge Legend="FWHM (arc-sec)" Value=@GetDoubleValue(PropertyName.StarFWHM, 5.0) Configuration=@(new GaugeConfiguration(0, 5, 1, 2)) />
    <Gauge Legend="Sky Temperature (C)" Value=@GetDoubleValue(PropertyName.SkyTemperature, 20.0) Configuration=@(new GaugeConfiguration(-70, 20, -20, 0)) />
    <Gauge Legend="Dew Point (C)" Value=@GetDoubleValue(PropertyName.DewPoint, 25.0) Configuration=@(new GaugeConfiguration(-30, 25, 5, 15)) />
    <Gauge Legend="Pressure (hPa)" Value=@GetDoubleValue(PropertyName.Pressure, 1050.0) Configuration=@(new GaugeConfiguration(950, 1050, 1060, 1060)) />
    <Gauge Legend="Temperature (C)" Value=@GetDoubleValue(PropertyName.Temperature, 50.0) Configuration=@(new GaugeConfiguration(-50, 50, 10, 25)) />
    <Gauge Legend="Humidity (%)" Value=@GetDoubleValue(PropertyName.Humidity, 100.0) Configuration=@(new GaugeConfiguration(0, 100, 100, 100)) />
    <Gauge Legend="Cloud Cover (%)" Value=@GetDoubleValue(PropertyName.CloudCover, 100.0) Configuration=@(new GaugeConfiguration(0, 100, 20, 70)) />
</div>

@code {
    private readonly CancellationTokenSource _cts = new();

    private double GetDoubleValue(PropertyName propertyName, double defaultValue)
    {
        try
        {
            switch (propertyName)
            {
                case PropertyName.WindSpeed:
                    return state.ObservingConditions.WindSpeed;
                case PropertyName.WindGust:
                    return state.ObservingConditions.WindGust;
                case PropertyName.WindDirection:
                    return state.ObservingConditions.WindDirection;
                case PropertyName.RainRate:
                    return state.ObservingConditions.RainRate;
                case PropertyName.SkyBrightness:
                    return state.ObservingConditions.SkyBrightness;
                case PropertyName.SkyQuality:
                    return state.ObservingConditions.SkyQuality;
                case PropertyName.StarFWHM:
                    return state.ObservingConditions.StarFWHM;
                case PropertyName.SkyTemperature:
                    return state.ObservingConditions.SkyTemperature;
                case PropertyName.DewPoint:
                    return state.ObservingConditions.DewPoint;
                case PropertyName.Pressure:
                    return state.ObservingConditions.Pressure;
                case PropertyName.Temperature:
                    return state.ObservingConditions.Temperature;
                case PropertyName.Humidity:
                    return state.ObservingConditions.Humidity;
            }
        }
        catch (Exception ex)
        {
            logger.LogVerbose("GetDoubleValue", $"Gauge.DetDoubleValue - Error getting double value for {propertyName}: {ex.Message}");
        }

        return defaultValue;
    }

    protected override async Task OnInitializedAsync()
    {
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }


}
