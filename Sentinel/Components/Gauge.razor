@namespace Sentinel.Components

<span>
    <RadzenRadialGauge Style="width: 320px; height: 320px;" class="sentinel-gauge">
        <RadzenRadialGaugeScale StartAngle="-150" EndAngle="150" Step="@Step()" Min="@Configuration.Minimum" Max="@AbsoluteMaximumValue" TickPosition=GaugeTickPosition.Inside MinorStep="@MinorStep()" MinorTickLength=9 TickLength=13>
            <RadzenRadialGaugeScalePointer Value=@Value Length="0.7" ShowValue=true Fill="dimgray">
                <Template Context="pointer">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0" class="rz-mt-4">
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0"><strong>@pointer.Value.ToRoundedString()</strong></RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"><strong>@Legend</strong></RadzenText>
                    </RadzenStack>
                </Template>
            </RadzenRadialGaugeScalePointer>
            @* Colour the scale *@
            @if (Configuration.GreenOrangeTransition > Configuration.OrangeRedTransition) // Red at left, green at right
            {
                <RadzenRadialGaugeScaleRange From=@Configuration.Minimum To=@Configuration.OrangeRedTransition Fill="red" />
                <RadzenRadialGaugeScaleRange From=@Configuration.OrangeRedTransition To=@Configuration.GreenOrangeTransition Fill="orange" />
                <RadzenRadialGaugeScaleRange From=Configuration.GreenOrangeTransition To=@AbsoluteMaximumValue Fill="green" />
            }
            else // Green at left, red at right
            {
                <RadzenRadialGaugeScaleRange From="@Configuration.Minimum" To=@Configuration.GreenOrangeTransition Fill="green" />
                <RadzenRadialGaugeScaleRange From=@Configuration.GreenOrangeTransition To=@Configuration.OrangeRedTransition Fill="orange" />
                <RadzenRadialGaugeScaleRange From=@Configuration.OrangeRedTransition To=@AbsoluteMaximumValue Fill="red" />
            }
        </RadzenRadialGaugeScale>
    </RadzenRadialGauge>
</span>
@code
{
    [Parameter]
    public GaugeConfiguration Configuration { get; set; } = new GaugeConfiguration();

    [Parameter]
    public double Value { get; set; } = 0;

    [Parameter]
    public string Legend { get; set; } = Globals.NOT_SET;

    #region Private methods

    private double AbsoluteMaximumValue
    {
        get
        {
            double retval = Math.Max(Configuration.Maximum, Value);

            return retval;
        }
    }

    private double Step()
    {
        double retval = (AbsoluteMaximumValue - Configuration.Minimum) / Configuration.MajorSegments;

        return retval;
    }

    private double MinorStep()
    {
        double retval = Math.Max(0.1, Step() / 5);
        return retval;
    }

    #endregion

}