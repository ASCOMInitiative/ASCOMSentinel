@namespace Sentinel.Components

@inject State state

<span>
    <RadzenRadialGauge Style="@GaugeStyle" class="sentinel-gauge">
        <RadzenRadialGaugeScale StartAngle="-150"
                                EndAngle="150"
                                Step="@Step()"
                                Min="@Configuration.Minimum"
                                Max="@Configuration.Maximum"
                                TickPosition="@TickPosition()"
                                Formatter="@FormatTick"
                                MinorStep="@MinorStep()"
                                MinorTickLength=9
                                TickLength=13>

            <RadzenRadialGaugeScalePointer Value=@Value Length="0.7" ShowValue=true Fill="dimgray">
                <Template Context="pointer">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0" class="rz-mt-4">
                        <RadzenText Style="@ValueStyle()" TextStyle="TextStyle.Body1"><strong>@pointer.Value.ToRoundedString()</strong></RadzenText>
                        <RadzenText Style="@LegendStyle()" TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"><strong>@Legend</strong></RadzenText>
                    </RadzenStack>
                </Template>
            </RadzenRadialGaugeScalePointer>
            @* Colour the scale *@
            @if (Configuration.GreenOrangeTransition > Configuration.OrangeRedTransition) // Red at left, green at right
            {
                <RadzenRadialGaugeScaleRange From=@Configuration.Minimum To=@Configuration.OrangeRedTransition Fill="red" />
                <RadzenRadialGaugeScaleRange From=@Configuration.OrangeRedTransition To=@Configuration.GreenOrangeTransition Fill="orange" />
                <RadzenRadialGaugeScaleRange From=Configuration.GreenOrangeTransition To=@Configuration.Maximum Fill="green" />
            }
            else // Green at left, red at right
            {
                <RadzenRadialGaugeScaleRange From="@Configuration.Minimum" To=@Configuration.GreenOrangeTransition Fill="green" />
                <RadzenRadialGaugeScaleRange From=@Configuration.GreenOrangeTransition To=@Configuration.OrangeRedTransition Fill="orange" />
                <RadzenRadialGaugeScaleRange From=@Configuration.OrangeRedTransition To=@Configuration.Maximum Fill="red" />
            }
        </RadzenRadialGaugeScale>
    </RadzenRadialGauge>
</span>

@code
{
    [Parameter]
    public GaugeConfiguration Configuration { get; set; } = new GaugeConfiguration();

    [Parameter]
    public double Value { get; set; } = 0;

    [Parameter]
    public string Legend { get; set; } = Globals.NOT_SET;

    #region Private methods

    private string ValueStyle()
    {
        if (state.GaugeDimentsion > Globals.GAUGE_SMALL_TRANSTION)
        {
            int position = state.GaugeDimentsion / 2 - 80;
            return $"margin-top:{position}px;display:inline-block;";
        }
        else
        {
            int position = state.GaugeDimentsion / 2 - 80;
            return $"margin-top:{position}px;display:inline-block;";
        }
    }

    private string LegendStyle()
    {
        // if (state.GaugeDimentsion > Globals.GAUGE_SMALL_TRANSTION)
        //     return "";
        // else
        // {
        int position =0;

        return $"margin-top:{position}px;display:inline-block;";
        //        }
    }

    private GaugeTickPosition TickPosition()
    {
        if (state.GaugeDimentsion > 260)

            return GaugeTickPosition.Inside;
        else
            return GaugeTickPosition.Outside;
    }

    private string GaugeStyle => $"width: {state.GaugeDimentsion}px; height: {state.GaugeDimentsion}px;";

    string FormatTick(double value)
    {
        switch (Configuration.Maximum)
        {
            case <= 0.01:
                return value.ToString("0.0000");

            case <= 0.1:
                return value.ToString("0.000");

            case <= 1.0:
                return value.ToString("0.00");
            case <= 10.0:
                return value.ToString("0.0");
            default:
                return value.ToString("0");
        }


        // return Math.Round(value, 3).ToString("0.00");
    }

    private double Step()
    {
        return (Configuration.Maximum - Configuration.Minimum) / Configuration.MajorSegments;
    }

    private double MinorStep()
    {
        return Step() / 5;
    }

    #endregion

}