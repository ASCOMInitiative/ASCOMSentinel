@namespace Sentinel.Components

@implements IDisposable

@inject Settings settings

<div>
    <span style="display:inline-block; width:150px; margin:0px; text-align:left;font-weight:700">@PropertyDescription</span>

    <RadzenDropDown Value=@Equality1
                    Data=@Enum.GetValues(typeof(EqualityType))
                    TValue="EqualityType"
                    Style="margin-top:20px;margin-left:0px; margin-right:0px; width: 140px; text-align:left;"
                    Change="(args)=>Equality1Changed(args)"
                    PopupStyle="max-height:400px; overflow:auto;"
                    Disabled="IsDisabled()"
                    Name="Equality1">
        <Template Context="item">
            <span style="color:@EqualityTypeColor(item); font-size:1rem;">@(((EqualityType)item).ToFormattedEqualityType())</span>
        </Template>
    </RadzenDropDown>

    <RadzenNumeric Value=@Value1
                   TValue=double
                   Step="0.1"
                   Style="margin-top:20px;margin-left:0px; margin-right:0px; width: 140px; text-align:left;"
                   Change="(args) => Value1Changed(args)"
                   ShowUpDown="false"
                   Disabled="IsDisabled()"
                   Format="0.00"
                   Name="Value1" />

    <RadzenLabel Text="@Units" Style="margin-left:20px;margin-right:0px;width:150px;color:gray;" />

    <span style="display:inline-block; width:150px; margin:0px; margin-left:0px; text-align:left;font-weight:700">@PropertyDescription</span>

    <RadzenDropDown Value=@Equality2
                    Data=@Enum.GetValues(typeof(EqualityType))
                    TValue="EqualityType"
                    Style="margin-top:20px;margin-left:0px; margin-right:0px; width: 140px; text-align:left;"
                    Change="(args)=>Equality2Changed(args)"
                    PopupStyle="max-height:400px; overflow:auto;"
                    Disabled="IsDisabled()"
                    Name="Equality2">
        <Template Context="item">
            <span style="color:@EqualityTypeColor(item); font-size:1rem;">@(((EqualityType)item).ToFormattedEqualityType())</span>
        </Template>
    </RadzenDropDown>

    <RadzenNumeric Value=@Value2
                   TValue=double
                   Step="0.1"
                   Style="margin-top:20px;margin-left:0px; margin-right:0px; width: 140px; text-align:left;"
                   Change="(args) => Value2Changed(args)"
                   ShowUpDown="false"
                   Disabled="IsDisabled()"
                   Format="0.00"
                   Name="Value2" />

    <RadzenLabel Text="@Units" Style="margin-left:20px;color:grey;" />

</div>

@code {
    [Parameter]
    public string PropertyDescription { get; set; } = Globals.NOT_SET;

    [Parameter]
    public PropertyName Property { get; set; }

    [Parameter]
    public EqualityType Equality1 { get; set; } = EqualityType.NotInUse;

    [Parameter]
    public double Value1 { get; set; } = double.NaN;

    [Parameter]
    public EqualityType Equality2 { get; set; } = EqualityType.NotInUse;

    [Parameter]
    public double Value2 { get; set; } = double.NaN;

    [Parameter]
    public string Units { get; set; } = Globals.NOT_SET;

    [Parameter]
    public bool Enabled { get; set; } = false;

    private bool _initialized;

    protected override void OnInitialized()
    {
        settings.ConfigurationChanged += OnSettingsChanged;
    }

    private async void OnSettingsChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        settings.ConfigurationChanged -= OnSettingsChanged;
    }

    private static string EqualityTypeColor(object item) =>
        (EqualityType)item == EqualityType.NotInUse ? "dodgerblue" : "red";

    private bool IsDisabled()
    {
        try
        {
            return settings.ConfiguredDevices[Property].SentinelDeviceType == SentinelDeviceType.NotSet;
        }
        catch (Exception)
        {
            return true;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _initialized = true;
    }

    private void Equality1Changed(object args)
    {
        if (!_initialized || args == null)
            return;

        settings.ObservingCondtionsRules[Property].EqualityType1 = (EqualityType)args;
        settings.Save();
    }

    private void Value1Changed(object args)
    {
        if (!_initialized || args == null)
            return;

        settings.ObservingCondtionsRules[Property].Value1 = (double)args;
        settings.Save();
    }

    private void Equality2Changed(object args)
    {
        if (!_initialized || args == null)
            return;

        settings.ObservingCondtionsRules[Property].EqualityType2 = (EqualityType)args;
        settings.Save();
    }

    private void Value2Changed(object args)
    {
        if (!_initialized || args == null)
            return;

        settings.ObservingCondtionsRules[Property].Value2 = (double)args;
        settings.Save();
    }
}
