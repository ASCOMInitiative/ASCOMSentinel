@namespace Sentinel.Components

@inject State state

@implements IDisposable

<span>
    <RadzenRadialGauge Style="@GaugeStyle">
        <RadzenRadialGaugeScale StartAngle="0" EndAngle="360" Min="0" Max="360" Step="45" TickPosition="@TickPosition()" Formatter="@FormatCompassLabel" MinorStep="22.5" MinorTickLength=9 TickLength=13>
            <RadzenRadialGaugeScalePointer Value=@Value Length="0.7" ShowValue=true Fill="dimgray">
                <Template Context="pointer">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0" class="rz-mt-4">
                        <RadzenText Style="@LegendStyle()" TextStyle="TextStyle.Body1"><strong>@pointer.Value.ToRoundedString()</strong></RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"><strong>Wind Direction</strong></RadzenText>
                    </RadzenStack>
                </Template>
            </RadzenRadialGaugeScalePointer>
            <RadzenRadialGaugeScaleRange From=0 To=360 Fill="green" />
        </RadzenRadialGaugeScale>
    </RadzenRadialGauge>
</span>

@code {

    //            <RadzenRadialGaugeScalePointer Value="@CurrentHeading" Fill="red" Length="0.8" />

    [Parameter]
    public double Value { get; set; } = 0;

    private string GaugeStyle => $"width: {state.GaugeDimension}px; height: {state.GaugeDimension}px;";

    protected override void OnInitialized()
    {
        state.StateChanged += OnStateChanged;
    }

    private string LegendStyle()
    {
        if (state.GaugeDimension > Globals.GAUGE_SMALL_TRANSTION)
            return "";
        else
        {
            int position = 24 + Globals.GAUGE_SMALL_OFFSET - (Globals.GAUGE_SMALL_TRANSTION - state.GaugeDimension) / 2;
            return $"margin-top:{position}px;display:inline-block;";
        }
    }
   
    private GaugeTickPosition TickPosition()
    {
        if (state.GaugeDimension > 260)
            return GaugeTickPosition.Inside;
        else
            return GaugeTickPosition.Outside;
    }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        state.StateChanged -= OnStateChanged;
    }


    private string FormatCompassLabel(double value)
    {
        switch (value)
        {
            case 0:
            case 360:
                return "N";
            case 45:
                return "NE";
            case 90:
                return "E";
            case 135:
                return "SE";
            case 180:
                return "S";
            case 225:
                return "SW";
            case 270:
                return "W";
            case 315:
                return "NW";
            default:
                return "";
        }
    }
}
