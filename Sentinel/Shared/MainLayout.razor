@namespace Sentinel

@inherits LayoutComponentBase

@inject IJSRuntime JSRuntime
@inject PerBrowserState circuitState
@inject PasswordManager passwordManager

<PageTitle>@Globals.APPLICATION_NAME</PageTitle>

<div class="page">
    <div class="sidebar" >
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div style="text-align:left;display:inline-block;margin-right:auto;"><h1 style="margin-top:8px;">@Globals.APPLICATION_NAME</h1></div>
            <a href="https://ascom-standards.org" target="_blank">ASCOM Standards</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
<RadzenDialog />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restore authentication state from the browser's sessionStorage.
            // This survives an F5 refresh because sessionStorage persists across
            // page loads within the same tab, even though the Blazor circuit is new.
            try
            {
                string? token = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "sentinel-auth-token");
                if (PasswordManager.ValidateAuthToken(token))
                {
                    circuitState.MustChangePassword = passwordManager.MustChangePassword;
                    circuitState.IsAuthenticated = true;
                }
            }
            catch { }
        }
    }
}
