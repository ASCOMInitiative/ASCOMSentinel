@namespace Sentinel
@using Sentinel.Components

@inject State state
@inject Settings settings
@inject SentinelLogger logger
@inject DialogService DialogService
@inject PerBrowserState circuitState

@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@Globals.APPLICATION_NAME</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (state.OperationUnderway)@* Operation is in progress *@
{
    <span style="color:yellow;display:flex;justify-content:center;font-weight:bold;margin-top:80px;">@state.OperationUnderwayMessage</span>
}
else
@* No operation is in progress *@
{
    <div class="@NavMenuCssClass" style="display:flex; flex-direction:column; height:calc(100vh - 3.5rem);" @onclick="ToggleNavMenu">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            @if (state.RequireAdministratorLoginAtStartup)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/administration" Match="NavLinkMatch.All">
                        <span style="color:white" class="oi oi-lock-locked" aria-hidden="true"></span> <span style="color:white">Administrator Logon</span>
                    </NavLink>
                </div>
            }
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/display"
                         Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Display
                </NavLink>
            </div>
            @if (!state.RequireAdministratorLoginAtStartup || (circuitState.IsAuthenticated && !circuitState.MustChangePassword))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/setup" Match="NavLinkMatch.All">
                        <span style="color:white" class="oi oi-cog" aria-hidden="true"></span> <span style="color:yellow">Configuration</span>
                    </NavLink>
                </div>
            }
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/help" Match="NavLinkMatch.All">
                    <span style="color:white" class="oi oi-question-mark" aria-hidden="true"></span> <span style="color:white">Help</span>
                </NavLink>
            </div>
        </nav>

        @if (!state.RequireAdministratorLoginAtStartup || (circuitState.IsAuthenticated && !circuitState.MustChangePassword))
        {
            <div style="flex:1"></div>
            <div>
                <div style="color:white;display:flex;justify-content:center;font-weight:bold;margin-top:0px;margin-bottom:0px;">Online State</div>

                <div style="margin-top:0px;margin-bottom:0px;display:flex;justify-content:center;">

                    <RadzenButton Click="() => EnableRemoteClients()"
                                  Text="@(state.EnableRemoteClients? "Online" : "Offline")"
                                  Style="width:165px;margin-left:0px; margin-right:0px; border-radius:20px; text-transform:none;" ButtonStyle="@((state.EnableRemoteClients) ? ButtonStyle.Success : ButtonStyle.Danger)"
                                  Disabled="@(state.OperationUnderway)" />
                </div>
                <div style="color:white;font-size:small;justify-content:center;display:flex;margin-top:0px;margin-bottom:48px;">Click to change state</div>

                <div style="color:white;display:flex;justify-content:center;font-weight:bold;margin-top:0px;margin-bottom:0px;">Device State</div>
                <div style="margin-top:3px;margin-bottom:0px;display:flex;justify-content:center;">
                    <RadzenButton Click="() => ConnectDisconnect()"
                                  Text="@(state.Connected ? "Connected" : "Disconnected")"
                                  Style="width:165px;margin-left:0px; margin-right:0px; border-radius:20px; text-transform:none;" ButtonStyle="@((state.Connected) ? ButtonStyle.Success : ButtonStyle.Danger)"
                                  Disabled="@(state.OperationUnderway)" />
                </div>
                <div style="color:white;font-size:small;justify-content:center;display:flex;margin-top:0px;margin-bottom:48px;">Click to change state</div>

                @if (state.DisplayReconnectMessage || state.DisplayRestartMessage)
                {
                    <div style="margin-top:36px;"></div>
                }

                @* Reconnection required message *@
                @if (state.DisplayReconnectMessage && state.Connected)
                {
                    <div>
                        <span style="color:yellow;display:flex;justify-content:center;font-weight:bold;margin-top:24px;margin-bottom:12px;">Reconnect Required</span>
                        <div style="margin-top:9px;margin-bottom:24px;display:flex;justify-content:center;">
                            <SentinelButton Click="@(() => Reconnect())" Text="Reconnect Devices" />
                        </div>
                    </div>
                }
                @* Restart required message *@
                @if (state.DisplayRestartMessage)
                {
                    <div>
                        <span style="color:yellow;display:flex;justify-content:center;font-weight:bold;margin-top:48px;margin-bottom:12px;">Restart Required</span>
                    </div>
                }
            </div>
            <div style="flex:6"></div>

            <div style="color:white;display:flex;justify-content:center;font-weight:bold;margin-top:0px;margin-bottom:0px;">Application</div>
            <div style="margin-top:3px;margin-bottom:12px;display:flex;justify-content:center;" @onclick:stopPropagation>
                <RadzenButton Click="RestartApplicationAsync"
                              Text="Restart"
                              Style="width:165px;margin-left:0px; margin-right:0px; border-radius:20px; text-transform:none;" ButtonStyle="ButtonStyle.Warning"
                              Disabled="@(state.OperationUnderway)" />
            </div>
            <div style="margin-top:0px;margin-bottom:12px;display:flex;justify-content:center;" @onclick:stopPropagation>
                <RadzenButton Click="ShutdownApplicationAsync"
                              Text="Shutdown"
                              Style="width:165px;margin-left:0px; margin-right:0px; border-radius:20px; text-transform:none;" ButtonStyle="ButtonStyle.Danger"
                              Disabled="@(state.OperationUnderway)" />
            </div>
        }
        @* end of IsAuthenticated block *@
    </div>
}

@code {

    private async Task EnableRemoteClients()
    {
        bool? confirmed;
        // Check whether we need to get confirmation for this action
        if (settings.ConfirmOnline) // Confirmation required
        {
            confirmed = await DialogService.Confirm(
            state.EnableRemoteClients ? "Prevent client access?" : "Enable client access",
                "Client access",
                new ConfirmOptions { OkButtonText = state.EnableRemoteClients ? "Prevent" : "Enable", CancelButtonText = "Cancel" });
        }
        else // No confirmation is required so just do it
            confirmed = true;

        if (confirmed == true)
            state.EnableRemoteClients = !state.EnableRemoteClients;
        logger.LogMessage("Online state changed", $"{Globals.APPLICATION_NAME} is now {(state.EnableRemoteClients ? "Online" : "Offline")}");
        logger.LogMessage("", "");
    }

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        state.StateChanged += OnStateChanged;
        settings.ConfigurationChanged += OnStateChanged;
        circuitState.AuthStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"NavMenu.OnStateChanged exception: {ex.Message}");
        }
    }

    public void Dispose()
    {
        state.StateChanged -= OnStateChanged;
        settings.ConfigurationChanged -= OnStateChanged;
        circuitState.AuthStateChanged -= OnAuthStateChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Reconnect()
    {
        bool? confirmed;
        // Check whether we need to get confirmation for this action
        if (settings.ConfirmReConnect) // Confirmation required
        {
            confirmed = await DialogService.Confirm(
               "Reconnect devices?",
               "Disconnect and reconnect devices",
               new ConfirmOptions { OkButtonText = "Reconnect", CancelButtonText = "Cancel" });
        }
        else // No confirmation is required so just do it
            confirmed = true;

        if (confirmed == true)
        {
            // Clear the reconnect message.
            state.DisplayReconnectMessage = false;
            state.StatusText = "";

            // Check whether we are already connected.
            if (state.Connected) // Already connected so disconnect first and the connect again.
            {
                // Disconnect first.
                await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));

                // Reconnect after disconnecting.
                await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
            }
            else // Currently disconnected so connect
            {
                await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
            }
        }
    }

    private async Task ConnectDisconnect()
    {
        bool? confirmed;
        // Check whether we need to get confirmation for this action
        if (settings.ConfirmConnectToDevices) // Confirmation required
        {
            confirmed = await DialogService.Confirm(
              state.Connected ? "Disconnect from  devices" : "Connect to devices?",
                "Device connection",
                new ConfirmOptions { OkButtonText = state.Connected ? "Disconnect" : "Connect", CancelButtonText = "Cancel" });
        }
        else // No confirmation is required so just do it
            confirmed = true;

        if (confirmed == true)
        {
            state.DisplayReconnectMessage = false;
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
        }
    }

    private async Task RestartApplicationAsync()
    {
        bool? confirmed;
        // Check whether we need to get confirmation for this action
        confirmed = await DialogService.Confirm(
        "Restart the application?",
            "Confirm Restart",
            new ConfirmOptions { OkButtonText = "Restart", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            // Signal that a restart is needed, then stop the application. Program.Main will start the new instance after the port is released.
            await Task.Run(async () =>
            {
                // Disable the UI immediately to prevent multiple clicks while shutdown is in progress.
                state.OperationUnderwayMessage = "Restarting application...";
                logger.LogBlankLine();
                logger.LogWarning("Restarting", "Application restart initiated by an administrator.");
                logger.LogBlankLine();
                state.OperationUnderway = true;

                // If we're connected to devices, disconnect first to ensure a clean shutdown.
                if (state.Connected)
                {
                    ConnectionManager.Disconnect(state, logger);
                }

                Task.Delay(Globals.LOG_REFRESH_INTERVAL + 50).Wait(); // Wait a moment to allow the log message to be written before shutting down.

                Program.RestartRequested = true;
                Program.applicationLifetime?.StopApplication();
            });
        }
    }

    private async Task ShutdownApplicationAsync()
    {
        bool? confirmed = await DialogService.Confirm(
        "Shutdown the application?",
            "Confirm Shutdown",
            new ConfirmOptions { OkButtonText = "Shutdown", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            // Signal that a shutdown is needed and stop the application.
            await Task.Run(async () =>
            {
                // Disable the UI immediately to prevent multiple clicks while shutdown is in progress.
                state.OperationUnderwayMessage = "Shutting down...";
                logger.LogBlankLine();
                logger.LogWarning("Shutdown", "Application shutdown initiated by an administrator.");
                logger.LogBlankLine();
                state.OperationUnderway = true;

                // If we're connected to devices, disconnect first to ensure a clean shutdown.
                if (state.Connected)
                {
                    ConnectionManager.Disconnect(state, logger);
                }

                Task.Delay(Globals.LOG_REFRESH_INTERVAL + 50).Wait(); // Wait a moment to allow the log message to be written before shutting down.

                Program.RestartRequested = false;
                Program.applicationLifetime?.StopApplication();
            });
        }
    }
}
