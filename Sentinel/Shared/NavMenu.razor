@namespace Sentinel
@using Sentinel.Components

@inject State state
@inject Settings settings
@inject SentinelLogger logger

@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@Globals.APPLICATION_NAME</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (state.OperationUnderway )@* Operation is in progress *@
{
    <span style="color:yellow;display:flex;justify-content:center;font-weight:bold;margin-top:80px;">Operation Underway</span>
}
else 
@* No operation is in progress *@
{
    <div class="@NavMenuCssClass" style="display:flex; flex-direction:column; height:calc(100vh - 3.5rem);" @onclick="ToggleNavMenu">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            @* <div class="nav-item px-3">
                <NavLink class="nav-link" href="/display" 
                    Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Display
                </NavLink>
            </div> *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/setup" Match="NavLinkMatch.All">
                    <span style="color:white" class="oi oi-cog" aria-hidden="true"></span> <span style="color:yellow">Application Setup</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
            </div>
        </nav>

        <div style="color:white;display:flex;justify-content:center;font-weight:bold;margin-top:24px;margin-bottom:0px;">Online State</div>
        <div style="margin-top:0px;margin-bottom:48px;display:flex;justify-content:center;">

            <RadzenButton Click="() => EnableRemoteClients()"
                Text="@(state.EnableRemoteClients? "Online" : "Offline")"
                Style="width:165px;margin-left:0px; margin-right:0px; border-radius:20px; text-transform:none;" ButtonStyle="@((state.EnableRemoteClients) ? ButtonStyle.Success : ButtonStyle.Danger)" />
        </div>
        
        <div style="color:white;display:flex;justify-content:center;font-weight:bold;margin-top:0px;margin-bottom:0px;">Device Connection State</div>
         <div style="margin-top:3px;margin-bottom:0px;display:flex;justify-content:center;">
            <RadzenButton Click="() => ConnectDisconnect()"
                Text="@(state.Connected ? "Connected" : "Disconnected")"
                Style="width:165px;margin-left:0px; margin-right:0px; border-radius:20px; text-transform:none;" ButtonStyle="@((state.Connected) ? ButtonStyle.Success : ButtonStyle.Danger)" />
        </div>
               
        @* Reconnection required message *@
            @if(state.DisplayReconnectMessage&& state.Connected)
            {
                <div>
                    <span style="color:yellow;display:flex;justify-content:center;font-weight:bold;margin-top:60px;margin-bottom:12px;">Reconnect Required</Span>
                    <div style="margin-top:9px;margin-bottom:24px;display:flex;justify-content:center;">
                        <SentinelButton Click="@(() => Reconnect())" Text="Reconnect Devices" />
                    </div>
                </div>
            }

        <div style="color:white;display:flex;justify-content:center;font-weight:bold;margin-top:auto;margin-bottom:0px;">Application</div>
        <div style="margin-top:3px;margin-bottom:12px;display:flex;justify-content:center;">
            <RadzenButton Click="() => RestartApplication()"
                Text="Restart"
                Style="width:165px;margin-left:0px; margin-right:0px; border-radius:20px; text-transform:none;" ButtonStyle="ButtonStyle.Warning" />
        </div>
    </div>
}

@code {

    private async Task EnableRemoteClients()
    {
            state.EnableRemoteClients = !state.EnableRemoteClients;
 
    }

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        state.StateChanged += OnStateChanged;
    }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        state.StateChanged -= OnStateChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Reconnect()
    {
        // Clear the reconnect message.
        state.DisplayReconnectMessage= false;
        
        // Check whether we are already connected.
        if (state.Connected) // Already connected so disconnect first and the connect again.
        {
            // Disconnect first.
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));

            // Reconnect after disconnecting.
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
        }
        else // Currently disconnected so connect
        {
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
        }
    }
    private async Task ConnectDisconnect()
    {
        state.DisplayReconnectMessage = false;
        await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
    }

    private void RestartApplication()
    {
        // Signal that a restart is needed, then stop the application.
        // Program.Main will start the new instance after the port is released.
        Program.RestartRequested = true;
        Program.Lifetime?.StopApplication();
    }
}
