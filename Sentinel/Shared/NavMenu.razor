@namespace Sentinel
@using Sentinel.Components

@inject State state
@inject Settings settings
@inject SentinelLogger logger

@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@Globals.APPLICATION_NAME</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (state.OperationUnderway )@* Operation is in progress *@
{
    <span style="color:yellow;display:flex;justify-content:center;font-weight:bold;margin-top:80px;">Operation Underway</span>
}
else 
@* No operation is in progress *@
{
    <div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            @* <div class="nav-item px-3">
                <NavLink class="nav-link" href="/display" 
                    Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Display
                </NavLink>
            </div> *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/setup" Match="NavLinkMatch.All">
                    <span class="oi oi-cog" aria-hidden="true"></span> Application Setup
                </NavLink>
            </div>
            <div class="nav-item px-3">
            </div>
        </nav>
        <div>
            @if(state.DisplayReconnectMessage&& state.Connected)
            {
                <span style="color:yellow;display:flex;justify-content:center;font-weight:bold;margin-top:6px;margin-bottom:0px;">Reconnect Required</Span>
            }
            else
            {
                <span style="color:yellow;display:flex;justify-content:center;font-weight:bold;margin-top:6px;margin-bottom:0px;">&nbsp;</Span>
            }
        </div>
        <div style="margin-top:28px;margin-bottom:30px;display:flex;justify-content:center;">
            <RadzenButton Click="() => Reconnect()"
                Text="@(state.Connected ? "Reconnect Devices" : "Connect Devices")"
                Style="width:165px;margin-left:0px; margin-right:0px; border-radius:20px; text-transform:none;" ButtonStyle="ButtonStyle.Info" />

        </div>
        <div style="margin-top:0px;margin-bottom:30px;display:flex;justify-content:center;">
            <SentinelButton Click="@(() => Disconnect())"
                            Text="Disconnect Devices" />
        </div>
    </div>
}

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        state.StateChanged += OnStateChanged;
    }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        state.StateChanged -= OnStateChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Reconnect()
    {
        // Clear the reconnect message.
        state.DisplayReconnectMessage= false;
        
        // Check whether we are already connected.
        if (state.Connected) // Already connected so disconnect first and the connect again.
        {
            // Disconnect first.
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));

            // Reconnect after disconnecting.
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
        }
        else // Currently disconnected so connect
        {
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
        }
    }
    private async Task Disconnect()
    {
        state.DisplayReconnectMessage = false;
        if (state.Connected)
        {
            await ConnectionManager.ChangeConnectedStateAsync(state, settings, logger, () => InvokeAsync(StateHasChanged));
        }
    }
}
